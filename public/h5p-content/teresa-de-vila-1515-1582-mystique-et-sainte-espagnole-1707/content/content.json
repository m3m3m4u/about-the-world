              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Teresa de Ávila (1515-1582) - Mystique et Sainte espagnole</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
