      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Warhols berühmte Werke</strong><br>\nZu Warhols bekanntesten Werken zählen die Porträts von Marilyn Monroe, die Campbell's Suppendosen und die Brillo-Boxen. Diese Objekte wurden durch seine Arbeit aus ihrem alltäglichen Kontext gehoben und zu Ikonen der Kunstwelt. Seine Werke waren oft mehrfach vorhanden, was auf die Massenproduktion anspielte und gleichzeitig die einzigartigen Eigenschaften jedes Stücks hervorhob.</p>\n\n<p><strong>Andy Warhol's Factory</strong><br>\nWarhol gründete seine Werkstatt, die \"Factory\", einen berühmten Treffpunkt für Künstler, Intellektuelle und Prominente. In der Factory entstanden viele seiner Werke, und Warhol war bekannt für seine offene und experimentelle Arbeitsweise. Die Factory wurde auch zu einem Zentrum für die entstehende New Yorker Underground-Kulturszene.</p>\n\n<p><strong>Film und andere Medien</strong><br>\nNeben der Malerei experimentierte Warhol auch mit Film, Musik und anderen Medien. Er produzierte eine Reihe von experimentellen Filmen, die für ihre ungewöhnliche Länge und ihren inhaltlichen Minimalismus bekannt sind. Auch gründete er das Magazin \"Interview\", das ein Sprachrohr für die Popkultur wurde.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
