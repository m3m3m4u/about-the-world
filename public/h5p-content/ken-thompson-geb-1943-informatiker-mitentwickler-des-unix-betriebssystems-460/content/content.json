      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Innovationen durch UNIX</strong><br>\nUNIX war besonders wegen seiner Portabilität und seiner Verwendung von C eine Innovation. Es war eines der ersten Betriebssysteme, das in der Hochsprache C geschrieben wurde, was die Übertragung auf unterschiedliche Computerhardware erleichterte. Thompson spielte eine Schlüsselrolle bei der Entwicklung von C und der Anpassung von UNIX, um es vielseitig einsetzbar zu machen.</p>\n\n<p><strong>Programmiersprache B und Weiterentwicklungen</strong><br>\nVor seiner Arbeit an C entwickelte Thompson die Programmiersprache B, die ein Vorläufer von C war und auf dem Betriebssystem UNIX lief. Obwohl B nicht so bekannt ist, war sie wichtig für die Entwicklung von C und beeinflusste damit indirekt fast alle modernen Softwareentwicklungen.</p>\n\n<p><strong>Texteditor und Computerchess</strong><br>\nNeben seiner Arbeit an Betriebssystemen entwickelte Thompson auch den Texteditor ed und war maßgeblich an der Entwicklung von Computerchess-Programmen beteiligt. Seine Arbeit in diesem Bereich zeigte sein breites Interesse und seine Fähigkeit, komplexe Probleme mit kreativen Lösungen zu begegnen.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
