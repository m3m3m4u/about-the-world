              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Ken Thompson (geb. 1943) - Informatiker, Mitentwickler des UNIX-Betriebssystems</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
