              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Siddhartha Gautama (Buddha) (ca. 563-483 v. Chr.) - Begründer des Buddhismus</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
