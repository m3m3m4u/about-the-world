              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Camillo Golgi (1843-1926) - Médecin et lauréat du prix Nobel</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
