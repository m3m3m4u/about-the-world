            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Edgar Allan Poe's Early Life</strong><br>\nEdgar Allan Poe was born in Boston in 1809. After his parents' death, he was taken in by the Allan family in Richmond, Virginia. His relationship with his foster parents was strained, and he faced financial and personal difficulties early on.</p>\n\n<p><strong>Literary Beginnings</strong><br>\nPoe's literary career began with the publication of his first book of poetry, \"Tamerlane and Other Poems,\" in 1827. He initially struggled to earn a living from his writing but gradually gained a reputation as a talented writer.</p>\n\n<p><strong>Poe's Themes and Genre</strong><br>\nPoe is best known for his tales of mystery and the macabre. He is considered a pioneer of the horror genre and wrote some of the earliest detective stories, profoundly impacting the development of these literary genres.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
