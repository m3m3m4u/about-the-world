                "title": "Unbenannt: Text",
                "defaultLanguage": "it"
              },
              "subContentId": "5627dc6e-c943-439e-ab4a-4531b7f24264"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>L'origine del conflitto del Medio Oriente</strong><br>\nIl conflitto del Medio Oriente ha una lunga storia che risale a molti decenni fa. È nato principalmente a causa di differenze territoriali e disaccordi politici tra diversi stati e gruppi nella regione. In particolare, la disputa per la terra tra israeliani e palestinesi è al centro del conflitto. La fondazione dello Stato di Israele nel 1948 è stata un fattore chiave nelle continue tensioni.</p>\n\n<p><strong>Notizie internazionali come fonte di informazione</strong><br>\nLe notizie internazionali svolgono un ruolo cruciale nell'informare le persone in tutto il mondo sugli sviluppi nel conflitto del Medio Oriente. Riportano su decisioni politiche, azioni militari e crisi umanitarie nella regione. Attraverso la copertura mediatica, le persone al di fuori del conflitto possono capire cosa sta accadendo sul campo e formare una propria opinione.</p>\n\n<p><strong>Influenza della copertura mediatica sull'opinione pubblica</strong><br>\nIl modo in cui le notizie internazionali riportano sul conflitto del Medio Oriente può influenzare notevolmente l'opinione pubblica. Può suscitare empatia per le vittime o rinforzare posizioni politiche. Allo stesso tempo, la rappresentazione degli eventi nei media può portare a malintesi e pregiudizi.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "it"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
