              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Martin Luther (1483-1546) - Deutscher Mönch und Kirchenreformer</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
