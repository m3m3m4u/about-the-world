              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Simone Veil (1927-2017) - politica francese e sopravvissuta all'Olocausto</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
