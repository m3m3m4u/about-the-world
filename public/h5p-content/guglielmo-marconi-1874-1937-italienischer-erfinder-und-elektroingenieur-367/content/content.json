      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Gründung der Marconi Company</strong><br>\nUm seine Erfindungen zu vermarkten und weiterzuentwickeln, gründete Marconi 1897 die Marconi Wireless Telegraph Company. Das Unternehmen expandierte schnell und errichtete drahtlose Stationen in vielen Ländern. Die Firma spielte eine wichtige Rolle bei der Entwicklung der kommerziellen drahtlosen Telegrafie und ermöglichte erstmals transatlantische Nachrichtenübertragungen.</p>\n\n<p><strong>Marconis transatlantische Übertragung</strong><br>\nIm Jahr 1901 gelang Marconi ein bedeutender Durchbruch, als es ihm als erstem gelang, drahtlose Signale über den Atlantik zu senden, von Cornwall in England nach Neufundland in Kanada. Diese Leistung widerlegte die damalige Annahme, dass die Erdkrümmung die Übertragungsreichweite drahtloser Wellen begrenzen würde. Diese historische Übertragung zeigte die Machbarkeit der weltweiten drahtlosen Kommunikation.</p>\n\n<p><strong>Nobel Preis für Physik</strong><br>\nFür seine Beiträge zur drahtlosen Telegraphie erhielt Marconi 1909 gemeinsam mit Karl Ferdinand Braun den Nobelpreis für Physik. Die Anerkennung durch den Nobelpreis bestätigte die Bedeutung seiner Arbeit und förderte das internationale Ansehen der drahtlosen Kommunikation als wissenschaftliche Leistung und praktische Anwendung.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
