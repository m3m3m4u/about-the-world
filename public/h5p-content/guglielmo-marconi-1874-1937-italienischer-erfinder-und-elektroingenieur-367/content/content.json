              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Guglielmo Marconi (1874-1937) - Italienischer Erfinder und Elektroingenieur</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
