          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nAlfred Tennyson was born on August 6, 1809, in Lincolnshire, England. He was the fourth of twelve children in a clergyman's family and showed an early talent for poetry.</p>\n\n<p><strong>Rise to Poet Laureate</strong><br>\nTennyson succeeded William Wordsworth as Poet Laureate of Great Britain and Ireland in 1850 and held the position until his death, becoming one of the most popular poets of the Victorian era.</p>\n\n<p><strong>\"In Memoriam A.H.H.\"</strong><br>\nHis best-known work, \"In Memoriam A.H.H.,\" was written to commemorate his friend Arthur Henry Hallam. This work grapples with questions of faith and immortality during a time of great personal grief.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
