              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Konrad Adenauer (1876-1967) - Deutscher Bundeskanzler</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
