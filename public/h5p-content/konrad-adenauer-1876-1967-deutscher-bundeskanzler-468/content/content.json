      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Bundeskanzler der Bundesrepublik Deutschland</strong><br>\nIm Jahr 1949 wurde Adenauer der erste Bundeskanzler der neu gegründeten Bundesrepublik Deutschland. Er blieb bis 1963 im Amt und prägte in diesen 14 Jahren die deutsche Politik entscheidend. Unter seiner Führung entwickelte sich die Bundesrepublik wirtschaftlich und sozial zu einem stabilen und prosperierenden Staat.</p>\n\n<p><strong>Die \"Politik der Stärke\"</strong><br>\nAdenauer verfolgte eine \"Politik der Stärke\" gegenüber der DDR und der Sowjetunion. Er setzte auf eine enge Bindung an den Westen, insbesondere an die USA, und war ein entschiedener Gegner einer vorzeitigen Wiedervereinigung Deutschlands auf Kosten der Freiheit und Demokratie. Für ihn hatte die Sicherung der Freiheit im Westen Vorrang vor der Einheit.</p>\n\n<p><strong>Europäische Integration</strong><br>\nEin wichtiges Anliegen Adenauers war die europäische Integration. Er war einer der Gründungsväter der Europäischen Wirtschaftsgemeinschaft (EWG) und sah in der Zusammenarbeit der europäischen Staaten die Chance für dauerhaften Frieden und Wohlstand. Die EWG war der Vorläufer der heutigen Europäischen Union.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
