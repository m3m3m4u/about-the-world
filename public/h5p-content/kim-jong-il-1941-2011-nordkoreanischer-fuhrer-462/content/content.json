              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Kim Jong-il (1941-2011) - Nordkoreanischer Führer</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
