            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Cuban Missile Crisis</strong><br>\nDuring his rule, Khrushchev faced the Cuban Missile Crisis in 1962, a peak moment in the Cold War that brought the United States and the Soviet Union close to nuclear conflict.</p>\n\n<p><strong>Relationship with the West</strong><br>\nKhrushchev is noted for his volatile relationship with Western powers, characterized by his famous \"We will bury you!\" speech, signaling the competitiveness of the Soviet Union with the capitalist West.</p>\n\n<p><strong>Cultural Thaw</strong><br>\nHis era saw a cultural \"thaw,\" with a slight loosening of government censorship and greater freedom of expression for artists and writers compared to the Stalin era.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
