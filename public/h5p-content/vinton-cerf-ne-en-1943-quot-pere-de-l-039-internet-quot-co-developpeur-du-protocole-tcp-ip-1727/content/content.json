              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Vinton Cerf (né en 1943) - \"Père de l'Internet\", co-développeur du protocole TCP-IP</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
