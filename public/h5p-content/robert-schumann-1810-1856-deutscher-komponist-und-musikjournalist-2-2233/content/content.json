          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Robert Schumann</strong><br>\nRobert Schumann fue un influyente compositor y crítico musical alemán del periodo romántico, ampliamente reconocido por su música para piano, lieder (canciones), sinfonías y música de cámara.</p>\n\n<p><strong>Primeros Años y Desarrollo</strong><br>\nComenzó su carrera como pianista, pero un daño permanente en la mano le llevó a enfocarse en la composición y la crítica musical. Fundó la \"Neue Zeitschrift für Musik\" para promover sus ideales románticos en la música.</p>\n\n<p><strong>Innovaciones en la Música para Piano</strong><br>\nSchumann es famoso por sus obras para piano solo, que a menudo incorporaban elementos novedosos y técnicas de narración, como en \"Carnaval\" y \"Kreisleriana\".</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "es"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
