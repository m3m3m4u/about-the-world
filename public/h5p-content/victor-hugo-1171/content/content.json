          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Victor Hugo's Early Life</strong><br>\nVictor Hugo was born in 1802 in Besançon, France. He grew up during a period of political upheaval, which later influenced his work. A precocious child with a passion for writing, he published his first novel at age 20.</p>\n\n<p><strong>Rise to Fame</strong><br>\nHugo quickly became a celebrated poet among the French Romantics. He was prolific in his production, publishing poems as well as plays that opened the doors to fame, and he became a leading figure in the French Romantic Movement.</p>\n\n<p><strong>\"Hunchback of Notre Dame\"</strong><br>\nIn 1831, Hugo published \"The Hunchback of Notre Dame,\" which achieved widespread popularity. This novel played a significant role in shaping the Romantic movement in France and also sparked a newfound appreciation for the Gothic architecture of Paris.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
