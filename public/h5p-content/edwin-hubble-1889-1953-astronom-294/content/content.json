              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Edwin Hubble (1889-1953) - Astronom</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
