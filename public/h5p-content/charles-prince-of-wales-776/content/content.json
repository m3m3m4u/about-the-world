          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Charles, Prince of Wales</strong><br>\nCharles, Prince of Wales, born in 1948, is the eldest son of Queen Elizabeth II and Prince Philip, Duke of Edinburgh. As the heir apparent to the British throne, he has been next in line since he was three years old, which is longer than any other heir in British history. Charles is known for his charitable work and environmental advocacy. He established The Prince's Trust in 1976, which supports young people to reach their potential.</p>\n\n<p><strong>Early Life and Education</strong><br>\nPrince Charles was born at Buckingham Palace and had a privileged upbringing. He was the first heir apparent to earn a university degree when he graduated from the University of Cambridge. His education also included time at the Royal Air Force and Royal Naval College, reflecting the traditional military training of the British royalty.</p>\n\n<p><strong>Title and Duties</strong><br>\nCharles holds the title Prince of Wales, traditionally granted to the heir apparent. Alongside official duties and representing the Queen, he supports many charitable organizations. He undertakes numerous royal duties and has represented the Queen at various state events, highlighting the role of the monarchy in modern Britain.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
