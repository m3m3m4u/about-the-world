          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Themes of Poetry</strong><br>\nDickinson's poems explore themes such as nature, love, death, and immortality. Her concise and vivid imagery often delve into the essence of these universal experiences with striking honesty and insight.</p>\n\n<p><strong>Personal Life</strong><br>\nDickinson seldom left her home and eventually lived in almost total physical isolation from the outside world, which has intrigued readers and scholars alike.</p>\n\n<p><strong>Publication History</strong><br>\nOnly a few of Dickinson's nearly 1,800 poems were published during her lifetime, and those were significantly altered by the publishers to fit conventional poetic rules of the time.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
