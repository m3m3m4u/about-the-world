            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nEmily Dickinson was born on December 10, 1830, in Amherst, Massachusetts. She lived much of her life in reclusive isolation, which is reflected in the unique breadth and depth of her poetry.</p>\n\n<p><strong>Education and Upbringing</strong><br>\nAttending Amherst Academy and later Mount Holyoke Female Seminary, Dickinson received a thorough education, especially in literature, which heavily influenced her writing.</p>\n\n<p><strong>Writing Style</strong><br>\nKnown for her unusual use of form and syntax, Dickinson frequently employed short lines, slant rhyme, and unconventional punctuation. Her poetry was largely unpublished during her lifetime.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
        "slideBackgroundSelector": {}
