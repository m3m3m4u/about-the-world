              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Angela Merkel (geb. 1954) - Deutsche Bundeskanzlerin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
