              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Tim Berners-Lee (nato nel 1955) - inventore del World Wide Web</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
