      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Esterházy-Familie</strong><br>\n1761 trat Haydn in den Dienst der wohlhabenden Esterházy-Familie ein, die bekannt für ihre Leidenschaft für die Künste war. Als Hofkapellmeister hatte Haydn die Möglichkeit, zu experimentieren und sein musikalisches Repertoire zu erweitern. Er komponierte dort viele seiner bekanntesten Werke und genoss ein hohes Maß an kreativer Freiheit.</p>\n\n<p><strong>Entwicklung des Symphoniestils</strong><br>\nWährend seiner fast 30-jährigen Tätigkeit für die Familie Esterházy prägte Haydn maßgeblich die Entwicklung der klassischen Symphonie. Er verfeinerte die Struktur und formale Gestaltung der Symphonie und erforschte neue Möglichkeiten der thematischen Entwicklung und Modulation.</p>\n\n<p><strong>Streichquartette und Kammermusik</strong><br>\nNeben Symphonien schrieb Haydn über 80 Streichquartette, die die Entwicklung der Kammermusik maßgeblich beeinflussten. Seine Quartette zeichnen sich durch ihren Witz, ihre strukturelle Innovation und ihre musikalische Tiefe aus. Sie werden häufig als Höhepunkt des klassischen Streichquartetts angesehen.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
