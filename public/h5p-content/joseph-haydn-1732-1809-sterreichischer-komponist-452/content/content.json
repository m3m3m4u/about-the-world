              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Joseph Haydn (1732-1809) - Österreichischer Komponist</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
