            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of James Watson</strong><br>\nJames Watson was born in Chicago on April 6, 1928. From a young age, he was fascinated by bird watching, which sparked his interest in genetics. He attended the University of Chicago under a scholarship for gifted students, where he studied zoology. Watson was drawn to genetics during his time at the university and quickly realized that it was his calling.</p>\n\n<p><strong>Education and Influences</strong><br>\nAfter earning his undergraduate degree, Watson went to Indiana University to study genetics. There, he was influenced by the works of Salvador Luria and Herman Muller, two prominent geneticists. He received his Ph.D. at the age of 22, focusing his research on the effect of X-rays on bacterial viruses, which was a hot topic at the time.</p>\n\n<p><strong>The Discovery of DNA's Structure</strong><br>\nWatson traveled to Europe in 1951 to further his research. At the Cavendish Laboratory in Cambridge, he met Francis Crick. Despite their age difference, they shared an immediate intellectual connection. In 1953, they proposed the double helix structure for DNA, a groundbreaking model that would become a cornerstone of modern biology.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
