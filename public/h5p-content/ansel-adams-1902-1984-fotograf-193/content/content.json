      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Liebe zur Natur</strong><br>\nAdams' Fotografien sind besonders bekannt für ihre Darstellung der amerikanischen Wildnis. Mit seiner Arbeit wollte er die Schönheit und Reinheit der Natur zeigen und Bewusstsein für ihre Erhaltung schaffen. Seine Bilder wurden zu Symbolen der Umweltbewegung, die in den Vereinigten Staaten an Bedeutung gewann.</p>\n\n<p><strong>Publikationen</strong><br>\nDurch seine zahlreichen Bücher wie \"Sierra Nevada: The John Muir Trail\" und \"Yosemite and the Range of Light\" erreichte Adams ein breites Publikum. Diese Publikationen enthalten einige seiner bekanntesten Werke und trugen dazu bei, seine Philosophie der Naturschönheit und Notwendigkeit ihres Schutzes zu verbreiten.</p>\n\n<p><strong>Einfluss und Vermächtnis</strong><br>\nAdams' Einfluss erstreckt sich weit über die Fotografie hinaus. Er wurde zu einem wichtigen Stimme im Umweltschutz und hatte bedeutenden Einfluss auf die Ausweitung des US-Nationalparksystems. Sein Engagement und seine Leidenschaft für den Schutz natürlicher Räume sind bis heute inspirierend.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
