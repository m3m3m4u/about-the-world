              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Golda Meir (1898-1978) - Israelische Premierministerin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
