              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Margaret Mead (1901-1978) - Anthropologin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
