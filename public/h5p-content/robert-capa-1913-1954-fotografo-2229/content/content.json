                "defaultLanguage": "es"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Segunda Guerra Mundial</strong><br>\nDurante la Segunda Guerra Mundial, Capa trabajó para la revista 'Life' y estuvo presente en varios eventos significativos, como el Día D en Normandía. Sus fotografías desde la primera línea del frente proporcionaron una visión cercana y personal del impacto de la guerra en los soldados y civiles.</p>\n\n<p><strong>Fundación de Magnum Photos</strong><br>\nEn 1947, junto con Henri Cartier-Bresson y otros tres fotógrafos, fundó Magnum Photos. Esta cooperativa permitió a los fotógrafos tener control sobre su trabajo. Magnum se convirtió en una voz importante para los fotógrafos independientes y un medio para publicar trabajos que tenían una perspectiva personal y única.</p>\n\n<p><strong>Después de la guerra</strong><br>\nDespués de la Segunda Guerra Mundial, Capa siguió fotografiando conflictos, incluyendo la Guerra Árabe-Israelí en 1948 y la Primera Guerra de Indochina. En estos conflictos, continuó mostrando el lado humano y a menudo trágico de la guerra.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "es"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
