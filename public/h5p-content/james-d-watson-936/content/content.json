          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Advocacy for Science and Education</strong><br>\nWatson has been a vocal advocate for science education and research funding. He has emphasized the importance of understanding genetics and its potential to improve human health through medical advances.</p>\n\n<p><strong>Awards and Honors</strong><br>\nBesides the Nobel Prize, Watson has received numerous awards and honors, including the Presidential Medal of Freedom and the National Medal of Science. These recognize his contributions to science and society.</p>\n\n<p><strong>Later Life and Continuing Influence</strong><br>\nAs of my last update, Watson is an emeritus professor at Cold Spring Harbor Laboratory. His legacy in genetics and molecular biology continues to influence current research and the understanding of heredity and disease.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
