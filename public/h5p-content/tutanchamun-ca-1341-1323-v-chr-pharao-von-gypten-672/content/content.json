              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Tutanchamun (ca. 1341-1323 v. Chr.) - Pharao von Ägypten</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
