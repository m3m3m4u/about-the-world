                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "es"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Leyes de la Electroquímica</strong><br>\nFormuló las leyes de la electroquímica, estableciendo las bases para la relación entre sustancias químicas y electricidad. Esto tuvo aplicaciones prácticas significativas, como en la batería y la galvanoplastia.</p>\n\n<p><strong>Principios de Faraday</strong><br>\nFaraday introdujo conceptos como líneas de fuerza magnética, que ayudaron a explicar cómo se comportan los campos eléctricos y magnéticos y cómo se propagan a través del espacio y los materiales.</p>\n\n<p><strong>Carrera en la Royal Institution</strong><br>\nDurante su carrera en la Royal Institution, Faraday se dedicó a la educación pública en ciencia y realizó experimentos que llevaron a importantes avances en la comprensión de la electricidad.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "es"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
