              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Gregor Mendel (1822-1884) - Mönch und Genetiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
