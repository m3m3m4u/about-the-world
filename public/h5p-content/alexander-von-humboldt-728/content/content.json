          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Alexander von Humboldt's Early Life</strong><br>\nAlexander von Humboldt was born in 1769 in Berlin. Raised in a well-off family, he was educated at home by prominent tutors, fostering an early interest in exploration and the natural sciences that shaped his future pursuits.</p>\n\n<p><strong>University Education and Early Career</strong><br>\nHumboldt studied at the universities of Frankfurt and Göttingen, focusing on botany, geology, and astronomy. He then worked as a government mining official, which allowed him to conduct geological surveys and experiments.</p>\n\n<p><strong>Latin American Expedition</strong><br>\nIn 1799, Humboldt embarked on a five-year expedition to Latin America with the botanist Aimé Bonpland. They explored the Amazon River, climbed the Andes, and collected vast amounts of data on the region's geography, biology, and mineralogy.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
