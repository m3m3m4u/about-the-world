              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Kofi Annan (1938-2018) - UN-Generalsekretär</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
