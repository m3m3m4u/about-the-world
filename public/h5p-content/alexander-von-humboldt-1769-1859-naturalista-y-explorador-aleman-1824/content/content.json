              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Alexander von Humboldt (1769-1859) - Naturalista y explorador alemán</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Información y ejercicios</span></strong></p>\n"
              },
