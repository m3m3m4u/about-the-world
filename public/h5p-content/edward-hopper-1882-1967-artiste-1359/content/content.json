                "text": "<p><span style=\"font-size:3em;\"><strong>Edward Hopper (1882-1967) - Artiste</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
