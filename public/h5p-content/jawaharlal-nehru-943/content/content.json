          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life and Education</strong><br>\nJawaharlal Nehru was born into a wealthy family and was educated in England, first at Harrow and later at Cambridge University, before qualifying as a barrister in London.</p>\n\n<p><strong>Role in India’s Freedom Struggle</strong><br>\nNehru was a central figure in Indian politics before and after independence, serving as the President of the Indian National Congress multiple times and working closely with Mahatma Gandhi.</p>\n\n<p><strong>First Prime Minister of Independent India</strong><br>\nHe became the first Prime Minister of India in 1947 and served until his death in 1964, shaping the newly independent country's government and policies.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
        "slideBackgroundSelector": {}
