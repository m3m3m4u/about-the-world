          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Vision for a Modern India</strong><br>\nNehru was a champion of modernity and scientific advancement, establishing numerous institutions of higher learning, including the All India Institute of Medical Sciences and the Indian Institutes of Technology.</p>\n\n<p><strong>Democratic and Secular Ideals</strong><br>\nHe worked to establish a secular nation-state with a multifaceted cultural tapestry, drafting many policies to safeguard the rights of minorities and promoting a pluralistic society.</p>\n\n<p><strong>Foreign Policy and Non-Alignment</strong><br>\nNehru's foreign policy was marked by the principle of non-alignment, positioning India as a leader of the non-aligned movement during the Cold War.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
