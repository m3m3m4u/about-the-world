              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Konrad Lorenz (1903-1989) - zoologo, fondatore dell'etologia moderna</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
