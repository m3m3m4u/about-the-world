              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Immanuel Kant (1724-1804) - Deutscher Philosoph</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
