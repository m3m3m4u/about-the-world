              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Enrico Fermi (1901-1954) - Italienisch-amerikanischer Physiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
