              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Niels Bohr (1885-1962) - fisico e principale fondatore della meccanica quantistica</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
