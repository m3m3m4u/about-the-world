          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Second Presidential Term</strong><br>\nDuring his second term, starting in 2004, Putin continued to consolidate authority, with a focus on state control of media and the oil and gas industries, asserting Russia's presence on the world stage.</p>\n\n<p><strong>Prime Minister Again</strong><br>\nPutin served as Prime Minister from 2008 to 2012 under President Dmitry Medvedev, retaining significant influence, especially in security and foreign policy domains.</p>\n\n<p><strong>Return to the Presidency</strong><br>\nIn 2012, Putin was re-elected as President amid protests over alleged electoral fraud. His return marked a continuing era of authoritarianism, marked by a strong stance against Western criticism.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
