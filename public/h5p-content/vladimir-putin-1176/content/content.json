            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life and KGB Career</strong><br>\nVladimir Putin was born in Leningrad, now Saint Petersburg, in 1952. He graduated from Leningrad State University with a law degree and joined the KGB, where he served for 16 years, including in East Germany.</p>\n\n<p><strong>Political Rise</strong><br>\nAfter the Soviet Union's collapse, Putin entered politics in Saint Petersburg and quickly rose through the ranks, becoming the director of the Federal Security Service (FSB), the KGB's successor.</p>\n\n<p><strong>First Presidential Term</strong><br>\nPutin was appointed Prime Minister in 1999 by President Boris Yeltsin, who resigned later that year, making Putin the acting President. He was elected to his first term in 2000, focusing on economic recovery and centralizing power.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
