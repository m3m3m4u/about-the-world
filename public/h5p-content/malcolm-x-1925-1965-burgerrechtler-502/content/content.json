              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Malcolm X (1925-1965) - Bürgerrechtler</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
