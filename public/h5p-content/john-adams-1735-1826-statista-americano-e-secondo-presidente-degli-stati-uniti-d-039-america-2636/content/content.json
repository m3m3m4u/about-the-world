              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>John Adams (1735-1826) - statista americano e secondo presidente degli Stati Uniti d'America</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
