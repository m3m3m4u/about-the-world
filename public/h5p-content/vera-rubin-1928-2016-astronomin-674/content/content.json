              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Vera Rubin (1928-2016) - Astronomin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
