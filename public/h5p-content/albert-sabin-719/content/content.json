          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Field Trials and Vaccine Adoption</strong><br>\nSabin's vaccine underwent extensive field trials in the Soviet Union and other parts of the world. By the early 1960s, it was adopted in the United States and subsequently replaced Salk's vaccine in many places due to its ease of administration and effectiveness.</p>\n\n<p><strong>Contributions to Virology and Epidemiology</strong><br>\nBeyond the polio vaccine, Sabin made significant contributions to understanding and controlling other infectious diseases, improving the health of countless individuals around the globe.</p>\n\n<p><strong>Public Health and Policy Influence</strong><br>\nSabin was an influential figure in global public health, advocating for vaccine research and policies to eradicate diseases. His work with the World Health Organization helped shape vaccination strategies worldwide.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
