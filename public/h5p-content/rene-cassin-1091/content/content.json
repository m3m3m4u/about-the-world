            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Nobel Peace Prize</strong><br>\nIn 1968, Cassin was awarded the Nobel Peace Prize for his work in the drafting of the Universal Declaration of Human Rights and his lifelong dedication to human rights issues.</p>\n\n<p><strong>Leadership in Legal Institutions</strong><br>\nCassin held leadership roles in various international legal institutions, including the European Court of Human Rights, where he worked to protect the legal rights of individuals.</p>\n\n<p><strong>Advocacy for the Rule of Law</strong><br>\nThroughout his career, Cassin advocated for the rule of law, democracy, and the protection of human rights, influencing the development of international laws and conventions.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
