          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life and Legal Pursuits</strong><br>\nRené Cassin was born on October 5, 1887, in Bayonne, France. He pursued law and excelled academically, establishing a solid foundation that would later influence his work in human rights law.</p>\n\n<p><strong>World War I Service and Aftermath</strong><br>\nCassin served in World War I, where he was seriously wounded. His war experiences influenced his determination to work for international peace and justice.</p>\n\n<p><strong>Development of International Human Rights</strong><br>\nCassin played a pivotal role in drafting the Universal Declaration of Human Rights in 1948 as a member of the United Nations Commission on Human Rights, with Eleanor Roosevelt as chair.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
