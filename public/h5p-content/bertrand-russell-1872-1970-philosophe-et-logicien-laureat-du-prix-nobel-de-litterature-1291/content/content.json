              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Bertrand Russell (1872-1970) - Philosophe et logicien, lauréat du prix Nobel de littérature</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
