              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Albert Schweitzer (1875-1965) - Arzt, Theologe, Musiker und Philosoph</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
