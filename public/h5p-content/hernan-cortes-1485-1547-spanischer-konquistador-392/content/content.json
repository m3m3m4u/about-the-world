              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Hernán Cortés (1485-1547) - Spanischer Konquistador</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
