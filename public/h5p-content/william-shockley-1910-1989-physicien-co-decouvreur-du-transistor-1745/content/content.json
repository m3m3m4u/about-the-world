              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>William Shockley (1910-1989) - Physicien, co-découvreur du transistor</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
