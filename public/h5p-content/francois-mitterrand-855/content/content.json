            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Economic Policy Shift</strong><br>\nMitterrand's early socialist policies led to economic challenges. By 1983, he shifted towards a more moderate economic approach, which included austerity measures to reduce inflation and government spending.</p>\n\n<p><strong>European Integration</strong><br>\nMitterrand was a staunch proponent of European integration. His presidency saw the implementation of the Single European Act and the Treaty on European Union, which led to the creation of the Euro.</p>\n\n<p><strong>End of Cold War Era</strong><br>\nDuring his tenure, Mitterrand witnessed the end of the Cold War and the reunification of Germany, events that dramatically reshaped European politics and security.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
