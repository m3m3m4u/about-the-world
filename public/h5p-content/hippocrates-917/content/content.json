          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of Hippocrates</strong><br>\nHippocrates was born around 460 BC on the Greek island of Kos. From an early age, he was exposed to the teachings and practices of medicine, following a family tradition in the field. His education was extensive, studying not just medicine but also philosophy and other subjects that influenced his approach to healing.</p>\n\n<p><strong>Contributions to Medicine</strong><br>\nHippocrates is often called the \"Father of Medicine.\" He revolutionized the practice of medicine by separating it from superstition and philosophy, insisting that disease was not a punishment inflicted by the gods but rather the product of environmental factors, diet, and living habits.</p>\n\n<p><strong>The Hippocratic Oath</strong><br>\nThe Hippocratic Oath, attributed to Hippocrates, set out a code of ethical conduct for doctors. Although it has been updated over time to suit the changes in medicine and society, the original oath's essence remains a foundational stone in medical ethics, highlighting duties and moral conduct of physicians.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
