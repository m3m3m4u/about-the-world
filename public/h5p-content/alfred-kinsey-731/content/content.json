            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life and Academic Career</strong><br>\nAlfred Kinsey was born on June 23, 1894, in Hoboken, New Jersey. Initially trained as an entomologist at Harvard, he joined the faculty at Indiana University in 1920. His early work focused on the gall wasp, leading to his becoming a widely recognized expert in the field.</p>\n\n<p><strong>Shift to Human Sexuality Research</strong><br>\nIn the 1930s, Kinsey's focus shifted from gall wasps to human sexuality. His interest in the topic began while teaching a course on marriage and family at Indiana University, where he realized the lack of scientific knowledge about human sexual behavior.</p>\n\n<p><strong>Publication of the Kinsey Reports</strong><br>\nKinsey's research culminated in the publication of \"Sexual Behavior in the Human Male\" in 1948 and \"Sexual Behavior in the Human Female\" in 1953. These works, known as the Kinsey Reports, were based on thousands of personal interviews and were considered groundbreaking at the time.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
