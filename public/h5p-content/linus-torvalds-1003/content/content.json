          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Linus Torvalds</strong><br>\nLinus Torvalds is a software engineer who is best known for initiating the development of the Linux kernel. Born in Finland in 1969, Torvalds became interested in computers at a young age. He attended the University of Helsinki, where he studied computer science. During his time at university, he was exposed to Unix, an operating system that influenced his future work.</p>\n\n<p><strong>Creation of Linux</strong><br>\nIn 1991, Torvalds started working on his own operating system kernel, which eventually became known as Linux. He posted about it on a Usenet newsgroup, inviting others to contribute. The kernel he created was notable for being free software; anyone could use, study, modify, and distribute it.</p>\n\n<p><strong>Open Source Movement</strong><br>\nThe development of Linux played a pivotal role in the open-source software movement. Torvalds' choice to make the Linux kernel open source allowed developers around the world to contribute to its development. This collaborative effort resulted in a robust and versatile operating system.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
