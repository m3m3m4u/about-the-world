          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Civil War and Victory</strong><br>\nAfter the end of the Sino-Japanese War, Mao led the communists to victory in the Chinese Civil War, culminating in the founding of the People's Republic of China in 1949.</p>\n\n<p><strong>Great Leap Forward</strong><br>\nMao launched the Great Leap Forward in 1958, intending to rapidly transform China into a socialist society. The policy led to widespread famine and millions of deaths.</p>\n\n<p><strong>Cultural Revolution</strong><br>\nIn 1966, Mao initiated the Cultural Revolution, aiming to reinforce communist ideology and purge the country of its old culture, customs, and capitalist habits, which caused social, economic, and cultural turmoil.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
