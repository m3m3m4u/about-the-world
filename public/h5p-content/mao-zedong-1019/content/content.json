            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Years</strong><br>\nMao Zedong was born on December 26, 1893, in Shaoshan, Hunan Province, China. He began his political life as a student and later as a primary school principal.</p>\n\n<p><strong>Founding the Communist Party</strong><br>\nIn 1921, Mao played a significant role in the founding of the Communist Party of China (CPC), believing that communism could solve the problems of poverty and national disintegration.</p>\n\n<p><strong>Long March</strong><br>\nThe Long March, from 1934 to 1935, was a pivotal event in Chinese communist history. Mao's leadership during this treacherous 6,000-mile retreat solidified his status within the CPC.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
