              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Nefertiti (ca. 1370-1330 v. Chr.) - Königin von Ägypten</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
