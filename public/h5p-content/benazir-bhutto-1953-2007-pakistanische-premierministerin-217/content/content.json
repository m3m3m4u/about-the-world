              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Benazir Bhutto (1953-2007) - Pakistanische Premierministerin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
