              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Jean-Paul Sartre (1905-1980) - Philosoph</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
