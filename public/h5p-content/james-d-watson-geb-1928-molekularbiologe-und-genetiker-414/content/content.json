              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>James D. Watson (geb. 1928) - Molekularbiologe und Genetiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
