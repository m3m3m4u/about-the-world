              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Nikola Tesla (1856-1943) - inventore e ingegnere elettrico</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
