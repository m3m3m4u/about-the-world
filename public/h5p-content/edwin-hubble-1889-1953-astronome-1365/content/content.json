              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Edwin Hubble (1889-1953) - astronome</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
