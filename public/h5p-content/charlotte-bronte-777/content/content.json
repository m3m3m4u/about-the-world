          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>\"Jane Eyre\"</strong><br>\nIn 1847, Brontë published \"Jane Eyre\" under the pen name Currer Bell. The novel, telling a story of a governess's experiences, including her romantic relationship with her employer, was noted for its intense emotional energy and individualism.</p>\n\n<p><strong>Literary Family</strong><br>\nCharlotte was part of a literary family; her sisters Emily and Anne also wrote classic novels. The three sisters initially published their works under male pseudonyms due to prevailing prejudices against female authors.</p>\n\n<p><strong>Personal Tragedies</strong><br>\nTragedy was a frequent visitor in Brontë's life, with all her siblings dying young. These personal losses influenced the emotional depth of her literary work.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
