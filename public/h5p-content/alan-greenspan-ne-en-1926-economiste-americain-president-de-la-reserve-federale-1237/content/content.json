              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Alan Greenspan (né en 1926) - économiste américain, président de la Réserve fédérale.</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
