      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 3)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "4381b60d-c67f-4722-b83d-b17f2fc9d01c"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Umgestaltung des Irans</strong><br>\nUnter Khomeini durchlief der Iran eine radikale Umgestaltung. Westliche Gesetze und Kultur wurden verworfen, und islamische Gesetze wurden strikt durchgesetzt. Die Umwandlung führte zu tiefgreifenden Änderungen in der iranischen Gesellschaft, die bis heute nachwirken.</p>\n\n<p><strong>Außenpolitische Konflikte</strong><br>\nKhomeini stand für eine Außenpolitik, die sich stark gegen die USA und ihre Verbündeten richtete. Der Iran wurde in internationale Konflikte verwickelt, einschließlich der Geiselnahme von US-Botschaftsangehörigen in Teheran und des langwierigen Iran-Irak-Kriegs.</p>\n\n<p><strong>Khomeinis Vermächtnis</strong><br>\nKhomeini starb 1989, aber sein Einfluss auf den Iran und die islamische Welt ist unbestritten. Er bleibt eine spaltende Figur – verehrt von Anhängern als Held und kritisiert von Gegnern wegen seiner repressiven Regierungsform und Menschenrechtsverletzungen. Sein Vermächtnis beeinflusst die iranische Politik bis heute.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3d655444-fd55-42f7-aba2-16a16db7dc58"
