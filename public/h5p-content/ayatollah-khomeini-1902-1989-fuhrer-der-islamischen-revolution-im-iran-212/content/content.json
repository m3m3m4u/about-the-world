      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 1)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "5627dc6e-c943-439e-ab4a-4531b7f24264"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Frühes Leben Khomeinis</strong><br>\nRuhollah Khomeini wurde 1902 im Iran geboren. Er war der Sohn eines Gelehrten, der früh starb, und wuchs in einer Zeit des politischen Wandels auf. Khomeini studierte die islamische Theologie in verschiedenen traditionellen Schulen und wurde ein angesehener Geistlicher. Seine Ansichten über Politik und Religion wurden von den iranischen Regierungsweisen der 1920er bis 1940er Jahre stark beeinflusst.</p>\n\n<p><strong>Aufstieg als Geistlicher</strong><br>\nIn den 1950er und 1960er Jahren stieg Khomeini zum hohen Rang eines Ayatollahs auf. Er kritisierte die westliche Einflussnahme im Iran und die Politik des Schahs Mohammad Reza Pahlavi, insbesondere dessen Säkularisierungsprogramme. Seine Predigten zogen viele Anhänger an, die gegen die herrschende Ordnung waren.</p>\n\n<p><strong>Politische Aktivitäten</strong><br>\nKhomeinis Aktivitäten wurden vom Schah als Bedrohung angesehen. Nach der Veröffentlichung eines kritischen Artikels über den Schah im Jahr 1963 wurde Khomeini verhaftet, was zu landesweiten Unruhen führte. Nach seiner Freilassung setzte er seine Kritik fort und wurde schließlich ins Exil gezwungen.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
