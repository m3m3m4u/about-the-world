      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Bedeutung der Radiokarbonmethode</strong><br>\nDie Radiokarbonmethode revolutionierte zahlreiche Wissenschaftsfelder, da sie eine zuverlässige Technik zur Datierung alter Objekte bot. Vor Libbys Entdeckung war die Altersbestimmung solcher Funde hauptsächlich spekulativ. Die neue Methode lieferte einen objektiven Maßstab für die Geschichte der Erde und ihrer Lebewesen.</p>\n\n<p><strong>Nobelpreis für Chemie</strong><br>\nFür seine bahnbrechende Arbeit in der Entwicklung der Radiokarbonmethode erhielt Libby 1960 den Nobelpreis für Chemie. Die Auszeichnung anerkannte den immensen Wert seiner Forschung und den Beitrag, den sie für verschiedene Wissenschaftsbereiche, wie Archäologie, Geologie und Umweltwissenschaft, leistete.</p>\n\n<p><strong>Einfluss auf die Archäologie</strong><br>\nArchäologen waren nun in der Lage, die Altersdatierung historischer Stätten und Artefakte mit einer neuen Genauigkeit durchzuführen. Dies führte zu einem besseren Verständnis der chronologischen Abfolge historischer Ereignisse und zur Entschlüsselung menschlicher Kulturen, die lange vor der Entstehung schriftlicher Aufzeichnungen existierten.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
