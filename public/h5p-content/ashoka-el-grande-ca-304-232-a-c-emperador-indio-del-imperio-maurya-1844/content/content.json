                "text": "<p><span style=\"font-size:3em;\"><strong>Ashoka el Grande (ca. 304-232 a.C.), emperador indio del Imperio Maurya</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Información y ejercicios</span></strong></p>\n"
