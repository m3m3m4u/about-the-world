              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Crick und Watson (gemeinsam für ihre DNA-Arbeit bekannt)</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
