              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Alexander Graham Bell (1847-1922) - Erfinder des Telefons</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
