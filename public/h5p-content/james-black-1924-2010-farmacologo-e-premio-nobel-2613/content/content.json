              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>James Black (1924-2010) - farmacologo e premio Nobel</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
