          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Women's Suffrage Movement</strong><br>\nThe Underground Railroad</p>\n\n<p><strong>Later Life and the Home for the Aged</strong><br>\nIn her later years, Tubman established the Harriet Tubman Home for the Aged, where she cared for African Americans in need. She managed the home until her health declined, leading her to become a resident there.</p>\n\n<p><strong>Recognition and Legacy</strong><br>\nDespite living in poverty for most of her life, Tubman became an iconic figure for her bravery and humanitarian efforts. Posthumously, she has been honored on stamps and is slated to appear on the U.S. $20 bill.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
