          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nErnesto \"Che\" Guevara was born in 1928 in Rosario, Argentina, into a family with leftist leanings, which influenced his personal ideology from a young age.</p>\n\n<p><strong>Medical Studies</strong><br>\nGuevara traveled throughout South America on his motorcycle, which deepened his conviction about the necessity of a continental socialist revolution, and he received his medical degree in 1953.</p>\n\n<p><strong>Meeting Castro Brothers</strong><br>\nGuevara met Fidel and Raul Castro in Mexico, joining their 26th of July Movement, and played a key role in the Cuban Revolution with his theories and practice of guerrilla warfare.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
