          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Role in Cuban Government</strong><br>\nAfter the triumph of the Cuban Revolution, Che Guevara took on several key roles in the new government including writing, diplomacy, and economic reform.</p>\n\n<p><strong>International Focus</strong><br>\nBelieving in the need for worldwide socialist revolution, Che Guevara left Cuba to incite revolutions first in the Congo and then in Bolivia.</p>\n\n<p><strong>Capture and Death</strong><br>\nChe Guevara was captured by Bolivian forces with CIA assistance in 1967, and after a brief imprisonment, he was executed.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
