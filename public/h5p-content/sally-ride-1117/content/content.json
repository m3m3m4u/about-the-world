            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Honors and Recognition</strong><br>\nRide received numerous honors, including induction into the National Women's Hall of Fame and two Space Flight Medals, recognizing her groundbreaking career as an astronaut.</p>\n\n<p><strong>Personal Life and Passing</strong><br>\nSally Ride valued her privacy, keeping her battle with pancreatic cancer and personal life out of the public eye until her death on July 23, 2012.</p>\n\n<p><strong>Legacy</strong><br>\nSally Ride's legacy lives on in her science outreach work, remembered as a trailblazer for women in space and a role model for students and aspiring astronauts worldwide.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
