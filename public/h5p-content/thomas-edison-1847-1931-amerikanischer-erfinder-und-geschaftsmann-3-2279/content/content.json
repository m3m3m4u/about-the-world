            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>La Bombilla Incandescente</strong><br>\nAunque no inventó la primera bombilla, Edison creó la primera bombilla incandescente comercialmente viable, facilitando el despliegue de la electricidad para uso doméstico e industrial.</p>\n\n<p><strong>Otros Desarrollos Significativos</strong><br>\nEdison también mejoró y comercializó otros productos y tecnologías importantes, como la cámara de cine y el proyector, así como sistemas de generación y distribución de energía eléctrica.</p>\n\n<p><strong>Empresario e Industria</strong><br>\nComo empresario, Edison fundó varias compañías para comercializar sus invenciones, algunas de las cuales se convirtieron en gigantes corporativos como General Electric.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "es"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
