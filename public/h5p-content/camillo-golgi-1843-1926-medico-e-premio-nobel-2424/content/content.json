              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Camillo Golgi (1843-1926) - medico e premio Nobel</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
