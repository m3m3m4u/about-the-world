          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Economic Policies and Reforms</strong><br>\nAs president, Macron implemented a series of economic reforms to modernize the French economy. These included changes to labor laws and tax reforms aimed at boosting investment and employment.</p>\n\n<p><strong>Social Issues and Controversies</strong><br>\nMacron has also tackled various social issues, but his tenure has seen controversies and nationwide protests, such as the \"Yellow Vests\" movement sparked by rising fuel taxes and economic inequality.</p>\n\n<p><strong>International Relations and Diplomacy</strong><br>\nOn the international stage, Macron has been active in European Union politics, advocating for European integration, and has taken a strong stance on climate change and international trade issues.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
