              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Ivan Pavlov (1849-1936) - physiologiste</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
