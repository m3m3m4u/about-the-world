              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Clara Schumann (1819-1896) - Deutsche Pianistin und Komponistin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
