      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Präsidentschaftswahl 1988</strong><br>\nIm Jahr 1988 gewann Bush die Präsidentschaftswahlen und wurde der 41. Präsident der Vereinigten Staaten. Sein Wahlkampf betonte die Fortsetzung der politischen Richtung Reagans und seine eigenen Visionen von einer „freundlicheren und sanfteren Nation“. Er schlug den demokratischen Kandidaten Michael Dukakis nach einer Kampagne, die sich auf Themen wie Führung und Erfahrung konzentrierte.</p>\n\n<p><strong>Innenpolitische Maßnahmen</strong><br>\nAls Präsident stand Bush vor mehreren innenpolitischen Herausforderungen, darunter eine sich abschwächende Wirtschaft und Haushaltsdefizite. Er unterzeichnete wichtige Gesetzgebungen wie den Americans with Disabilities Act (ADA) und den Clean Air Act Amendments, die die Luftqualität verbesserten und Menschen mit Behinderungen schützten. Seine Ernennungen zum Obersten Gerichtshof waren ebenfalls bedeutende Entscheidungen seiner Präsidentschaft.</p>\n\n<p><strong>Außenpolitik und der Fall der Berliner Mauer</strong><br>\nIm Bereich der Außenpolitik erlebte Bush bedeutende Ereignisse, wie den Fall der Berliner Mauer und das Ende des Kalten Krieges. Er unterstützte die deutsche Wiedervereinigung und führte diplomatische Verhandlungen, um die Sicherheit und Stabilität in Europa nach dem Zusammenbruch der Sowjetunion zu gewährleisten.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
