              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>George H.W. Bush (1924-2018) - US-Präsident</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
