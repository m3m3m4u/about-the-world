              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Alexander Fleming (1881-1955) - bactériologiste écossais</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
