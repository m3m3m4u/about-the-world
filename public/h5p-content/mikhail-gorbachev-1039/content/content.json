          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nMikhail Gorbachev was born in 1931 in the village of Privolnoye, Soviet Union. Raised in a mixed Russian-Ukrainian family, he experienced the harsh realities of Soviet rural life and the impact of World War II during his youth.</p>\n\n<p><strong>Rise Through the Party Ranks</strong><br>\nGorbachev studied law at Moscow State University, where he joined the Communist Party. By the 1970s, he had climbed the party hierarchy, promoting agricultural reform and gaining a reputation for innovation.</p>\n\n<p><strong>General Secretary</strong><br>\nGorbachev became the General Secretary of the Communist Party in 1985. He was the youngest leader since Stalin and brought a new wave of optimism with his youth and energy.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
        "slideBackgroundSelector": {}
      },
      {
        "elements": [
          {
            "x": 2.23463687150838,
