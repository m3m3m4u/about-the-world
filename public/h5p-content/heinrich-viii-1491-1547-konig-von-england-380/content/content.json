              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Heinrich VIII. (1491-1547) - König von England</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
