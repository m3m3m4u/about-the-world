              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Richard Nixon (1913-1994) - US-Präsident</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
