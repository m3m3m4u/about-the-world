              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Arrian (ca. 86-160 n. Chr.) - Griechischer Historiker und Staatsmann</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
