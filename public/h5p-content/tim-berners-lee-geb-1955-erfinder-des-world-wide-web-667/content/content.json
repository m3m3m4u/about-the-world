              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Tim Berners-Lee (geb. 1955) - Erfinder des World Wide Web</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
