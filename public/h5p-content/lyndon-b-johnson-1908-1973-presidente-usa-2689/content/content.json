              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Lyndon B. Johnson (1908-1973) - Presidente USA</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
