              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Epiktet (ca. 50-135 n. Chr.) - Griechischer Stoiker und Philosoph</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
