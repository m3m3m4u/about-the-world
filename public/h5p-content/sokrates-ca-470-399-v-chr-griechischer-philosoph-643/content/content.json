              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Sokrates (ca. 470-399 v. Chr.) - Griechischer Philosoph</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
