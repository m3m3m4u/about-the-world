              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>William Shockley (1910-1989) - Physiker, Mitentdecker des Transistors</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
