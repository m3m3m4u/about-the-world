            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of Albert Einstein</strong><br>\nAlbert Einstein was born on March 14, 1879, in Ulm, Germany. As a child, he showed great interest in science and mathematics. Despite his talents, Einstein did not excel in all school subjects, struggling especially with languages and music. His family moved to Italy when he was a teenager, and he later renounced his German citizenship for Swiss.</p>\n\n<p><strong>Education and Academia</strong><br>\nEinstein pursued his education at the Polytechnic School in Zurich, Switzerland. He graduated in 1900 with a degree in physics and mathematics. After struggling to find an academic position, he worked as a patent clerk in Bern. It was during this time that he developed many of his key scientific theories.</p>\n\n<p><strong>The Miracle Year</strong><br>\nThe year 1905 was pivotal for Einstein, often referred to as his \"Annus Mirabilis,\" or Miracle Year. He published four groundbreaking papers, introducing the world to the special theory of relativity, the photoelectric effect, and Brownian motion. These papers revolutionized the understanding of space, time, and energy.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
