          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Advocacy for Peace</strong><br>\nThe Dalai Lama has become a global symbol of peace and non-violence. He was awarded the Nobel Peace Prize in 1989 for his non-violent struggle for the liberation of Tibet. He continues to advocate for the rights and autonomy of the Tibetan people through peaceful means.</p>\n\n<p><strong>The Middle Way Approach</strong><br>\nHe proposes the \"Middle Way Approach\" as a compromise solution for Tibet, seeking autonomy within China rather than full independence. This stance aims to preserve Tibetan culture and identity within the larger Chinese state while avoiding conflict.</p>\n\n<p><strong>Religious Teachings and Global Influence</strong><br>\nAs a spiritual teacher, the Dalai Lama travels extensively, sharing Buddhist teachings and promoting values such as compassion, forgiveness, and self-discipline. He has authored many books and engaged in dialogues with leaders of other faiths, enhancing mutual understanding.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
