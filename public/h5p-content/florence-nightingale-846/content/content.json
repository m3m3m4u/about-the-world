          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nFlorence Nightingale was born on May 12, 1820, into a wealthy British family. At a young age, she felt called to help the sick and poor, but her aspirations conflicted with her family's expectations.</p>\n\n<p><strong>Education and Training</strong><br>\nDetermined to pursue her calling, Nightingale educated herself in the science of nursing. She trained in Germany and later took a nursing job at a London hospital, improving its operations and cleanliness.</p>\n\n<p><strong>Work in the Crimean War</strong><br>\nIn 1854, during the Crimean War, Nightingale led a team of nurses to Turkey. There, she dramatically improved the hospital's sanitation, which greatly reduced the death rate.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
