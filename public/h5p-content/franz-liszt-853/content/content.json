          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nFranz Liszt was born on October 22, 1811, in Raiding, Hungary. Recognized as a prodigy at an early age, he began studying piano with his father and later moved to Vienna and Paris for further education.</p>\n\n<p><strong>The Virtuoso</strong><br>\nLiszt became famous throughout Europe during the 19th century for his virtuosic skill as a pianist. He was known for his charismatic stage presence and innovative techniques, which amazed his audiences.</p>\n\n<p><strong>The Composer</strong><br>\nBesides performance, Liszt composed extensively for the piano. His works, characterized by their technical difficulty and pioneering structures, pushed the boundaries of piano music.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
