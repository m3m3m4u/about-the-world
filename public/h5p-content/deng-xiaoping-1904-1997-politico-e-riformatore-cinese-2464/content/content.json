              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Deng Xiaoping (1904-1997) - politico e riformatore cinese</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
