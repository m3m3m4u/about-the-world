              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Eratosthenes (ca. 276-194 v. Chr.) - Griechischer Mathematiker, Geograph und Astronom</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
