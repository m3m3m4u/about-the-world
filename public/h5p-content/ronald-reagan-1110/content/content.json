            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of Ronald Reagan</strong><br>\nRonald Reagan was born on February 6, 1911, in Tampico, Illinois. Growing up in a poor family during World War I and the Great Depression, Reagan developed a belief in the importance of a free-market economy and the downsides of government intervention. He graduated from Eureka College in 1932 and worked as a radio sports announcer before moving to Hollywood to become an actor.</p>\n\n<p><strong>Hollywood Career</strong><br>\nReagan’s acting career spanned over two decades, starting in the 1930s. He appeared in over 50 films and numerous television series, becoming a recognizable figure in the entertainment industry. His roles ranged from romantic leads to action heroes, which made him a well-known personality in American households.</p>\n\n<p><strong>Military Service</strong><br>\nDuring World War II, Reagan was called to active duty in the Army Reserve but was disqualified from combat duty due to poor eyesight. Instead, he spent his service making training films for the Army Air Forces. This experience shaped his later views on the military and international relations.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
