              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Pierre Curie (1859-1906) - Französischer Physiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
