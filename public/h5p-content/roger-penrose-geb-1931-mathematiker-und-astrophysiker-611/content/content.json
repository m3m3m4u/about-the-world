              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Roger Penrose (geb. 1931) - Mathematiker und Astrophysiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
