          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life and Career</strong><br>\nLyndon B. Johnson was born on August 27, 1908, in Stonewall, Texas. He worked as a teacher before beginning his long career in politics with the Democratic Party, serving in the House and Senate.</p>\n\n<p><strong>Vice Presidency</strong><br>\nJohnson was elected as John F. Kennedy's vice president in 1960 and was serving in this role when Kennedy was assassinated in 1963. He was sworn in as president the same day.</p>\n\n<p><strong>Great Society</strong><br>\nAs president, Johnson launched the \"Great Society\" program, which aimed to eliminate poverty and racial injustice. His policies led to the creation of Medicare, Medicaid, and other welfare programs.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
