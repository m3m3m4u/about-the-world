          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Civil Rights</strong><br>\nHe is credited with the passage of several civil rights laws, including the landmark Civil Rights Act of 1964 and the Voting Rights Act of 1965, which ended legal segregation and discrimination.</p>\n\n<p><strong>Vietnam War</strong><br>\nJohnson's presidency was marred by the Vietnam War. His decision to escalate U.S. military involvement led to widespread protest and division within the United States.</p>\n\n<p><strong>Education and Arts</strong><br>\nJohnson significantly contributed to the advancement of education and the arts, signing into law the Public Broadcasting Act of 1967, which established the Corporation for Public Broadcasting.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
