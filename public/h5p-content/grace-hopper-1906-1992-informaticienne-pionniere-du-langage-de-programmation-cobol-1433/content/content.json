              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Grace Hopper (1906-1992) - Informaticienne, pionnière du langage de programmation COBOL</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
              "metadata": {
