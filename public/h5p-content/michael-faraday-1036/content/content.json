            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Public Service and Education</strong><br>\nFaraday was a passionate science communicator, delivering a series of lectures at the Royal Institution aimed at young people, which are still continued today as the Christmas Lectures.</p>\n\n<p><strong>Later Years and Recognition</strong><br>\nAlthough Faraday retired in the late 1850s due to declining health, he received numerous honors and awards throughout his career, reflecting the immense respect he garnered in the field of science.</p>\n\n<p><strong>Legacy and Impact</strong><br>\nFaraday's extensive work not only shaped the understanding of electromagnetic phenomena but also contributed significantly to practical applications in technology that changed the world.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
