              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Friedrich Hayek (1899-1992) - Ökonom</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
