          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nSimon Bolivar was born on July 24, 1783, in Caracas, in what is now Venezuela. Born into a wealthy family, he was sent to Europe for his education, where he witnessed the coronation of Napoleon, an event that greatly influenced his political ideas.</p>\n\n<p><strong>Military Career</strong><br>\nAfter returning to Venezuela, Bolivar became involved in the resistance movement against Spanish rule. His military career began with a series of setbacks, but he persisted, driven by his vision of a liberated South America.</p>\n\n<p><strong>The Liberator</strong><br>\nBolivar earned the nickname \"El Libertador\" for his decisive role in the independence of several South American countries. He led military campaigns that freed not just his native Venezuela but also Colombia, Panama, Ecuador, Peru, and Bolivia.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
