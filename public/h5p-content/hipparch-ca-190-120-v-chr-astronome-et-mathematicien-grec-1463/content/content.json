              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Hipparch (ca. 190-120 v. Chr.) - Astronome et mathématicien grec</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
