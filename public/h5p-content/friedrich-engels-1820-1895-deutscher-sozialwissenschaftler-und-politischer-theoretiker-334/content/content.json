              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Friedrich Engels (1820-1895) - Deutscher Sozialwissenschaftler und politischer Theoretiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
