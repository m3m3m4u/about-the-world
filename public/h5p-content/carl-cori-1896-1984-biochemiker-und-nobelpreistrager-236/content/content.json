              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Carl Cori (1896-1984) - Biochemiker und Nobelpreisträger</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
