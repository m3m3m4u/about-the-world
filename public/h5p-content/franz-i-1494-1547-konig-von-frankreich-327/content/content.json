      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Förderung von Kunst und Wissenschaft</strong><br>\nAls großer Mäzen der Künste förderte Franz I. Künstler wie Leonardo da Vinci, den er nach Frankreich einlud, und errichtete prächtige Bauten wie das Schloss Chambord. Er gründete auch das Collège de France, eine bedeutende wissenschaftliche Institution. Seine Regierungszeit wird oft als Beginn der französischen Renaissance betrachtet.</p>\n\n<p><strong>Innenpolitische Reformen</strong><br>\nUm die Verwaltung seines Reiches zu stärken, führte Franz I. wichtige Reformen durch. Er modernisierte das Steuersystem, verstärkte die Zentralgewalt und verbesserte das Rechtssystem. Seine Reformen hatten das Ziel, den Einfluss des Adels zu begrenzen und die königliche Autorität zu stärken.</p>\n\n<p><strong>Konflikt mit Karl V.</strong><br>\nEiner der größten Rivalen von Franz I. war Kaiser Karl V., der über ein riesiges Reich in Europa und Amerika herrschte. Ihre Konflikte waren nicht nur militärischer Natur, sondern auch persönliche Fehden, die die europäische Politik des 16. Jahrhunderts prägten. Der Kampf um Vorherrschaft in Europa war ein zentrales Thema seiner Regierungszeit.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
