              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Grace Hopper (1906-1992) - scienziata informatica, pioniera del linguaggio di programmazione COBOL</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
              "metadata": {
