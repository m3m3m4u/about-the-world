              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Rachel Carson (1907-1964) - Biologin und Autorin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
