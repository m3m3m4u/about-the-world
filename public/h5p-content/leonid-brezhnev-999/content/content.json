          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Years</strong><br>\nLeonid Brezhnev was born in 1906 in Kamenskoe, now known as Dniprodzerzhynsk, in Ukraine, then part of the Russian Empire. He was the son of a steelworker and grew up in a working-class family.</p>\n\n<p><strong>Rise to Power</strong><br>\nBrezhnev joined the Komsomol (Communist Youth League) in 1923 and became a member of the Communist Party of the Soviet Union (CPSU) in 1931. He rose through the ranks, holding various positions before becoming a major political figure.</p>\n\n<p><strong>Leader of the Soviet Union</strong><br>\nHe became the leader of the Soviet Union in 1964 after Nikita Khrushchev's removal from power. Brezhnev served as the General Secretary of the CPSU and the chairman of the Presidium of the Supreme Soviet, effectively the president of the Soviet Union.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
