              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Alfred Kinsey (1894-1956) - Biologiste et sexologue</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
