                "text": "<p><span style=\"font-size:3em;\"><strong>Cómodo (161-192 d.C.), emperador romano</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Información y ejercicios</span></strong></p>\n"
