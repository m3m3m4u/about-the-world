              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Thomas Paine (1737-1809) - Englisch-amerikanischer Schriftsteller und Revolutionär</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
