              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Max Planck (1858-1947) - fisico</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
