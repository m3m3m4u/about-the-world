              },
              "subContentId": "5627dc6e-c943-439e-ab4a-4531b7f24264"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Vita di Richard Nixon</strong><br>\nRichard Nixon nacque nel 1913 in California. Dopo aver completato gli studi in legge, servì nella Marina durante la Seconda Guerra Mondiale. Entrò in politica come repubblicano e venne eletto al Congresso nel 1946. Nixon divenne vicepresidente sotto la presidenza di Eisenhower nel 1953 e svolse un ruolo attivo nella politica interna ed estera degli Stati Uniti.</p>\n\n<p><strong>La presidenza di Eisenhower</strong><br>\nDurante i due mandati di Eisenhower, Nixon fu un vicepresidente influente. Partecipò attivamente al dibattito politico, specialmente in politica estera. Nel 1959, durante un tour in Unione Sovietica, sostenne un famoso dibattito sulla politica e l'economia con il leader sovietico Nikita Kruscev, noto come la \"cucina Debate\".</p>\n\n<p><strong>La campagna presidenziale del 1960</strong><br>\nNixon si candidò per la presidenza nel 1960, ma perse di stretta misura contro John F. Kennedy. La sua sconfitta fu in parte attribuita al suo aspetto meno telegenico durante i primi dibattiti televisivi della storia americana. Tuttavia, non si ritirò dalla vita politica e fu eletto presidente nel 1968.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "it"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
