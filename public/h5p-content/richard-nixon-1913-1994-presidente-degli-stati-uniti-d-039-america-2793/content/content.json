              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Richard Nixon (1913-1994) - Presidente degli Stati Uniti d'America</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
