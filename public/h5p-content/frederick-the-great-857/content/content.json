            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of Frederick the Great</strong><br>\nFrederick the Great was born in 1712 to King Frederick William I of Prussia and Queen Sophia Dorothea of Hanover. He grew up in a strict military environment, but he had a keen interest in music and philosophy. Despite his father's effort to instill military discipline, Frederick was more attracted to the arts, which caused tension between them. He tried to escape from his father's oppressive regime but was caught and forced to witness the execution of his accomplice.</p>\n\n<p><strong>Ascension to Power</strong><br>\nFrederick ascended to the throne in 1740 after the death of his father. He inherited a disciplined army and a state with efficient bureaucracy. Immediately after becoming king, he seized the opportunity to expand his territory by invading Silesia, which began the War of the Austrian Succession. His military exploits demonstrated his strength and the power of the Prussian military.</p>\n\n<p><strong>Military Reforms</strong><br>\nAs a military strategist, Frederick the Great made significant reforms to the Prussian army. He introduced new tactics and emphasized speed and mobility in combat, which often gave him the upper hand against larger but slower armies. His reforms led to the development of the oblique order of battle, a tactic that contributed to his victories.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
