          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nJoseph Stalin was born on December 18, 1878, in Gori, Georgia, then part of the Russian Empire. He joined the revolutionary movement against the imperial government as a young man.</p>\n\n<p><strong>Rise to Power</strong><br>\nStalin rose through the ranks of the Bolshevik Party and became a key figure in the Russian Revolution of 1917. Following Vladimir Lenin's death in 1924, Stalin outmaneuvered his rivals for control of the party.</p>\n\n<p><strong>Five-Year Plans</strong><br>\nStalin implemented the first of several \"Five-Year Plans\" in the late 1920s to rapidly industrialize the Soviet Union. His policies significantly increased production but also caused widespread hardship and millions of deaths.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
