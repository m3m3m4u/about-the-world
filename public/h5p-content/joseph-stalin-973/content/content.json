          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Great Purges</strong><br>\nThe Great Purges from the late 1930s were a campaign of political repression. Stalin eliminated perceived threats to his power, resulting in the execution or imprisonment of millions.</p>\n\n<p><strong>World War II and the Soviet Union</strong><br>\nUnder Stalin's leadership, the Soviet Union played a critical role in the defeat of Nazi Germany in World War II, at the cost of over twenty million Soviet lives.</p>\n\n<p><strong>Postwar Era and Cold War</strong><br>\nAfter the war, Stalin established Soviet influence over Eastern Europe, contributing to the Cold War's onset between the Soviet Union and Western powers.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
