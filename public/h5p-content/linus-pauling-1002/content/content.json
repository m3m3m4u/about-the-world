            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Linus Pauling's Early Life</strong><br>\nLinus Pauling was born in Portland, Oregon, in 1901. As a child, he was interested in science and read books on the subject whenever he could. He won a national chemistry contest while in high school, which solidified his desire to pursue chemistry. Pauling attended Oregon State University and later went to the California Institute of Technology for his Ph.D. in chemistry.</p>\n\n<p><strong>Pauling's Scientific Contributions</strong><br>\nPauling made significant contributions to the field of chemistry and is considered one of the founders of quantum chemistry and molecular biology. His research on chemical bonding, for which he received a Nobel Prize in Chemistry in 1954, changed the way scientists understood the structure of molecules. He also developed the concept of electronegativity, helping to predict the nature of bonds between atoms in molecules.</p>\n\n<p><strong>His Work on Proteins</strong><br>\nPauling's interest in the structure of proteins led to his discovery of the alpha helix and beta sheet, which are the fundamental building blocks of protein structure. This work was pivotal for the field of molecular biology and helped other scientists understand how proteins function in the human body. Pauling's protein models have been vital for medical research and biotechnology.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
