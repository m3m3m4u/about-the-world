              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Joseph Staline (1878-1953) - dirigeant soviétique</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
