                "title": "Unbenannt: Text",
                "defaultLanguage": "it"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Soluzione a tre stati</strong><br>\nUna meno conosciuta soluzione a tre stati potrebbe prevedere la creazione di tre stati separati: Israele, Cisgiordania e Striscia di Gaza. Questo potrebbe essere un modo per riconoscere le diverse condizioni politiche e sociali in queste aree. Tuttavia, è incerto se questa soluzione potrebbe promuovere la stabilità e la sicurezza a lungo termine nella regione.</p>\n\n<p><strong>Coinvolgimento internazionale</strong><br>\nGli attori internazionali svolgono un ruolo importante nel conflitto israelo-palestinese. Le Nazioni Unite, gli Stati Uniti e altri paesi hanno cercato di mediare e trovare soluzioni. Tuttavia, i loro sforzi sono spesso ostacolati da interessi geopolitici e dalla complessità del conflitto.</p>\n\n<p><strong>Impatti del conflitto</strong><br>\nIl conflitto ha profondi impatti sulle persone nella regione. Porta alla perdita di vite, allo spostamento, a difficoltà economiche e a una mancanza di stabilità politica. Anche gli impatti psicologici del conflitto sulle comunità interessate sono significativi.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "it"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
