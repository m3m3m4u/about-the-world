              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Ernest Rutherford (1871-1937) - physicien</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
