              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>George H.W. Bush (1924-2018) - Presidente USA</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
