          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of Napoleon Bonaparte</strong><br>\nNapoleon Bonaparte was born on the island of Corsica in 1769, just months after it became a French territory. He was sent to France for schooling at the age of nine and later attended military academy, beginning his military career as an artillery officer.</p>\n\n<p><strong>Rise to Power</strong><br>\nNapoleon rose to prominence during the French Revolution, quickly ascending through the ranks to become a general at the age of 24. His early military campaigns in Italy and Egypt were marked by bold strategies and decisive victories, earning him national fame.</p>\n\n<p><strong>Consulate and Empire</strong><br>\nAfter a coup d'état in 1799, Napoleon became the First Consul of France, and in 1804 he declared himself Emperor. His rule brought legal reform with the Napoleonic Code and centralized administrative governance, but it was also marked by continuous warfare.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
