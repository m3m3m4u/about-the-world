          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>International Acclaim and Travel</strong><br>\nBerlioz conducted tours across Europe, where his works were performed, gaining him recognition as one of the leading composers of his time. Despite this, he struggled for consistent recognition in France.</p>\n\n<p><strong>Personal and Professional Struggles</strong><br>\nHis personal life was marked by tumultuous relationships and financial struggles. Despite periods of depression and illness, he continued to create music that pushed the boundaries of the form.</p>\n\n<p><strong>Legacy and Influence</strong><br>\nBerlioz died in 1869, leaving behind a body of work that significantly impacted the development of romantic music. His innovative approach to composition and orchestration influenced generations of composers.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3d655444-fd55-42f7-aba2-16a16db7dc58"
