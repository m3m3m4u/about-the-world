              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Rachel Carson (1907-1964) - biologa marina e autrice di Silent Spring (Primavera silenziosa)</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
