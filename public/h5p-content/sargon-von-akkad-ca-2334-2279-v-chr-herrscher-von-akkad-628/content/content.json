      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 3)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "4381b60d-c67f-4722-b83d-b17f2fc9d01c"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Kultureller Einfluss</strong><br>\nAkkad war ein Schmelztiegel der Kulturen, und Sargon unterstützte aktiv die Verbreitung akkadischer Sprache und Kultur. Diese Politik förderte die Entstehung einer gemeinsamen Identität innerhalb seines Reiches und trug zum kulturellen Erbe Mesopotamiens bei, das noch Jahrhunderte nach seinem Tod spürbar war.</p>\n\n<p><strong>Sargons Nachfolge</strong><br>\nNach Sargons Tod übernahmen seine Nachkommen die Herrschaft, aber keiner erreichte seine Statur. Sein Enkel Naram-Sin und sein Sohn Rimush waren beide Könige von Akkad, aber in den folgenden Generationen begann das Reich allmählich zu zerfallen, teilweise durch inneren Aufruhr und äußere Invasionen.</p>\n\n<p><strong>Erbe und Legende</strong><br>\nSargons Ruf als großer Eroberer überdauerte die Jahrtausende und inspirierte spätere Generationen von Herrschern. Seine Legende wurde durch die Schriften antiker Historiker und durch zahlreiche Inschriften verewigt, die seine Taten rühmten. Sargon von Akkad bleibt eine Schlüsselfigur in der Geschichte des alten Nahen Ostens.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3d655444-fd55-42f7-aba2-16a16db7dc58"
