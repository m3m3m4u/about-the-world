              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Dennis Ritchie (1941-2011) - Informaticien, co-développeur d'UNIX et du langage de programmation C</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
