              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Charles Darwin (1809-1882) - Naturaliste, célèbre pour la théorie de l'évolution</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
