      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Umzug nach Weimar</strong><br>\n1708 zog Bach nach Weimar und arbeitete dort als Hoforganist und Konzertmeister. In Weimar schuf Bach viele seiner Orgelwerke und erste Kompositionen für das Cembalo. Hier vertiefte er seinen persönlichen Stil und experimentierte mit verschiedenen musikalischen Formen und Techniken.</p>\n\n<p><strong>Bach in Köthen</strong><br>\n1717 wurde Bach Kapellmeister am Hof des Fürsten Leopold von Anhalt-Köthen. Da die Hofkapelle hauptsächlich weltliche Musik spielte, konzentrierte sich Bach in dieser Zeit auf Kammermusik und weltliche Kantaten. Zu seinen berühmtesten Werken aus dieser Zeit zählen die Brandenburgischen Konzerte.</p>\n\n<p><strong>Thomaskantor in Leipzig</strong><br>\nAb 1723 wirkte Bach als Kantor an der Thomasschule und Musikdirektor in Leipzig. Er komponierte dort vor allem geistliche Musik für die Leipziger Kirchen. Diese Phase war besonders produktiv und umfasste viele seiner Passionsmusiken, Kantaten und die h-Moll-Messe, eines seiner zentralen Werke.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
