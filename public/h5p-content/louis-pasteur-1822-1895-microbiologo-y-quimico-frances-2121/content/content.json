              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Louis Pasteur (1822-1895) - Microbiólogo y químico francés</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Información y ejercicios</span></strong></p>\n"
              },
