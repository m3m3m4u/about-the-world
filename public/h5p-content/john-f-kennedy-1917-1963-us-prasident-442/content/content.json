              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>John F. Kennedy (1917-1963) - US-Präsident</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
