              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Edward Jenner (1749-1823) - Médecin, pionnier du développement de vaccins</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
