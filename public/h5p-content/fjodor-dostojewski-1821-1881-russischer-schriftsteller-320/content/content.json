              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Fjodor Dostojewski (1821-1881) - Russischer Schriftsteller</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
