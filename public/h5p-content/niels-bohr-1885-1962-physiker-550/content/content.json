              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Niels Bohr (1885-1962) - Physiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
