          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Nobel Prize in Chemistry</strong><br>\nIn recognition of her outstanding contributions to chemistry and the development of X-ray crystallography, Hodgkin was awarded the Nobel Prize in Chemistry in 1964. She was the third woman to receive the Nobel Prize in Chemistry.</p>\n\n<p><strong>Political and Humanitarian Interests</strong><br>\nBeyond her scientific achievements, Hodgkin was also known for her political and humanitarian efforts. She was an advocate for scientific research and education and used her status to promote peace and international cooperation.</p>\n\n<p><strong>Advancements in Biomolecular Structure</strong><br>\nHodgkin's work extended to determining the structures of important biological molecules such as penicillin and vitamin B12. Her detailed mappings of these molecules facilitated the development of new pharmaceuticals and treatments.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
