              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Andrew Carnegie (1835-1919) - industriale e filantropo americano</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
