              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Vinton Cerf (geb. 1943) - Vater des Internets, Mitentwickler des TCPIP-Protokolls</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "dff56334-2e6b-4f64-ab5f-fd72e6484f52"
