      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Symbol des Friedens</strong><br>\nAls spirituelles Oberhaupt der Tibeter wurde der Dalai Lama zu einem weltweiten Symbol des Friedens und der Gewaltfreiheit. Er erhielt den Friedensnobelpreis 1989 für seinen gewaltlosen Kampf für die Befreiung Tibets. Seine Bemühungen haben weltweit Anerkennung und Unterstützung für die tibetische Sache geweckt.</p>\n\n<p><strong>Lehren und Reisen</strong><br>\nDer Dalai Lama bereiste viele Länder und hielt Vorträge über Buddhismus, Ethik und Frieden. Er verfasste auch zahlreiche Bücher und führte Dialoge mit Wissenschaftlern und Religionsführern, um universelle Werte und interreligiösen Austausch zu fördern.</p>\n\n<p><strong>Politische und geistige Rollen</strong><br>\nAls politisches Oberhaupt setzte sich der Dalai Lama für Demokratie und Menschenrechte ein und drängte auf Autonomie für Tibet. Er betonte die Bedeutung der geistigen Entwicklung und vermittelte die Prinzipien des tibetischen Buddhismus an seine Anhänger.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
