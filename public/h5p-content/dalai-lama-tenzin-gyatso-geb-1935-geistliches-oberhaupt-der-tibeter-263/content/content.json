              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Dalai Lama (Tenzin Gyatso, geb. 1935) - Geistliches Oberhaupt der Tibeter</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
