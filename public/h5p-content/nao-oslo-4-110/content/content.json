              },
              "subContentId": "4381b60d-c67f-4722-b83d-b17f2fc9d01c"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Conseguenze dell'Accordo</strong><br>\nUna delle conseguenze dell'Accordo di Oslo è stata la creazione dell'Autorità Palestinese, che aveva un certo grado di autonomia in alcune aree. Tuttavia, le tensioni e i conflitti continui hanno fatto sì che i progressi sperati verso la pace non fossero realizzati.</p>\n\n<p><strong>Ostacoli e Sfide</strong><br>\nL'Accordo di Oslo ha incontrato numerosi ostacoli e sfide. Questi includevano violenza continua, la politica degli insediamenti di Israele e disaccordi sullo status finale. Questi fattori hanno contribuito al mancato raggiungimento dell'obiettivo originale di creare una pace duratura.</p>\n\n<p><strong>Lezioni dall'Accordo di Oslo</strong><br>\nL'Accordo di Oslo ci insegna che il processo di pace nel Medio Oriente è complesso e impegnativo. Mostra anche che, nonostante le buone intenzioni e gli sforzi significativi da entrambe le parti, la risoluzione dei conflitti duraturi richiede tempo, pazienza e una vera volontà di collaborare.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "it"
              },
