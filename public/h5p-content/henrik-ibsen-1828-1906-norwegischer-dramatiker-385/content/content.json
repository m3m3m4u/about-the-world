              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Henrik Ibsen (1828-1906) - Norwegischer Dramatiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
