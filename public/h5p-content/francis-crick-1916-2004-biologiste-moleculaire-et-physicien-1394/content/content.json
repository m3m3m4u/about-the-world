              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Francis Crick (1916-2004) - Biologiste moléculaire et physicien</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
