              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Federico Fellini (1920-1993) - Filmregisseur</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
