          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>William Blake's Early Life</strong><br>\nWilliam Blake was born in 1757 in London to a hosier. He began exhibiting artistic talent early in life, which led to an apprenticeship in engraving and his study at the Royal Academy of Arts.</p>\n\n<p><strong>Poetry and Art</strong><br>\nBlake is well-known for his unique combination of poetry and visual art. His illustrated collection of poems, \"Songs of Innocence and Experience,\" showcases his ability to convey profound ideas through both words and images.</p>\n\n<p><strong>Visionary Imagination</strong><br>\nThroughout his life, Blake claimed to experience visions that influenced his work. His art features mystical, allegorical figures and complex, symbolic imagery drawn from these personal visions and his deep spiritual beliefs.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
        "slideBackgroundSelector": {}
      },
      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>INFORMATION TEXT (Part 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
