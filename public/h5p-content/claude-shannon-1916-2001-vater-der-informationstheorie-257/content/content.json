      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 3)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "4381b60d-c67f-4722-b83d-b17f2fc9d01c"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Shannons Schachspielende Maschine</strong><br>\nNeben seiner Arbeit in der Informationstheorie baute Shannon auch eine der ersten schachspielenden Maschinen. Dieses Gerät konnte tatsächlich gegen einen menschlichen Gegner Schach spielen. Es war ein früher Hinweis auf das Potenzial von Computern, nicht nur Rechenaufgaben zu übernehmen, sondern auch Entscheidungen zu treffen.</p>\n\n<p><strong>Privatleben und Hobbys</strong><br>\nClaude Shannon hatte viele Interessen außerhalb der Wissenschaft. Er war ein begabter Jongleur und erfand viele Geräte, darunter eine Jongliermaschine. Auch in seiner Freizeit blieb er ein Erfinder und bastelte an unterschiedlichen Projekten, die oft einen spielerischen Charakter hatten.</p>\n\n<p><strong>Vermächtnis und Einfluss</strong><br>\nClaude Shannon starb am 24. Februar 2001. Sein Einfluss auf die Informations- und Computertechnologie ist jedoch unbestritten. Durch seine Arbeiten wurde die digitale Revolution möglich, und seine Theorien sind immer noch die Basis für die Datenübertragung und -verarbeitung in heutigen Technologien. Sein Vermächtnis lebt in jedem digitalen Gerät und jeder Internetübertragung weiter.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3d655444-fd55-42f7-aba2-16a16db7dc58"
