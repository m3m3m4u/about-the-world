              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Konrad Lorenz (1903-1989) - Zoologe, Mitbegründer der Ethologie</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
