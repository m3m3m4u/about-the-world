          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Years</strong><br>\nTeddy Roosevelt was born on October 27, 1858, in New York City. Despite being homeschooled due to health problems, he excelled in his studies, particularly in natural history, which fostered a lifelong passion for the natural world.</p>\n\n<p><strong>Rise in Politics</strong><br>\nRoosevelt's political career began in the New York State Assembly, where he served from 1882 to 1884. He gained a reputation as a reformer who fought against corruption in government during the Gilded Age.</p>\n\n<p><strong>Rough Riders and War Hero</strong><br>\nDuring the Spanish-American War in 1898, Roosevelt led the Rough Riders, a volunteer cavalry unit, in a charge up San Juan Hill in Cuba. The success of the Rough Riders made Roosevelt a national hero and helped propel him to the national political stage.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
