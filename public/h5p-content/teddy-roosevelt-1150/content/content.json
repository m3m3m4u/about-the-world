          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Nobel Peace Prize</strong><br>\nIn 1906, Roosevelt was awarded the Nobel Peace Prize for his role in mediating the Russo-Japanese War, marking the first time an American had received this honor.</p>\n\n<p><strong>Post-Presidency</strong><br>\nAfter his presidency, Roosevelt remained active in politics. He ran for president again in 1912 as a member of the Progressive Party, also known as the Bull Moose Party, but was unsuccessful.</p>\n\n<p><strong>Death and Legacy</strong><br>\nRoosevelt died on January 6, 1919, at the age of 60. His legacy includes his contributions to the progressive era, his vigorous foreign policy, and his enduring popularity as an American icon.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3d655444-fd55-42f7-aba2-16a16db7dc58"
