          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Vice President and Ascension to Presidency</strong><br>\nRoosevelt became vice president in March 1901 and assumed the presidency after the assassination of President William McKinley in September of that year. He was the youngest person to become President of the United States at the age of 42.</p>\n\n<p><strong>Progressive Policies and Conservations</strong><br>\nAs president, Roosevelt was known for his progressive policies. He championed the conservation movement, established national parks, forests, and monuments, and worked to control large corporations and ensure public fairness.</p>\n\n<p><strong>Foreign Policy and the Panama Canal</strong><br>\nRoosevelt's foreign policy was famously summarized by his phrase \"speak softly and carry a big stick.\" He was instrumental in the construction of the Panama Canal, which connected the Atlantic and Pacific Oceans.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
