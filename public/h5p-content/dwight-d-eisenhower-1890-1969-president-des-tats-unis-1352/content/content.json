              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Dwight D. Eisenhower (1890-1969) - président des États-Unis</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
