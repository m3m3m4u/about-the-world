              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Booker T. Washington (1856-1915) - Amerikanischer Erzieher und Bürgerrechtler</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
