            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Personal Reflections</strong><br>\nHe often spoke about the experience of solitude while orbiting the moon alone, reflecting on the contrasting vastness of space and the Earth's preciousness.</p>\n\n<p><strong>Honors and Awards</strong><br>\nCollins was awarded the Presidential Medal of Freedom and several other decorations for his service and contributions to space exploration.</p>\n\n<p><strong>Later Years and Legacy</strong><br>\nUntil his death on April 28, 2021, Collins remained an insightful and inspirational figure, sharing his perspective on space travel and humanity's place in the universe.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
