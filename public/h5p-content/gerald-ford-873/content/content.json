            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nGerald Ford was born in Nebraska and grew up in Michigan. He excelled in athletics and academics before serving in the Navy during World War II.</p>\n\n<p><strong>Political Career Before Presidency</strong><br>\nFord served in the U.S. House of Representatives for 25 years, eventually becoming the House Minority Leader.</p>\n\n<p><strong>Becoming Vice President and President</strong><br>\nHe was appointed Vice President in 1973 after Spiro Agnew's resignation and became President in 1974 after Richard Nixon resigned due to the Watergate scandal.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
