          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Domestic Policy and Economy</strong><br>\nFord faced a difficult economy with inflation and a recession during his time in office, leading to controversial measures like the WIN (Whip Inflation Now) campaign.</p>\n\n<p><strong>Pardon of Richard Nixon</strong><br>\nOne of Ford's most controversial decisions was granting a presidential pardon to Richard Nixon for his role in the Watergate scandal.</p>\n\n<p><strong>Foreign Policy and Helsinki Accords</strong><br>\nFord’s administration saw the end of the Vietnam War and the strengthening of détente with the signing of the Helsinki Accords, which aimed to improve relations between the Communist bloc and the West.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
