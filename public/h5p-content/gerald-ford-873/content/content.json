            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Election of 1976</strong><br>\nFord narrowly lost the 1976 presidential election to Jimmy Carter after a tough campaign overshadowed by his pardon of Nixon and economic troubles.</p>\n\n<p><strong>Legacy and Retirement</strong><br>\nAfter his presidency, Ford remained active in the Republican Party and was celebrated for his integrity and leadership in difficult times.</p>\n\n<p><strong>Personal Views</strong><br>\nFord believed in moderate political policies, cooperation between parties, and was known for his commitment to American values.</p>\n"
              },
