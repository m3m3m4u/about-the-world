              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Grace Hopper (1906-1992) - Computerwissenschaftlerin, Pionierin der Programmiersprache COBOL</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
