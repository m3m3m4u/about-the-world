              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Ptolemäus (ca. 100-170 n. Chr.) - Griechischer Astronom, Geograph und Mathematiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
