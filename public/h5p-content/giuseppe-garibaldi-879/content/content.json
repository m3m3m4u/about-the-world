            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Final Years</strong><br>\nGaribaldi's final years were marked by declining health and financial troubles. Despite this, he remained an active voice in politics, advocating for Rome to become part of Italy, which happened in 1871.</p>\n\n<p><strong>Death and Legacy</strong><br>\nGaribaldi died on June 2, 1882, on the island of Caprera, where he had retired. His legacy as a national hero is immortalized in many monuments across Italy, and his name is synonymous with courage and the struggle for freedom.</p>\n\n<p><strong>Influence Beyond Italy</strong><br>\nGaribaldi's influence extended beyond Italy. His life and work inspired liberation movements worldwide, and he is celebrated as a universal symbol of the fight for liberty and unity.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
