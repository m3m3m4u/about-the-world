          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nGiuseppe Garibaldi was born on July 4, 1807, in Nice, which at that time was part of the French Empire. His early career was as a sailor, which exposed him to various political ideas and the concept of nationalism that was sweeping through Europe.</p>\n\n<p><strong>South American Influence</strong><br>\nGaribaldi spent many years in South America, where he fought in Brazil and Uruguay. His military engagements there, particularly the defense of Montevideo, earned him a reputation as a skilled guerrilla leader and a proponent of republicanism.</p>\n\n<p><strong>Italian Unification</strong><br>\nHe returned to Italy in 1848 to fight in the First Italian War of Independence. As a leading figure in the Risorgimento, the movement for Italian unification, he commanded forces in multiple military campaigns across the Italian peninsula.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
