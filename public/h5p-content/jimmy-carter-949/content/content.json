            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Post-Presidency Humanitarian Work</strong><br>\nAfter losing the 1980 election, Carter became involved in humanitarian work and international conflict resolution through the Carter Center.</p>\n\n<p><strong>Nobel Peace Prize</strong><br>\nCarter was awarded the Nobel Peace Prize in 2002 for his work in promoting peace and social welfare.</p>\n\n<p><strong>Environmental Advocacy</strong><br>\nIn his later years, Carter remained an advocate for environmental causes, fair housing, and the eradication of diseases.</p>\n"
              },
