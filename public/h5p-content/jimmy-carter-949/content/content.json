            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Domestic Policies</strong><br>\nHis domestic policies tackled energy conservation, environmental protection, and government efficiency but faced economic challenges, including inflation and an energy crisis.</p>\n\n<p><strong>Human Rights and Foreign Policy</strong><br>\nCarter emphasized human rights in foreign policy, brokering the Camp David Accords between Israel and Egypt and navigating the complexities of the Cold War.</p>\n\n<p><strong>Iranian Hostage Crisis</strong><br>\nThe Iranian hostage crisis, beginning in 1979, became a significant challenge for Carter, leading to a failed rescue attempt and impacting his reelection bid.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
