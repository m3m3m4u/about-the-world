            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life and Naval Career</strong><br>\nJimmy Carter grew up in rural Georgia and attended the Naval Academy, serving as a submarine officer.</p>\n\n<p><strong>Governor of Georgia</strong><br>\nAfter his naval service, Carter entered politics and served as Georgia's governor, where he focused on education and government reorganization.</p>\n\n<p><strong>1976 Presidential Election</strong><br>\nCarter won the presidency in 1976, presenting himself as a moral and honest alternative to Washington's establishment.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
