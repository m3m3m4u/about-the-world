              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Neil Armstrong (1930-2012) - Astronaut</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
