              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Edward O. Wilson (1929-2021) - Biologe und Naturforscher</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
