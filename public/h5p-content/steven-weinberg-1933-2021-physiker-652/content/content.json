      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Nobelpreis für Physik</strong><br>\nFür seine Arbeit in der Physik wurde Weinberg 1979 mit dem Nobelpreis ausgezeichnet. Er erhielt die Auszeichnung gemeinsam mit Sheldon Glashow und Abdus Salam für ihren Beitrag zur Theorie der vereinheitlichten schwachen und elektromagnetischen Wechselwirkung zwischen Elementarteilchen. Dieser Preis würdigte ihre Errungenschaften in der Erstellung eines Rahmens, der half, die Funktionsweise des Universums auf subatomarer Ebene zu erklären.</p>\n\n<p><strong>Lehrbücher und Öffentliche Vorträge</strong><br>\nNeben seinen Forschungsbeiträgen schrieb Weinberg auch Lehrbücher, die zu den Standardwerken in der Physik gehören. Sein Buch \"Die ersten drei Minuten\" ist ein populärwissenschaftlicher Text über die Entstehung des Universums und wurde ein Bestseller. Er hielt zudem viele öffentliche Vorträge, um die Wissenschaft einer breiteren Öffentlichkeit zugänglich zu machen.</p>\n\n<p><strong>Politisches und Gesellschaftliches Engagement</strong><br>\nWeinberg war auch für sein politisches und gesellschaftliches Engagement bekannt. Er sprach sich gegen den Krieg in Vietnam aus und setzte sich für die Reduzierung von Nuklearwaffen ein. Er äußerte sich häufig zu wissenschaftlichen und philosophischen Fragen und war ein Befürworter der Trennung von Kirche und Staat sowie der säkularen Humanität.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
