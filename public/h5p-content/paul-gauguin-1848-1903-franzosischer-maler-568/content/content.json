              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Paul Gauguin (1848-1903) - Französischer Maler</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
