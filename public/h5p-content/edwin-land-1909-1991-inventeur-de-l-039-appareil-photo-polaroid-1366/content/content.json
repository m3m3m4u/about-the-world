              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Edwin Land (1909-1991) - Inventeur de l'appareil photo Polaroid</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
