          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Major Poetic Achievements</strong><br>\nHis most significant works, the \"Canti,\" are a collection of poems that deal with themes of nature, love, and solitude. The \"Canti\" are considered masterpieces of 19th-century Italian literature.</p>\n\n<p><strong>The \"Operette Morali\" Essays</strong><br>\nBesides poetry, Leopardi wrote a series of dialogues and essays titled \"Operette Morali,\" which expressed his philosophical ideas and showcased his exceptional skill in prose.</p>\n\n<p><strong>Struggles with Health and Isolation</strong><br>\nLeopardi's life was marked by isolation and constant struggles with health. His physical condition and unrequited loves often influenced his contemplative and melancholic writings.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
