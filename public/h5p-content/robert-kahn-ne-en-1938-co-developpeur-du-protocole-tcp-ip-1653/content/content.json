              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Robert Kahn (né en 1938) - Co-développeur du protocole TCP-IP</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
              "metadata": {
