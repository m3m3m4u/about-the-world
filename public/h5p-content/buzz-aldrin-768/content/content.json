          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Historic Apollo 11 Flight</strong><br>\nOn July 20, 1969, Aldrin followed Neil Armstrong onto the lunar surface during the Apollo 11 mission, becoming the second man to walk on the moon.</p>\n\n<p><strong>Post-Moon Landing</strong><br>\nAfter retiring from NASA and the Air Force in 1972, Aldrin has been an advocate for space exploration, authoring books and promoting space policy.</p>\n\n<p><strong>Personal Struggles and Advocacy</strong><br>\nAldrin has been open about his battles with depression and alcoholism, becoming a vocal advocate for addressing these issues.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
