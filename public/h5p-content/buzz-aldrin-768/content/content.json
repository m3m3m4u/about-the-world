            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Public Perception</strong><br>\nAldrin is known for his charismatic and outspoken personality, often engaging with the public and media to share his experiences and perspectives on space travel.</p>\n\n<p><strong>Awards and Honors</strong><br>\nHe has been bestowed with the Presidential Medal of Freedom and numerous other honors reflecting his contributions to space and military service.</p>\n\n<p><strong>Continuing Legacy</strong><br>\nAldrin remains active in promoting space exploration and has proposed concepts for future Mars missions, maintaining a prominent voice in the space community.</p>\n"
              },
