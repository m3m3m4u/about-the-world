          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nCarl Jung was born in Switzerland on July 26, 1875. His father was a pastor, and his mother's mental health issues influenced his future interests. Jung developed a keen interest in understanding the human mind from a young age, which steered him toward the field of psychiatry.</p>\n\n<p><strong>University Studies and Early Career</strong><br>\nJung attended the University of Basel and graduated with a medical degree in 1900. He began his career at the Burghölzli psychiatric hospital in Zurich under the direction of Eugen Bleuler, an expert on mental disorders.</p>\n\n<p><strong>Relationship with Freud</strong><br>\nJung formed a close professional relationship with Sigmund Freud, and for a while, he was seen as the heir apparent to Freudian theory. However, he later broke with Freud over differing views on the nature of the unconscious.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
