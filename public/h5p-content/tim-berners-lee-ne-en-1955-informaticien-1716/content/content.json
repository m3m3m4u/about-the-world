              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Tim Berners-Lee (né en 1955) - informaticien</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
