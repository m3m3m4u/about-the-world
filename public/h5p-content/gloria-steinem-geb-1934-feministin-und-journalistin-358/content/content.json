      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Gründung von \"Ms. Magazine\"</strong><br>\nIm Jahr 1972 gründete Steinem zusammen mit anderen Aktivistinnen das Magazin \"Ms.\". Es war das erste Magazin seiner Art, das sich ausschließlich mit Themen beschäftigte, die für Frauen relevant waren, und trug dazu bei, die feministische Bewegung zu formen und voranzutreiben. Das Magazin bot eine Plattform für Debatten und literarische Beiträge von Frauen.</p>\n\n<p><strong>Feministische Kampagnen</strong><br>\nSteinem war an vielen wichtigen feministischen Kampagnen beteiligt, darunter der Kampf für das Equal Rights Amendment (ERA), das gleiche Rechte für alle Geschlechter garantieren sollte. Sie reiste durch die USA, um Vorträge zu halten, organisierte Veranstaltungen und beteiligte sich an politischen Aktionen, um Unterstützung für die Gleichstellung der Geschlechter zu gewinnen.</p>\n\n<p><strong>Bücher und Publikationen</strong><br>\nNeben ihrer Arbeit für \"Ms. Magazine\" hat Steinem mehrere Bücher geschrieben, darunter \"Outrageous Acts and Everyday Rebellions\" und \"Revolution from Within: A Book of Self-Esteem\". Diese Werke behandeln eine Vielzahl von Themen, von persönlichen Erfahrungen bis hin zu tiefgreifenden Analysen über die Stellung der Frau in der Gesellschaft.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
