      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Plancksche Konstante</strong><br>\nBei seinen Forschungen zur Strahlung führte Planck eine neue fundamentale Konstante ein, die nach ihm benannte Plancksche Konstante \\( h \\). Sie spielt eine zentrale Rolle in der Quantenphysik und beschreibt das Maß des Wirkungsquantums, welches die kleinstmögliche Energieübertragung bei Prozessen auf atomarer Ebene definiert.</p>\n\n<p><strong>Auszeichnungen und Ehrungen</strong><br>\nFür seine Beiträge zur Physik und speziell für die Schaffung der Quantentheorie erhielt Max Planck im Jahr 1918 den Nobelpreis für Physik. Diese Auszeichnung brachte ihm internationale Anerkennung. Planck wurde zu einem der führenden Wissenschaftler seiner Zeit und erhielt zahlreiche weitere Ehrungen und Medaillen.</p>\n\n<p><strong>Schwere Zeiten</strong><br>\nMax Planck erlebte persönliche Tragödien und musste den Verlust seiner Kinder ertragen. Während des Ersten Weltkriegs starb sein ältester Sohn an der Front. Die beiden Weltkriege und ihre Folgen hatten auch einen großen Einfluss auf sein wissenschaftliches Arbeiten und seine Haltung zur Politik.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
