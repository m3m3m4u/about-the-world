          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of William Shakespeare</strong><br>\nWilliam Shakespeare was born in 1564 in Stratford-upon-Avon, to John and Mary Shakespeare. His father was a successful local businessman, and his mother was the daughter of a landowner. Shakespeare attended the local grammar school, where he would have studied Latin literature and rhetoric. However, there is no record of him attending university.</p>\n\n<p><strong>Shakespeare's Career Begins</strong><br>\nShakespeare’s career began with his move to London, where he started as an actor before emerging as a playwright. By 1592, he had earned recognition as an actor and was mentioned in a London pamphlet mocking his success. His early plays were primarily comedies and histories, genres he raised to new heights.</p>\n\n<p><strong>The Globe Theatre</strong><br>\nIn 1599, Shakespeare became a shareholder in the Globe Theatre. Located on the South Bank of the River Thames, the Globe was the center of Shakespeare's professional life. It was here that many of his plays were performed, to the delight of a wide audience, from commoners to royalty.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
