              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Xerxes I (ca. 518-465 v. Chr.) - Persischer König</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
