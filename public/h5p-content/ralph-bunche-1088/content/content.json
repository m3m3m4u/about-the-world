            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>INFORMATION TEXT (Part 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Nobel Peace Prize</strong><br>\nFor his mediation efforts, Ralph Bunche was awarded the Nobel Peace Prize in 1950. He was the first African American to receive the award, and it highlighted his dedication to resolving international conflicts through negotiation.</p>\n\n<p><strong>Advocacy for Civil Rights</strong><br>\nBeyond his UN duties, Bunche was an active civil rights advocate. He participated in the civil rights movement in the United States, standing alongside figures like Martin Luther King Jr. and advocating for equal rights and justice.</p>\n\n<p><strong>Contributions to Decolonization</strong><br>\nBunche played a pivotal role in the process of decolonization within the UN. He supported the emergence of independent nations in Africa and Asia, following the decline of colonial empires after World War II.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
