          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life and Education of Ralph Bunche</strong><br>\nRalph Bunche was born in 1904 in Detroit, Michigan. He rose from humble beginnings to become an accomplished academic, earning a Ph.D. in political science from Harvard University. His doctoral dissertation was a significant early work in the field of political science.</p>\n\n<p><strong>Joining the United Nations</strong><br>\nAfter working for the Office of Strategic Services and the State Department, Bunche joined the United Nations. He quickly became a leading figure in the organization, involved in the formation of the UN itself and its role in global governance.</p>\n\n<p><strong>Mediation in Palestine</strong><br>\nBunche's most notable diplomatic achievement was his successful mediation in the Arab-Israeli conflict in the late 1940s. He was thrust into the lead role following the assassination of Count Folke Bernadotte and managed to negotiate armistice agreements between Israel and Arab states.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
