            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of Raffaello Sanzio</strong><br>\nRaffaello Sanzio, known as Raphael, was born in Urbino, Italy in 1483. He was the son of Giovanni Santi, a painter at the court of Urbino. Raphael learned the basics of painting and art from his father. When his father died in 1494, Raphael took over the workshop and developed his style by studying the works of Italian masters.</p>\n\n<p><strong>Raphael's Training</strong><br>\nRaphael continued his training by visiting other Italian cities, including Florence. There, he was influenced by the works of artists like Leonardo da Vinci and Michelangelo. This exposure to their works had a significant impact on his artistic development, helping him to refine his use of perspective and human anatomy.</p>\n\n<p><strong>Raphael in Florence</strong><br>\nDuring his stay in Florence from 1504 to 1508, Raphael's reputation as an artist grew. He became known for his Madonna paintings, which depicted the Virgin Mary with the Christ Child. These works were celebrated for their serenity and grace, and they reflected Raphael's exceptional ability to capture divine beauty.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
