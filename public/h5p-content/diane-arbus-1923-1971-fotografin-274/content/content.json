              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Diane Arbus (1923-1971) - Fotografin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
