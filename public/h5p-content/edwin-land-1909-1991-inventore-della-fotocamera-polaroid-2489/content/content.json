              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Edwin Land (1909-1991) - inventore della fotocamera Polaroid</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
