              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Thomas Edison (1847-1931) - Amerikanischer Erfinder und Geschäftsmann</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
