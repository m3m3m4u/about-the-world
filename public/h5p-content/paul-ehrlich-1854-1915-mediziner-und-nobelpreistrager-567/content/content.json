      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 3)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "4381b60d-c67f-4722-b83d-b17f2fc9d01c"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Nobelpreis für Medizin</strong><br>\nIm Jahr 1908 erhielt Paul Ehrlich gemeinsam mit Ilja Metschnikow den Nobelpreis für Medizin für ihre Arbeiten auf dem Gebiet der Immunologie. Ihr beider Beitrag zum Verständnis der körpereigenen Abwehrmechanismen revolutionierte die Medizin und legte den Grundstein für die moderne Immuntherapie.</p>\n\n<p><strong>Späte Jahre und Vermächtnis</strong><br>\nIn seinen späteren Jahren setzte Ehrlich seine Forschungen fort und trug wesentlich zur Entwicklung neuer Heilmittel und zur Fortbildung von Forschern bei. Sein Einfluss auf die Medizin ist bis heute spürbar, und sein Vermächtnis lebt in der Ehrlich-Gesellschaft für Chemotherapie fort, die sich der Erforschung neuer Medikamente widmet.</p>\n\n<p><strong>Bedeutung für die moderne Medizin</strong><br>\nPaul Ehrlich ist eine zentrale Figur in der Geschichte der Medizin. Seine Ideen und Entdeckungen, besonders im Bereich der Chemotherapie und Immunologie, haben die Behandlung von Infektionskrankheiten revolutioniert. Ehrlichs Arbeit legte den Grundstein für moderne Medikamente und Therapien, die heute Millionen von Menschenleben retten.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3d655444-fd55-42f7-aba2-16a16db7dc58"
