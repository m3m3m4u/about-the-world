      },
      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Konflikte mit Spanien</strong><br>\nAls überzeugter Feind Spaniens, der führenden Kolonialmacht seiner Zeit, unterstützte Raleigh Expeditionen, die spanische Siedlungen in der Neuen Welt angreifen sollten. Diese Aktivitäten führten zu Spannungen zwischen England und Spanien und trugen indirekt zur zunehmenden Feindseligkeit bei, die zum Krieg führte.</p>\n\n<p><strong>Dichtung und Schriftstellerei</strong><br>\nRaleigh war auch ein begabter Schriftsteller und Dichter. Seine Werke umfassen Gedichte sowie ein längeres poetisches Werk mit dem Titel \"The Ocean to Cynthia\". Seine Texte reflektieren oft seine politischen Ansichten und persönlichen Erlebnisse.</p>\n\n<p><strong>Tabak und Kartoffeln in England</strong><br>\nDurch seine Reisen brachte Raleigh Tabak und Kartoffeln nach England, was langfristige Auswirkungen auf die britische Gesellschaft und Kultur hatte. Obwohl er nicht der Erste war, der diese Produkte einführte, wird er oft mit ihrer Popularisierung in Verbindung gebracht.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
