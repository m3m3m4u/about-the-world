              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Sir Walter Raleigh (ca. 1552-1618) - Englischer Schriftsteller und Entdecker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
