                "defaultLanguage": "it"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Philosophische Ansichten</strong><br>\nNeben seiner Atomtheorie entwickelte Demokrit Theorien über Ethik, Mathematik und Kosmologie. Er glaubte, dass der höchste menschliche Zustand die Ataraxie, also die Seelenruhe, sei. Er argumentierte, dass Glück durch ein ausgewogenes Leben und die Vermeidung von Exzessen erreicht werden kann.</p>\n\n<p><strong>Einfluss auf andere Philosophen</strong><br>\nObwohl viele seiner Schriften verloren gegangen sind, hatte Demokrit einen erheblichen Einfluss auf andere Philosophen. Seine Arbeit wurde von späteren Denkern wie Epikur aufgegriffen und weiterentwickelt. Er hinterließ ein Erbe, das durch die Schriften anderer bewahrt wurde.</p>\n\n<p><strong>Die Natur der Realität</strong><br>\nDemokrit lehrte, dass die wahre Natur der Realität nur durch die Vernunft erschlossen werden kann und nicht durch die Sinne, die oft täuschen. Er war einer der ersten, der argumentierte, dass das, was wir wahrnehmen, nicht immer der Wirklichkeit entspricht.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "it"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
