      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Begegnung mit Fidel Castro</strong><br>\n1955 traf Che Guevara in Mexiko Fidel Castro. Castro plante die Befreiung Kubas von dem Diktator Fulgencio Batista. Che schloss sich Castros revolutionärer Bewegung an, weil er glaubte, dass dies der Weg sei, um die Unterdrückung in Lateinamerika zu bekämpfen und die Vision einer gerechteren Gesellschaft zu verwirklichen.</p>\n\n<p><strong>Die Kubanische Revolution</strong><br>\nGuevara spielte eine Schlüsselrolle in der Kubanischen Revolution, die 1959 zum Sturz Batistas führte. Che wurde als Arzt und Kämpfer bekannt, der oft an vorderster Front zu finden war. Sein Einsatz und seine Fähigkeit, sich unter extremen Bedingungen anzupassen, machten ihn zu einer Legende unter seinen Mitkämpfern.</p>\n\n<p><strong>Wirtschaftliche Reformen in Kuba</strong><br>\nNach dem Sieg der Revolution übernahm Che Guevara wichtige Ämter in der neuen kubanischen Regierung. Er setzte sich für tiefgreifende Wirtschaftsreformen ein, die den Grundbesitz umverteilten und Bildung sowie medizinische Versorgung für alle Kubaner zugänglich machten. Seine radikalen Methoden und seine strenge Disziplin waren jedoch umstritten.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
