              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Ingmar Bergman (1918-2007) - Filmregisseur</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
