            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life and Political Rise</strong><br>\nNicolas Sarkozy, born to an immigrant family in Paris, began his political career in the right-wing RPR party. He was known for his dynamic personality and sharp political instincts.</p>\n\n<p><strong>Interior Minister and Domestic Policies</strong><br>\nBefore becoming president, Sarkozy served as the interior minister, where he became popular for his tough stance on crime and immigration, which was a central part of his later presidency.</p>\n\n<p><strong>Presidency and Economic Reform</strong><br>\nSarkozy was elected president in 2007. His presidency focused on economic reform, including labor market modifications and pension system changes, which faced both praise and criticism.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
