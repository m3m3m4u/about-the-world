          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>International Relations and EU Leadership</strong><br>\nHe played a crucial role in managing the European financial crisis and held the EU presidency in 2008, advocating for stronger European integration and a collective response to global financial challenges.</p>\n\n<p><strong>Intervention in Libya</strong><br>\nSarkozy was instrumental in forming an international coalition that intervened in the Libyan civil war in 2011, leading to the overthrow of Muammar Gaddafi.</p>\n\n<p><strong>Personal Style and Public Image</strong><br>\nSarkozy's presidency was also noted for his personal style and the celebrity status of his marriage to Carla Bruni, which often attracted media attention.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
