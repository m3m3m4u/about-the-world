            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Stendhal's Early Life</strong><br>\nStendhal, born Marie-Henri Beyle in Grenoble, France, in 1783, developed a disdain for the provincial life and his family's bourgeois values. His early exposure to the turmoil of the French Revolution and subsequent military campaigns shaped his worldview.</p>\n\n<p><strong>Military and Diplomatic Service</strong><br>\nBefore becoming a known writer, Stendhal served in Napoleon's army and later held various diplomatic positions. His experiences across Europe influenced his understanding of social and political changes shaping the continent.</p>\n\n<p><strong>Pseudonym and Literary Work</strong><br>\nStendhal began his literary career under his famous pseudonym, which he adopted from the German city of Stendhal, reflecting his admiration for the German culture. His works were not immediately appreciated, and he often faced criticism for his style and themes.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
