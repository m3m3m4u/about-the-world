            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>\"The Red and the Black\"</strong><br>\nThe Red and the Black is Stendhal's most renowned novel, published in 1830. The book provides a critical look at French society in the 19th century, particularly the rigid social structures and the opportunities for individual ascension through the church or military.</p>\n\n<p><strong>Psychological Novel Approach</strong><br>\nStendhal is credited with pioneering the psychological novel, a narrative genre focusing on the complex emotional states of its characters. He explored the psyche of his characters through their interactions and societal positions.</p>\n\n<p><strong>Stendhal's Later Life</strong><br>\nDespite a prolific output, Stendhal's work received limited recognition during his lifetime. It was only in the late 19th and early 20th centuries that his literary significance was fully acknowledged.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
