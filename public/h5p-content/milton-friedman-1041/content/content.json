            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Legacy and Influence</strong><br>\nFriedman's legacy endures in his contribution to the concept of a \"natural rate of unemployment\" and his development of the \"permanent income\" theory of consumption.</p>\n\n<p><strong>Economic Policies and Critiques</strong><br>\nFriedman's monetarist approach to economic policy, which emphasizes the role of governments in controlling the amount of money in circulation, has been both influential and controversial.</p>\n\n<p><strong>Remembering Friedman</strong><br>\nAfter his death in 2006, Friedman left behind a vast body of work that continues to influence the debate over the balance between market forces and government intervention in the economy.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3d655444-fd55-42f7-aba2-16a16db7dc58"
