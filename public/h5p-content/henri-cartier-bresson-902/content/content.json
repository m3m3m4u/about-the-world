            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Founding of Magnum Photos</strong><br>\nAs a co-founder of Magnum Photos, Cartier-Bresson took part in one of the most important developments in professional photography, providing a platform for documentary photographers to publish their work independently.</p>\n\n<p><strong>Photojournalism and Documentary Work</strong><br>\nThroughout his career, Cartier-Bresson's photojournalistic work covered monumental events across the globe, including the Spanish Civil War, the liberation of Paris, the Chinese revolution, and Gandhi's funeral.</p>\n\n<p><strong>Approach to Street Photography</strong><br>\nCartier-Bresson's technique in street photography often involved immersing himself in the environment, capturing candid moments with a small, unobtrusive Leica camera. This stealthy method allowed him to preserve the natural unfolding of events.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
