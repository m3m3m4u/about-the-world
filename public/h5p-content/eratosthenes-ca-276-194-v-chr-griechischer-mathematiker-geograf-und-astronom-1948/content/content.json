              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Eratosthenes (ca. 276-194 v. Chr.) - griechischer Mathematiker, Geograf und Astronom</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Información y ejercicios</span></strong></p>\n"
              },
