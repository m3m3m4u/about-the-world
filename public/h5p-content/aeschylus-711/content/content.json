          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Aeschylus's Life</strong><br>\nAeschylus was born around 525 BC in the city of Eleusis, near Athens. He grew up during a time when the ancient Greek civilization was flourishing in art, thought, and democracy. He took part in the Battle of Marathon in 490 BC, where the Greeks defeated the invading Persian forces. This experience deeply influenced his work, as themes of war and heroism are prevalent in his plays.</p>\n\n<p><strong>The Father of Tragedy</strong><br>\nAeschylus is often called the \"Father of Tragedy.\" Before him, Greek plays consisted of a single actor and a chorus who narrated the story. Aeschylus added a second actor, allowing for dramatic dialogue and conflict. His changes increased the potential for dramatic situations and character development in Greek drama.</p>\n\n<p><strong>His Trilogies</strong><br>\nAeschylus's plays were often presented as trilogies, with each set of three plays telling a continuous story. One of the most famous trilogies is the Oresteia, which follows the tragic story of the House of Atreus. The trilogy explores themes of justice, vengeance, and the role of the gods in human affairs.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
