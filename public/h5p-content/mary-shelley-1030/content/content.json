            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Mary Shelley's Birth and Parentage</strong><br>\nMary Shelley was born Mary Wollstonecraft Godwin in 1797, daughter of the feminist philosopher Mary Wollstonecraft and the political philosopher William Godwin. Her mother died shortly after her birth, leaving her to be raised by her father and his second wife.</p>\n\n<p><strong>Early Education and Influences</strong><br>\nMary received an extensive education from her father, benefiting from his intellectual circle. This upbringing, amidst progressive ideas of the time, laid the groundwork for her own views on literature, society, and politics.</p>\n\n<p><strong>Relationship with Percy Bysshe Shelley</strong><br>\nAt the age of sixteen, Mary began a relationship with Percy Bysshe Shelley, who was married at the time. Their affair was scandalous and led to social ostracism, but the pair married after the suicide of Shelley's first wife.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
