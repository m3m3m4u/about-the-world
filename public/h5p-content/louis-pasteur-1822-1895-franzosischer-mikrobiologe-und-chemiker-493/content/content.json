              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Louis Pasteur (1822-1895) - Französischer Mikrobiologe und Chemiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
