              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Richard Dawkins (né en 1941) - Biologiste de l'évolution et auteur</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
