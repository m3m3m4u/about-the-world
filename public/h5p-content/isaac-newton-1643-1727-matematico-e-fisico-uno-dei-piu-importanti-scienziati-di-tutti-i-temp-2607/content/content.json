              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Isaac Newton (1643-1727) - matematico e fisico, uno dei più importanti scienziati di tutti i tempi</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
