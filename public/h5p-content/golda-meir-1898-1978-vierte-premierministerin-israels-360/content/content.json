      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Aufstieg zur Premierministerin</strong><br>\nGolda Meir wurde nach dem Rücktritt von Levi Eshkol im Jahr 1969 Premierministerin Israels. Als vierte Premierministerin ihres Landes übernahm sie das Amt in einer Zeit politischer Unsicherheit und wachsender Spannungen im Nahen Osten. Sie wurde schnell zu einer führenden Stimme in der Weltpolitik.</p>\n\n<p><strong>Herausforderungen während ihrer Amtszeit</strong><br>\nMeir stand vor vielen Herausforderungen als Premierministerin, einschließlich der steigenden Inflation und sozialer Unruhen. Doch ihre Amtszeit war vor allem durch den Jom-Kippur-Krieg von 1973 geprägt, einem Überraschungsangriff arabischer Staaten auf Israel während des höchsten jüdischen Feiertags.</p>\n\n<p><strong>Führung im Krieg</strong><br>\nWährend des Krieges zeigte Meir Führungsstärke und Entschlossenheit. Sie reiste in die Vereinigten Staaten, um Unterstützung zu mobilisieren, und spielte eine entscheidende Rolle bei der Sicherung militärischer Hilfe, was für Israel überlebenswichtig war. Ihre Führung im Krieg festigte ihren Ruf als starke Führungspersönlichkeit.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
