              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Thomas More (1478-1535) - Englischer Staatsmann und Autor</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
