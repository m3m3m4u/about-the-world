              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Jean Piaget (1896-1980) - Entwicklungspsychologe, bekannt für seine Theorie der kognitiven Entwicklung</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
