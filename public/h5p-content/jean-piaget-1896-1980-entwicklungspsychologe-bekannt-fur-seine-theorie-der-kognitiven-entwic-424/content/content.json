      },
      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Sensorisch-motorisches Stadium</strong><br>\nDas sensorisch-motorische Stadium umfasst die Zeit von der Geburt bis zum Alter von etwa zwei Jahren. In dieser Phase lernen Kinder durch ihre Sinne und Bewegungen. Piaget sah dies als Grundlage für die weitere Entwicklung an.</p>\n\n<p><strong>Präoperatives Stadium</strong><br>\nKinder zwischen zwei und sieben Jahren sind im präoperativen Stadium. Sie entwickeln Sprache und Fantasie, denken aber noch nicht logisch und können die Perspektive anderer nicht verstehen.</p>\n\n<p><strong>Konkret-operationales Stadium</strong><br>\nVom siebten bis zum elften Lebensjahr entwickeln Kinder die Fähigkeit zu logischem Denken über konkrete Objekte und Ereignisse. Sie verstehen nun Konzepte wie Kausalität und Mengenerhaltung.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
