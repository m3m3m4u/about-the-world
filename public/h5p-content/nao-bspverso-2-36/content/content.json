            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Local Leadership</strong><br>\nLocal leaders can play a pivotal role in promoting reconciliation and coexistence. Their support and engagement can help to reduce mistrust and guide communities on the path to reconciliation.</p>\n\n<p><strong>International Support</strong><br>\nInternational support can help strengthen coexistence initiatives and enhance their effectiveness. By providing resources and expertise, international partners can contribute to paving the way for reconciliation and lasting coexistence.</p>\n\n<p><strong>Long-term Perspectives</strong><br>\nFor long-term success, it is important that coexistence initiatives go beyond immediate reconciliation and focus on establishing enduring relationships and structures. This allows for ongoing positive interaction and collaboration, paving the way for a peaceful and prosperous shared future.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
