              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Marie Curie (1867-1934) - Physikerin und Chemikerin, zweifache Nobelpreisträgerin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
