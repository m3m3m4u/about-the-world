      },
      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Trajans Dakerkriege</strong><br>\nAls Kaiser führte Trajan zwei bedeutende Kriege gegen das Königreich Dazien, das heutige Rumänien. Der erste Krieg endete 102 n. Chr. mit einem römischen Sieg und großen territorialen Gewinnen. Der zweite Dakerkrieg von 105 bis 106 n. Chr. führte zur vollständigen Eroberung Daziens und zur Eingliederung in das Römische Reich.</p>\n\n<p><strong>Bauwerke unter Trajan</strong><br>\nTrajan ist auch bekannt für seine großen Bauprojekte in Rom und den Provinzen. Unter seiner Herrschaft wurde das Forum Traiani erbaut, ein großer öffentlicher Platz, der von der Trajanssäule gekrönt wird, die seine Siege in Dazien darstellt. Er ließ auch Straßen, Brücken und Aquädukte bauen, um das Reich zu verbessern.</p>\n\n<p><strong>Wirtschaftliche Reformen</strong><br>\nTrajan implementierte umfangreiche wirtschaftliche Reformen, die die Wirtschaft des Reiches stärkten. Dazu gehörten Maßnahmen zur Stabilisierung der Währung und zur Erweiterung des Handels. Er förderte auch soziale Wohlfahrtsprogramme, wie die Alimenta, die bedürftigen Kindern in Italien Nahrung und Bildung finanzierte.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
