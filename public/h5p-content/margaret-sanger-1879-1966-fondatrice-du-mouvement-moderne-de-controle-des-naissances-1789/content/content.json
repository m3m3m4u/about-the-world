              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Margaret Sanger (1879-1966) - Fondatrice du mouvement moderne de contrôle des naissances</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
