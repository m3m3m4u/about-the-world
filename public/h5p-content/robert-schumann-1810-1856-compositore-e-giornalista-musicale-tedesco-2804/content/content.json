              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Robert Schumann (1810-1856) - compositore e giornalista musicale tedesco</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
