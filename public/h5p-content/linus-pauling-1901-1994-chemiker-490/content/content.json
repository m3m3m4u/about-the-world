              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Linus Pauling (1901-1994) - Chemiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
