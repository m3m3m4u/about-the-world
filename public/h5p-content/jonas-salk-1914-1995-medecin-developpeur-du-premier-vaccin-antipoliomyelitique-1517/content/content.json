              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Jonas Salk (1914-1995) - Médecin, développeur du premier vaccin antipoliomyélitique</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
