              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Ernest Rutherford (1871-1937) - Neuseeländisch-britischer Physiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
