              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Robert Schumann (1810-1856) - Deutscher Komponist und Musikjournalist</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
