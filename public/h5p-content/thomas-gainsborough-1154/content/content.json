          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Thomas Gainsborough's Background</strong><br>\nThomas Gainsborough was born in 1727 in Sudbury, Suffolk, England. He displayed an early talent for drawing and painting, leading to his training in London and a successful career as a portrait and landscape painter.</p>\n\n<p><strong>Early Career and Marriage</strong><br>\nGainsborough started his career in London, establishing himself with portrait and landscape paintings. He married Margaret Burr, who brought a yearly income that afforded him the financial security to pursue his art.</p>\n\n<p><strong>Portraiture Success</strong><br>\nWhile living in the market town of Ipswich, Gainsborough built a strong reputation as a portraitist. His style offered a fresh approach, combining charm with a more relaxed and natural portrayal than was traditional at the time.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
        "slideBackgroundSelector": {}
      },
      {
        "elements": [
          {
            "x": 2.23463687150838,
