            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>INFORMATION TEXT (Part 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Landscape Painting and Experimentation</strong><br>\nDespite the demand for his portraits, Gainsborough maintained a passion for landscape painting. He often experimented with various techniques, including using a back-lit glass box to create detailed drawings of landscapes.</p>\n\n<p><strong>Move to Bath and Royal Patronage</strong><br>\nGainsborough moved to Bath in 1759, where his exposure to high society earned him commissions from wealthy patrons. His work eventually caught the attention of King George III, providing him with royal patronage.</p>\n\n<p><strong>The Blue Boy</strong><br>\nThe Blue Boy is one of Gainsborough's most famous works, believed to be a portrait of Jonathan Buttall, the son of a wealthy merchant. This painting is noted for its use of blue clothing, which showcases Gainsborough's skill with the color.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
