              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Hannibal Barca (247-183 v. Chr.) - Karthagischer Militärführer</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
