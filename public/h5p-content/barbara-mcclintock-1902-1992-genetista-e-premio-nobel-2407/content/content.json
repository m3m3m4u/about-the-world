              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Barbara McClintock (1902-1992) - genetista e premio Nobel</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
