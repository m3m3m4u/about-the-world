      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Caesars rechte Hand</strong><br>\nAls Caesar die Kontrolle über Rom erlangte, wurde Marc Anton zu einem seiner engsten Vertrauten ernannt. Er half bei der Verwaltung des Reiches und der Durchführung von Caesars Reformen. Nach Caesars Ermordung im Jahr 44 v. Chr. nutzte Marc Anton sein militärisches und politisches Geschick, um sich als einer der führenden Köpfe der caesarischen Partei zu etablieren.</p>\n\n<p><strong>Konflikt mit dem Senat</strong><br>\nNach dem Tod Caesars geriet Marc Anton schnell in Konflikt mit dem Senat und insbesondere mit Caesars Adoptivsohn Octavian, der später als Augustus bekannt wurde. Ihr Streit um die Macht führte schließlich zu einer Spaltung der römischen Elite und legte den Grundstein für einen weiteren Bürgerkrieg.</p>\n\n<p><strong>Triumvirat mit Octavian und Lepidus</strong><br>\nUm ihre gemeinsamen Feinde zu besiegen und die Kontrolle über das römische Reich zu sichern, bildeten Marc Anton, Octavian und Lepidus ein Triumvirat. Diese Dreimännerherrschaft regierte Rom mit harter Hand und führte eine Reihe von Proskriptionen durch, in denen viele Senatoren und vermögende Bürger ermordet und ihr Besitz beschlagnahmt wurde.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
