              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Jomo Kenyatta (ca. 1897-1978) - Premier président du Kenya</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
