              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Joseph Stalin (1878-1953) - Sowjetischer Führer</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
