          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Samuel Morse's Early Life</strong><br>\nSamuel Morse was born in 1791 in Charlestown, Massachusetts. Initially pursuing a career in art, he studied at Yale College where he was exposed to the study of electricity, fostering an interest that would later inspire his famous invention.</p>\n\n<p><strong>Transition from Painting to Invention</strong><br>\nMorse gained recognition as a portrait painter but his interest in invention prevailed. The death of his wife while he was away on a painting commission deeply affected him and highlighted the need for rapid communication, influencing his work on the telegraph.</p>\n\n<p><strong>Invention of the Telegraph</strong><br>\nIn 1837, Morse developed the first version of an electric telegraph. By 1844, he sent the message \"What hath God wrought\" from Washington to Baltimore, using the Morse code, signaling the birth of long-distance electric communication.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
