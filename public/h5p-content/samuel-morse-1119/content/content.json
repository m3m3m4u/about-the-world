          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Development of Morse Code</strong><br>\nMorse code, a system of dots and dashes representing letters and numbers, was developed by Morse and his assistant, Alfred Vail. This code became a universal language for communication over telegraph wires.</p>\n\n<p><strong>Struggles and Successes</strong><br>\nMorse faced challenges in gaining support and funding for his telegraph. He lobbied Congress for many years and, after much perseverance, received a grant to build the first telegraph line in the United States.</p>\n\n<p><strong>Global Impact of the Telegraph</strong><br>\nThe telegraph system revolutionized global communications. It was the first device to allow instant communication over vast distances, playing a crucial role in areas such as commerce, journalism, and military operations.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
