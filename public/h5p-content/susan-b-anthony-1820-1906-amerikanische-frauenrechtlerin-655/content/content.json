              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Susan B. Anthony (1820-1906) - Amerikanische Frauenrechtlerin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
