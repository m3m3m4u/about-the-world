            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Willard Libby's Early Life</strong><br>\nWillard Frank Libby was born on December 17, 1908, in Grand Valley, Colorado. Growing up, he developed an interest in science and went on to study at the University of California, Berkeley. There, he earned a Ph.D. in chemistry in 1933. His early work focused on radioactive elements, which became the foundation for his later achievements.</p>\n\n<p><strong>The Radiocarbon Dating Method</strong><br>\nIn the late 1940s, Libby developed radiocarbon dating, a method that uses the decay of carbon-14 to date organic materials. This revolutionary technique allowed scientists to determine the age of archaeological and geological samples, providing a tool to understand historical and environmental timelines.</p>\n\n<p><strong>Nobel Prize in Chemistry</strong><br>\nFor his development of the radiocarbon dating method, Libby was awarded the Nobel Prize in Chemistry in 1960. His work had provided a new perspective on the chronological aspects of archaeology, geology, geophysics, and other sciences, influencing these fields profoundly.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
