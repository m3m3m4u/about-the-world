          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Philosophy of the Absurd</strong><br>\nCamus developed the philosophy of the absurd, which posits that human beings live in a meaningless and irrational universe. His most famous work expressing this viewpoint is \"The Myth of Sisyphus.\"</p>\n\n<p><strong>Literary Works</strong><br>\nCamus's novels, including \"The Stranger,\" \"The Plague,\" and \"The Fall,\" express his philosophical ideas and have become classics of world literature, widely read and studied in schools and universities.</p>\n\n<p><strong>Nobel Prize in Literature</strong><br>\nIn 1957, Camus was awarded the Nobel Prize in Literature, not only for his rich and complex prose but also for his messages emphasizing the bright side of human nature against a backdrop of despair.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
