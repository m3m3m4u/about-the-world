          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nAlbert Camus was born on November 7, 1913, in Mondovi, Algeria, to a French-Algerian (Pied-Noir) family. His father died in World War I, and he was raised in poverty by his mother in the Belcourt section of Algiers.</p>\n\n<p><strong>Education and Early Writing</strong><br>\nCamus attended the University of Algiers, where he studied philosophy and played goalkeeper for the university's football team. Tuberculosis ended his football career, leading him to focus more on his studies and writing.</p>\n\n<p><strong>World War II and the Resistance</strong><br>\nDuring World War II, Camus joined the French Resistance and was editor-in-chief of the newspaper \"Combat.\" His writing during this time was fiercely critical of fascism and explored themes of resistance and human dignity.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
