          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nAnne Brontë was born on January 17, 1820, in Thornton, Yorkshire, the youngest of the six Brontë children. She was just a year old when the family moved to Haworth, where she would spend most of her life.</p>\n\n<p><strong>Education and Governess Work</strong><br>\nAnne was educated at home and at a school in Mirfield, before working as a governess. Her experiences in this role would later inform much of her writing, notably her first novel.</p>\n\n<p><strong>\"Agnes Grey\"</strong><br>\nAnne's debut novel, \"Agnes Grey,\" was published in 1847 under the pseudonym Acton Bell. The novel is based on her experiences as a governess and is acclaimed for its keen social commentary and sophisticated critique of the upper classes' treatment of women.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
