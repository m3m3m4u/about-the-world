              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Andrew Carnegie (1835-1919) - industriel et philanthrope américain</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
