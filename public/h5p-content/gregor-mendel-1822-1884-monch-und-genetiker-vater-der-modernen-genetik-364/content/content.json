      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 1)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "5627dc6e-c943-439e-ab4a-4531b7f24264"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Frühes Leben von Gregor Mendel</strong><br>\nGregor Mendel wurde 1822 in Heinzendorf, Österreich, geboren. Er wuchs in einer bäuerlichen Familie auf und hatte schon früh Interesse an Pflanzen und der Natur. Mendel trat mit 21 Jahren in das Augustinerkloster in Brünn ein. Hier erhielt er den Namen Gregor und begann seine wissenschaftliche Forschung.</p>\n\n<p><strong>Ausbildung und Lehrerberuf</strong><br>\nIm Kloster konnte Mendel studieren und lehrte später als Lehrer für Physik und Naturkunde an der Oberschule. Trotz seines Interesses und seiner Fähigkeiten in den Naturwissenschaften bestand Mendel die Lehramtsprüfung nicht. Sein Misserfolg war vermutlich auf Prüfungsangst zurückzuführen, doch er gab seine wissenschaftlichen Studien nicht auf.</p>\n\n<p><strong>Die Wahl der Erbsen</strong><br>\nMendel entschied sich für die Durchführung von Experimenten mit Erbsenpflanzen, weil sie verschiedene Merkmale aufwiesen, die leicht zu identifizieren waren. Erbsen waren auch deshalb ideal, weil sie sowohl selbstbestäubend als auch fremdbestäubend sein können, was ihm erlaubte, Kreuzungen gezielt zu kontrollieren.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
