          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>The New Deal</strong><br>\nThe New Deal was a series of programs and reforms designed to revive the economy and help Americans affected by the depression. It included the Social Security Act and the formation of the Works Progress Administration.</p>\n\n<p><strong>Leadership During World War II</strong><br>\nRoosevelt led the United States through the majority of World War II, building the Allied Powers and establishing strategies for a post-war world.</p>\n\n<p><strong>Four Terms in Office</strong><br>\nHe was the only U.S. president to be elected to four terms, serving from 1933 to his death in 1945, reflecting the trust Americans placed in his leadership.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
