            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Impact of His Policies</strong><br>\nRoosevelt's policies reshaped American government's role in the economy and society, expanding its involvement in the welfare of its citizens.</p>\n\n<p><strong>Health and Death in Office</strong><br>\nRoosevelt's health declined while in office, and he died on April 12, 1945, shortly into his fourth term. His death marked the end of an era in American politics.</p>\n\n<p><strong>Legacy</strong><br>\nRoosevelt's legacy includes his leadership during the Depression and the war, as well as the lasting impact of his domestic policies on American life.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
