          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life and Career</strong><br>\nFranklin D. Roosevelt was born on January 30, 1882, in Hyde Park, New York. He began his career in public service through politics in the New York State Senate.</p>\n\n<p><strong>Polio and Overcoming Disability</strong><br>\nIn 1921, Roosevelt was diagnosed with polio, which left him paralyzed from the waist down. He overcame his disability to return to public life, which inspired many Americans.</p>\n\n<p><strong>Election as President</strong><br>\nRoosevelt was elected as the 32nd President of the United States in 1932 during the Great Depression. He promised a \"New Deal\" to bring economic relief and recovery.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
        "slideBackgroundSelector": {}
      },
      {
        "elements": [
          {
            "x": 2.23463687150838,
