              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>James Watson (né en 1928) - généticien</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
              "metadata": {
