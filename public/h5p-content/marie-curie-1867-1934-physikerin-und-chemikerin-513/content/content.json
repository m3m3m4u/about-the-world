      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 3)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "4381b60d-c67f-4722-b83d-b17f2fc9d01c"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Nobelpreis für Chemie</strong><br>\nIm Jahr 1911 erhielt Marie Curie ihren zweiten Nobelpreis, diesmal in Chemie, für ihre Dienste zur Förderung der Chemie durch die Entdeckung der Elemente Radium und Polonium. Sie wurde dadurch zur ersten Person, die in zwei verschiedenen wissenschaftlichen Disziplinen Nobelpreise gewann, und festigte ihren Ruf als eine der führenden Wissenschaftlerinnen ihrer Zeit.</p>\n\n<p><strong>Einsatz im Ersten Weltkrieg</strong><br>\nWährend des Ersten Weltkriegs nutzte Marie ihre Kenntnisse in der Radiologie und entwickelte mobile Röntgengeräte für den Einsatz an der Front. Diese \"kleinen Curies\" spielten eine entscheidende Rolle bei der Behandlung verletzter Soldaten. Ihre Arbeit trug dazu bei, die Anwendung der Radiologie in der Medizin zu revolutionieren.</p>\n\n<p><strong>Vermächtnis und Tod</strong><br>\nMarie Curie starb 1934 an den Folgen langjähriger Strahlenexposition, die durch ihre wissenschaftliche Arbeit bedingt war. Ihr Vermächtnis umfasst nicht nur ihre wissenschaftlichen Errungenschaften, sondern auch ihre Rolle als Pionierin für die Rechte von Frauen in der Wissenschaft. Ihre unermüdliche Forschung und ihr Engagement für das Lernen inspirieren noch heute Schüler und Wissenschaftler weltweit.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
