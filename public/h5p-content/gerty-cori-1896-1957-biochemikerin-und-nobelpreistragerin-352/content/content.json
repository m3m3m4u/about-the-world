              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Gerty Cori (1896-1957) - Biochemikerin und Nobelpreisträgerin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
