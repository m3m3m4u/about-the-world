              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Boethius (ca. 477-524 n. Chr.) - Römischer Philosoph und Staatsmann</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
