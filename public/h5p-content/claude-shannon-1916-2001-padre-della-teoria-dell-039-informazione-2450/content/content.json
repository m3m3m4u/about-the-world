              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Claude Shannon (1916-2001) - Padre della teoria dell'informazione</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
