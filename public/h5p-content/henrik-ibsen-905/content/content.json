          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nHenrik Ibsen was born on March 20, 1828, in Skien, Norway, and his family faced financial hardship when he was young. This influenced his later work, which often explored the pressures of society's expectations and personal agony.</p>\n\n<p><strong>Career Beginnings</strong><br>\nIbsen began his career as a playwright and director at the Norwegian Theatre in Bergen. It was during this time that he developed his craft, writing historical dramas, comedies, and poetry.</p>\n\n<p><strong>\"A Doll's House\"</strong><br>\nIn 1879, Ibsen created \"A Doll's House,\" a play that shocked audiences with its critique of 19th-century marriage norms and its female protagonist's radical choice to leave her husband and children in pursuit of self-discovery.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
