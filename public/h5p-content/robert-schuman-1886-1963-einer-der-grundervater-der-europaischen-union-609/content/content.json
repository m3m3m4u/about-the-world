              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Robert Schuman (1886-1963) - Einer der Gründerväter der Europäischen Union</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
