              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Peter Higgs (né en 1929) - physicien</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
