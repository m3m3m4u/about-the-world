          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of Simone Veil</strong><br>\nSimone Veil was born on July 13, 1927, in Nice, France. She was raised in a secular Jewish family with a strong emphasis on education and cultural enrichment. As a young girl, Simone enjoyed studying and excelled in her classes, demonstrating early on her keen intelligence and determination.</p>\n\n<p><strong>World War II and the Holocaust</strong><br>\nDuring World War II, when Simone was just a teenager, her life was turned upside down. She, along with members of her family, was arrested by the German authorities. Simone was deported to Auschwitz, the Nazi death camp, where she endured the horrors of the Holocaust.</p>\n\n<p><strong>After the War</strong><br>\nSurviving the Holocaust, Simone returned to France, where she studied law and political science. She became a magistrate, which set the stage for her later political career. Her experiences during the war profoundly influenced her beliefs and commitment to social justice.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
