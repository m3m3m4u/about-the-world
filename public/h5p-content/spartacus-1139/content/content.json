            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Spartacus Early Life</strong><br>\nSpartacus was believed to be born around 111 BCE in Thrace, an area now divided among Bulgaria, Greece, and Turkey. As a young man, he may have served as a soldier before being captured and sold into slavery. He was trained at a gladiatorial school in Capua, Italy, where he learned the skills that he would later use to lead a major slave uprising against the Roman Republic.</p>\n\n<p><strong>Enslavement and Gladiator</strong><br>\nSpartacus's life as a gladiator began after his capture and enslavement by Roman forces. The gladiator schools in ancient Rome were brutal places where slaves were forced to fight to the death for public entertainment. Spartacus's training as a gladiator was both a means of control and a method to refine his fighting abilities, which contributed to his formidable reputation.</p>\n\n<p><strong>The Great Escape</strong><br>\nIn 73 BCE, Spartacus escaped from the gladiatorial school with about 70 other slaves, seizing kitchen implements as weapons. This event sparked the beginning of the slave revolt. They made their way to Mount Vesuvius, where they set up a defensible camp and began to raid local countryside for supplies and to free other slaves to join their cause.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
