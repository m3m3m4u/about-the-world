      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Militärische Erfolge</strong><br>\nIn seinem Konsulatsjahr 195 v. Chr. führte Cato erfolgreiche militärische Kampagnen in Spanien. Diese Erfolge stärkten Roms Macht und Einfluss und zeigten Catos Fähigkeiten als Militärführer. Nach seiner Rückkehr nach Rom arbeitete er daran, die römische Gesellschaft durch Gesetze und moralische Vorschriften zu stärken.</p>\n\n<p><strong>Catos Landwirtschaftliche Reformen</strong><br>\nCato schrieb über Landwirtschaft und persönliche Wirtschaftsführung und gab den Römern praktische Ratschläge zur Bewirtschaftung ihrer Güter. Sein bekanntestes Werk, \"De Agricultura\", ist eine reiche Quelle für das Verständnis der römischen Landwirtschaft und der sozialen Verhältnisse.</p>\n\n<p><strong>Gesetzgeber und Moralist</strong><br>\nNeben seiner Arbeit in der Landwirtschaft war Cato auch als Gesetzgeber aktiv. Er setzte sich für die Lex Oppia ein, ein Gesetz, das den Luxus einschränkte, und versuchte damit, die moralischen Standards von Rom zu erhöhen. Cato war bekannt für seine harschen Ansichten über Luxus und Dekadenz.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
