              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Eli Whitney (1765-1825) - Inventeur américain</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
