                "text": "<p><span style=\"font-size:3em;\"><strong>Saffo (ca. 630-570 a.C.) - poetessa greca</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
