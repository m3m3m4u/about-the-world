              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Johannes Vermeer (1632-1675) - Niederländischer Maler</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
