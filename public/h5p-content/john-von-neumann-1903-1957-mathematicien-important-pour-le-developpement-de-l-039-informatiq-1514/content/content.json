              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>John von Neumann (1903-1957) - Mathématicien, important pour le développement de l'informatique</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
