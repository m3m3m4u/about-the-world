              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Heraklit (ca. 535-475 v. Chr.) - Griechischer Philosoph</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
