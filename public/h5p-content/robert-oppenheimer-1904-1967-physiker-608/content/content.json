              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Robert Oppenheimer (1904-1967) - Physiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
