      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Rückkehr nach Norwegen</strong><br>\nIm Jahr 1866 kehrte Grieg nach Norwegen zurück und ließ sich in Christiania, dem heutigen Oslo, nieder. Er wurde schnell zu einer führenden Figur in der norwegischen Musikszene. Grieg setzte sich leidenschaftlich für die Entwicklung einer eigenständigen norwegischen Musik ein und war einer der ersten, der Folkloremelodien und -rhythmen in die klassische Musik einband.</p>\n\n<p><strong>Bedeutende Werke</strong><br>\nEines von Griegs bekanntesten Werken ist die \"Peer Gynt\"-Suite, die er als Begleitmusik zu Henrik Ibsens gleichnamigem Theaterstück schrieb. Die Stücke \"Morgenstimmung\" und \"In der Halle des Bergkönigs\" sind besonders berühmt. Griegs Musik zeichnet sich durch ihre lyrische Schönheit und ihre Anlehnung an die norwegische Volksmusik aus.</p>\n\n<p><strong>Persönliches Leben</strong><br>\nGrieg heiratete seine Cousine Nina Hagerup im Jahr 1867, die eine talentierte Sängerin war. Die beiden hatten oft zusammen gearbeitet, und Nina inspirierte viele seiner Lieder. Ihr gemeinsames Leben war von Musik erfüllt, doch erlebten sie auch persönliches Leid, da ihre einzige Tochter im jungen Alter starb.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
