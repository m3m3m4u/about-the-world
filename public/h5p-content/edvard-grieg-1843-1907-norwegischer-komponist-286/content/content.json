              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Edvard Grieg (1843-1907) - Norwegischer Komponist</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
