          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life and Education</strong><br>\nThomas Edison was born in 1847 in Milan, Ohio. Largely self-educated, he developed a voracious appetite for knowledge, which spurred his interest in experimentation and invention from a young age.</p>\n\n<p><strong>The Invention of the Phonograph</strong><br>\nEdison's invention of the phonograph in 1877 was groundbreaking, as it was the first device to both record and reproduce sound, revolutionizing music consumption and communication technology.</p>\n\n<p><strong>Development of the Light Bulb</strong><br>\nAlthough he did not invent the first electric light bulb, Edison improved upon the existing technology to create a longer-lasting bulb, which made electric lighting practical for everyday use.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
