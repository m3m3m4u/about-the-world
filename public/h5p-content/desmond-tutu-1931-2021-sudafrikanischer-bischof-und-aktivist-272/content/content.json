              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Desmond Tutu (1931-2021) - Südafrikanischer Bischof und Aktivist</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
