              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Nelson Mandela (1918-2013) - Südafrikanischer Anti-Apartheid-Revolutionär und Präsident</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
