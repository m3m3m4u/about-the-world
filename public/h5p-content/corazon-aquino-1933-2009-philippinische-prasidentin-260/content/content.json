              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Corazon Aquino (1933-2009) - Philippinische Präsidentin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
