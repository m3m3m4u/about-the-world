              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Diana, princesse de Galles (1961-1997) - Membre de la famille royale britannique</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
