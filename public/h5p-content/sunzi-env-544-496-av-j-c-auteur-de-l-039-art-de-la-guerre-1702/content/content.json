              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Sunzi (env. 544-496 av. J.-C.) - auteur de L'art de la guerre.</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
              "metadata": {
