              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Willy Brandt (1913-1992) - Deutscher Bundeskanzler</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
