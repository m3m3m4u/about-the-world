          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Anti-Imperialism</strong><br>\nCarnegie was a prominent anti-imperialist and opposed the annexation of the Philippines, arguing that American control of another nation contradicted the nation’s foundational values of freedom and self-determination.</p>\n\n<p><strong>Personal Life and Death</strong><br>\nCarnegie married late in life and had one child. He spent his final years as a philanthropist before dying in 1919, leaving a legacy as a self-made man who reshaped the philanthropic landscape.</p>\n\n<p><strong>Enduring Legacy</strong><br>\nCarnegie's philanthropic legacy persisted through institutions bearing his name, including Carnegie Mellon University and the Carnegie Trusts in the UK, reshaping education and public works globally.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3d655444-fd55-42f7-aba2-16a16db7dc58"
