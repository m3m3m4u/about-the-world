                "text": "<p><span style=\"font-size:3em;\"><strong>Eli Whitney (1765-1825) - Inventor estadounidense</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Información y ejercicios</span></strong></p>\n"
              },
