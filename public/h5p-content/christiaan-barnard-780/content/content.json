          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of Christiaan Barnard</strong><br>\nChristiaan Barnard was born in South Africa in 1922. He grew up in a modest family, with his father as a minister in the Dutch Reformed Church. Barnard's humble beginnings did not hinder his pursuit of education, and he eventually studied medicine at the University of Cape Town.</p>\n\n<p><strong>Medical Education and Training</strong><br>\nAfter completing his medical degree, Barnard worked in his home country and later in the United States to gain surgical experience. He specialized in cardiothoracic surgery, the field in which he would make his most significant mark.</p>\n\n<p><strong>Pioneering Heart Surgery</strong><br>\nBarnard achieved global fame when he performed the world's first successful human-to-human heart transplant in 1967. The groundbreaking operation took place at Groote Schuur Hospital in Cape Town and marked a new era in medical science.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
