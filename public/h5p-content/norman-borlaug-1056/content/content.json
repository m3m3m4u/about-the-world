          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Education and Early Work</strong><br>\nNorman Ernest Borlaug was born on March 25, 1914, in Cresco, Iowa. He studied forestry and plant pathology, obtaining his PhD in plant pathology from the University of Minnesota, which set the foundation for his future work in agricultural science.</p>\n\n<p><strong>Development of High-Yield Wheat Varieties</strong><br>\nBorlaug's research in Mexico led to the development of high-yield, disease-resistant wheat varieties. His work significantly improved wheat production practices in Mexico and later in other countries.</p>\n\n<p><strong>Contributions to the Green Revolution</strong><br>\nBorlaug's innovations in wheat breeding contributed to the Green Revolution, which increased agricultural production worldwide, particularly in developing countries, saving millions from starvation.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
        "slideBackgroundSelector": {}
      },
      {
        "elements": [
          {
