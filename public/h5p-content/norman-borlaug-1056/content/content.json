          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Nobel Peace Prize</strong><br>\nIn 1970, Borlaug was awarded the Nobel Peace Prize for his contributions to increasing food supply and advancing peace through agricultural productivity.</p>\n\n<p><strong>Global Impact on Food Security</strong><br>\nHis efforts to spread high-yield crops and modern agricultural techniques transformed the prospects of food production, thereby influencing global food security and famine prevention.</p>\n\n<p><strong>Continuing Work in Global Agriculture</strong><br>\nBorlaug continued his work to end hunger and poverty by championing agricultural development and teaching new generations of scientists to carry on this mission.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
