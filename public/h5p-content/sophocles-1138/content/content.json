          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of Sophocles</strong><br>\nSophocles was born around 496 BCE in Colonus, which is now part of Athens, Greece. He was the son of a wealthy weapons manufacturer, which allowed him to receive a good education. Sophocles was well-trained in the arts and athletics. As a young man, he was chosen to lead a choir of boys at a festival celebrating the Greek victory over the Persians at Salamis.</p>\n\n<p><strong>Contributions to Greek Drama</strong><br>\nSophocles made significant contributions to the art of drama. He added a third actor to the plays, which greatly increased the complexity and dramatic possibilities of the performance. His work often explored the interplay between fate and personal actions. Sophocles is credited with over 120 plays, though only a fraction of these have survived.</p>\n\n<p><strong>Innovations in Stagecraft</strong><br>\nIn addition to adding a third actor, Sophocles introduced scenic painting, providing a more realistic and detailed backdrop for his plays. This innovation enhanced the visual appeal and made the storytelling more engaging for the audience. He was known for his use of the chorus, making them a more integral part of the story rather than just commentators on the action.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
