              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Salvador Dalí (1904-1989) - Künstler</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
