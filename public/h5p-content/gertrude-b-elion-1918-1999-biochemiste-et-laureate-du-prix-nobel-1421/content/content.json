              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Gertrude B. Elion (1918-1999) - Biochemiste et lauréate du prix Nobel</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
