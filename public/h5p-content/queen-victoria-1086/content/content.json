          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Widowhood and Mourning</strong><br>\nPrince Albert's death in 1861 devastated Victoria, who mourned her husband for the rest of her life and wore black for decades, earning her the nickname \"the Widow of Windsor.\"</p>\n\n<p><strong>Influence and Power</strong><br>\nHer reign, known as the Victorian era, was a period of industrial, cultural, political, scientific, and military progress within the United Kingdom.</p>\n\n<p><strong>Constitutional Changes</strong><br>\nUnder Victoria's rule, the role of the monarchy became more symbolic with the expansion of the British democratic system, which limited the powers traditionally held by the sovereign.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
