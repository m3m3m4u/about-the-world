              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Aspasia von Milet (ca. 470-400 v. Chr.) - Partnerin von Perikles</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
