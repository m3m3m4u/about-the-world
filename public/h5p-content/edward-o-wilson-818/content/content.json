          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life and Education</strong><br>\nEdward Osborne Wilson was born on June 10, 1929, in Birmingham, Alabama. He became interested in the natural world very early in his life. Despite a fishing accident that impaired his vision, Wilson's fascination with nature only grew, leading him to study biology and earn a PhD from Harvard University.</p>\n\n<p><strong>Contributions to Biology</strong><br>\nWilson was known for his work in myrmecology, the study of ants. He discovered hundreds of new ant species and developed theories about their social behavior and communication. His research extended to the broader field of biodiversity and conservation efforts.</p>\n\n<p><strong>The Theory of Island Biogeography</strong><br>\nTogether with Robert MacArthur, Wilson proposed the Theory of Island Biogeography. This theory explains how species and habitats are distributed and has been influential in the study of ecology and conservation planning.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
