          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Overseas Diplomacy</strong><br>\nDuring the Revolutionary War, Adams served as a diplomat in Europe. He worked in France and Holland to secure military and financial support for the American cause. Adams' diplomatic efforts were vital to the eventual success of the war effort.</p>\n\n<p><strong>Vice Presidency</strong><br>\nAfter the war, John Adams continued to serve his country, becoming the first Vice President of the United States in 1789. He served two terms under President George Washington, while the new nation found its footing.</p>\n\n<p><strong>Presidency</strong><br>\nIn 1797, Adams became the second President of the United States. His presidency was marked by challenges, including tensions with France, which led to the Quasi-War. Adams' leadership during this time helped prevent a full-scale war with France.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
