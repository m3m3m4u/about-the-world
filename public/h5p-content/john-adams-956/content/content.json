          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of John Adams</strong><br>\nJohn Adams was born on October 30, 1735, in Braintree, Massachusetts. He grew up during the colonial period when America was still under British rule. Adams was educated at Harvard College, where he studied law. After graduation, he quickly became known as a respected lawyer in Boston.</p>\n\n<p><strong>Political Career Beginnings</strong><br>\nJohn Adams' political career began in the 1760s when he became a critic of Britain's colonial policies. His opposition to the Stamp Act of 1765, which taxed the colonies, established him as a significant voice in the movement towards American independence.</p>\n\n<p><strong>Role in American Independence</strong><br>\nAdams played a crucial role in the push for American independence. He was a delegate to the First and Second Continental Congresses, where he worked tirelessly for the cause. Adams also helped draft the Declaration of Independence in 1776, advocating for the break from Britain.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
