              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Alan Turing (1912-1954) - Mathematiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
