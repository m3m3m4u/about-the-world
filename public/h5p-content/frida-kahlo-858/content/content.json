          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Cultural Identity and Political Activism</strong><br>\nKahlo's work is infused with symbolism drawn from Mexican popular culture and reflects her strong political beliefs, including her commitment to Mexicanidad, a cultural movement that asserted the value of indigenous Mexican culture after the Mexican Revolution.</p>\n\n<p><strong>Physical Suffering and Medical Challenges</strong><br>\nKahlo's art often conveys her physical suffering, stemming from her bus accident injuries and subsequent medical procedures. She underwent numerous surgeries throughout her life, which she documented in her paintings.</p>\n\n<p><strong>International Recognition and Exhibitions</strong><br>\nKahlo's work gained international attention in the 1930s and 1940s, especially in Paris, where she was included in exhibitions that led to purchases by prominent figures like the Louvre. However, her work did not achieve widespread acclaim until decades later.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
