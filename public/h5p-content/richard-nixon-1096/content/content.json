          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Domestic Achievements</strong><br>\nNixon's presidency saw the establishment of the Environmental Protection Agency (EPA) and the passage of significant environmental legislation, including the Clean Air Act.</p>\n\n<p><strong>Foreign Affairs</strong><br>\nHe achieved notable foreign policy successes, such as détente with the Soviet Union and the opening of diplomatic relations with the People's Republic of China.</p>\n\n<p><strong>Vietnam War</strong><br>\nNixon sought to end U.S. involvement in Vietnam, implementing a policy of \"Vietnamization\" and eventually withdrawing American troops while seeking to maintain South Vietnamese independence.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
