              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Charles Darwin (1809-1882) - scienziato naturale, noto per la teoria dell'evoluzione</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
