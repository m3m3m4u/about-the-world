          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nElizabeth Cady Stanton was born on November 12, 1815, in Johnstown, New York. She received a formal education at the Johnstown Academy and Emma Willard's Troy Female Seminary. Her exposure to gender discrimination at a young age influenced her activism.</p>\n\n<p><strong>Marriage and Family</strong><br>\nStanton married abolitionist Henry Brewster Stanton in 1840. Despite her husband's progressive views, Elizabeth continued to experience the restrictions of a woman's role in society, which motivated her to challenge these norms.</p>\n\n<p><strong>The Seneca Falls Convention</strong><br>\nIn 1848, Stanton helped organize the Seneca Falls Convention, the first women's rights convention. She presented the Declaration of Sentiments, which called for legal and social equality, including the right to vote for women.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
        "slideBackgroundSelector": {}
      },
      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>INFORMATION TEXT (Part 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
