          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Years and Education</strong><br>\nRichard Phillips Feynman was born in Queens, New York, on May 11, 1918. His early demonstration of advanced mathematical abilities led him to study at the Massachusetts Institute of Technology and later at Princeton University for his PhD.</p>\n\n<p><strong>Manhattan Project and Early Career</strong><br>\nDuring World War II, Feynman was recruited to the Manhattan Project at Los Alamos National Laboratory. His work on atomic bomb development marked the beginning of his notable career in physics.</p>\n\n<p><strong>Quantum Electrodynamics and Nobel Prize</strong><br>\nFeynman made significant contributions to the field of quantum electrodynamics, developing a pictorial representation of particle interactions known as Feynman diagrams. This work earned him a Nobel Prize in Physics in 1965.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
