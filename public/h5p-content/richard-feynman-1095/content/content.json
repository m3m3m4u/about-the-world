          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Teaching and Legacy in Education</strong><br>\nAs a professor at the California Institute of Technology, Feynman became renowned for his teaching, emphasizing problem-solving and understanding over memorization. His \"Feynman Lectures on Physics\" remain influential in physics education.</p>\n\n<p><strong>Work on the Challenger Disaster</strong><br>\nIn 1986, Feynman played a key role in the investigation of the Space Shuttle Challenger disaster. His demonstration of the O-ring material's failure in cold conditions was a pivotal moment in the inquiry.</p>\n\n<p><strong>Publications and Popular Science</strong><br>\nFeynman wrote extensively, not just on scientific topics but also about his own life and experiences. His books have inspired many to appreciate the beauty and complexity of the physical world.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
