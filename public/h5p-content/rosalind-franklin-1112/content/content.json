          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Research on Viruses</strong><br>\nAfter her work on DNA, Franklin led pioneering studies on the tobacco mosaic virus and the polio virus at Birkbeck College, London. Her work laid the foundation for structural virology.</p>\n\n<p><strong>Challenges and Recognition</strong><br>\nFranklin faced gender-based discrimination in her career, which was common for women in science at the time. Despite this, she made remarkable contributions to our understanding of molecular structures.</p>\n\n<p><strong>Influence on Scientific Discovery</strong><br>\nFranklin's work influenced the field of genetics and beyond, although her contributions to the discovery of DNA's structure were not fully recognized during her lifetime. Her research has had a lasting impact on science.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
