          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life and Education</strong><br>\nRosalind Elsie Franklin was born on July 25, 1920, in London, England. She excelled in science from a young age and went on to study chemistry at Newnham College, Cambridge. After earning her degree, she began her research career in physical chemistry.</p>\n\n<p><strong>X-ray Crystallography Work</strong><br>\nFranklin was skilled in X-ray crystallography, a technique used to determine the three-dimensional structures of crystals. At King's College London, she used this method to take images of DNA, leading to the discovery of its double helix structure.</p>\n\n<p><strong>Discovery of the DNA Structure</strong><br>\nFranklin's photograph, known as Photo 51, was critical in revealing the detailed structure of DNA. Her precise measurements and photographs provided the evidence needed to confirm the helical structure of DNA.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
