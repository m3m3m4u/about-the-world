            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of Nathaniel Hawthorne</strong><br>\nNathaniel Hawthorne was born in Salem, Massachusetts, in 1804. His ancestry included a judge responsible for the Salem witch trials, an event that later influenced his writing. He graduated from Bowdoin College in Maine in 1825.</p>\n\n<p><strong>Literary Style and Themes</strong><br>\nHawthorne is known for his dark romanticism. His works often explore themes of sin, guilt, and retribution, reflecting the Puritan setting of New England. His novels and short stories are noted for their moral complexity and psychological depth.</p>\n\n<p><strong>\"The Scarlet Letter\"</strong><br>\nIn 1850, Hawthorne published \"The Scarlet Letter,\" now considered his masterpiece. The novel examines the life of Hester Prynne, a woman punished for adultery, delving into the themes of legality, sin, and redemption.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
