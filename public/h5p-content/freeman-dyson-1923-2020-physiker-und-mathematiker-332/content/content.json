              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Freeman Dyson (1923-2020) - Physiker und Mathematiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
