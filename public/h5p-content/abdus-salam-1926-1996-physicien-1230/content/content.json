              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Abdus Salam (1926-1996) - physicien</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
              "metadata": {
