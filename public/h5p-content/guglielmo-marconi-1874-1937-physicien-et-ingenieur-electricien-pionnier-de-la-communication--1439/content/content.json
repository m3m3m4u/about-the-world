              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Guglielmo Marconi (1874-1937) - Physicien et ingénieur électricien, pionnier de la communication sans fil</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
