      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Europäische Reisen</strong><br>\nAls junger Mann unternahm Mendelssohn ausgedehnte Reisen durch Europa, die seine Kompositionen stark beeinflussten. Er besuchte England, Schottland und Italien, und diese Länder hinterließen Spuren in seiner Musik. Die \"Schottische\" und die \"Italienische\" Symphonie sind Beispiele für Werke, die von seinen Reiseerfahrungen inspiriert wurden.</p>\n\n<p><strong>Musikalische Vielfalt</strong><br>\nMendelssohn war nicht nur als Komponist tätig, sondern auch als Dirigent und Pianist. Er war vielseitig und beherrschte eine breite Palette von Musikstilen. Zu seinen bekanntesten Werken gehören seine Lieder ohne Worte, die bis heute beliebt sind. Sie zeigen seine Fähigkeit, emotionale Tiefe ohne textliche Unterstützung zu vermitteln.</p>\n\n<p><strong>Mendelssohn und die Romantik</strong><br>\nAls Vertreter der Romantik verband Mendelssohn die Gefühle und Ideen dieser Epoche mit klar strukturierten Formen. Seine Musik war von großer Emotionalität, aber auch von einer meisterhaften Beherrschung der musikalischen Technik gekennzeichnet. Er fand eine Balance zwischen Leidenschaft und Präzision.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
