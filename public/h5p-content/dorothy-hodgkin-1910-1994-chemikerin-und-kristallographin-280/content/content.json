              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Dorothy Hodgkin (1910-1994) - Chemikerin und Kristallographin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
