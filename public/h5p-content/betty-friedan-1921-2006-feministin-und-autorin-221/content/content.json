              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Betty Friedan (1921-2006) - Feministin und Autorin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
