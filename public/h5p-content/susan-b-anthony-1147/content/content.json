          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Relationship with Elizabeth Cady Stanton</strong><br>\nAnthony formed a vital partnership with Elizabeth Cady Stanton, and together they founded the National Woman Suffrage Association in 1869. They were a formidable duo, with Stanton providing the eloquent writings and Anthony excelling in strategy and management.</p>\n\n<p><strong>The Revolution Newspaper</strong><br>\nIn 1868, Anthony and Stanton began publishing a weekly newspaper called \"The Revolution,\" which provided a platform for them to voice their ideas on women's rights, anti-slavery, and other issues of equality.</p>\n\n<p><strong>Lecturing and Advocacy</strong><br>\nAnthony traveled extensively, giving speeches and organizing events to promote the cause of women's suffrage. She faced hostile audiences and personal threats but remained undeterred in advocating for social reforms.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
