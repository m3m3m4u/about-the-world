              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Maximilien Robespierre (1758-1794) - Französischer Revolutionär</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
