          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life and Accession</strong><br>\nFranz Joseph I was born on August 18, 1830, in Vienna, Austria. He ascended to the throne in 1848 after the abdication of his uncle, Emperor Ferdinand I, during the revolutionary waves in Europe.</p>\n\n<p><strong>Consolidation of Power</strong><br>\nUpon his accession, Franz Joseph worked to consolidate his power by establishing a centralized administration in the Austrian Empire and strengthening the army and bureaucracy.</p>\n\n<p><strong>Austro-Hungarian Compromise</strong><br>\nThe year 1867 marked the establishment of the Austro-Hungarian Empire through the Compromise (Ausgleich), which created a dual monarchy and granted Hungary equal status with Austria.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
