              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Yasser Arafat (1929-2004) - Palästinensischer politischer Führer</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
