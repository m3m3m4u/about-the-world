              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Robert Capa (1913-1954) - Fotograf</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
