              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Paul Dirac (1902-1984) - Physicien britannique</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
