          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Health Care Reform Attempts</strong><br>\nClinton's early presidency focused on health care reform, although his proposed plan, led by First Lady Hillary Clinton, was ultimately unsuccessful.</p>\n\n<p><strong>Foreign Policy</strong><br>\nClinton's foreign policy included military intervention in the Balkans and efforts to facilitate peace in the Middle East with the Oslo Accords and Camp David Summit.</p>\n\n<p><strong>Impeachment and Acquittal</strong><br>\nClinton's second term was overshadowed by a scandal involving Monica Lewinsky, leading to his impeachment by the House of Representatives and acquittal by the Senate.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
