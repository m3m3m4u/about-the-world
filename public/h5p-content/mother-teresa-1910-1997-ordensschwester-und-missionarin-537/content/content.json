              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Mother Teresa (1910-1997) - Ordensschwester und Missionarin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
