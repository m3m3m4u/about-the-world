          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 1)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "5627dc6e-c943-439e-ab4a-4531b7f24264"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Frühes Leben von Mother Teresa</strong><br>\nAgnes Gonxha Bojaxhiu, die weltweit als Mother Teresa bekannt wurde, kam am 26. August 1910 in Skopje, damals Teil des Osmanischen Reiches, zur Welt. Mit acht Jahren verlor sie ihren Vater und erlebte eine tiefe christliche Erziehung durch ihre Mutter. Sie fühlte schon früh den Ruf, ihrem Leben eine religiöse Bedeutung zu geben und entschied sich im Alter von 18 Jahren, ihr Leben Gott zu weihen.</p>\n\n<p><strong>Eintritt in den Orden</strong><br>\n1928 trat Agnes in den Orden der Schwestern Unserer Lieben Frau von Loreto ein und nahm den Namen Teresa an. Sie wurde nach Indien geschickt, wo sie in Darjeeling ihre erste religiöse Ausbildung erhielt. Sie widmete sich dem Unterrichten von Kindern an einer Schule in Kalkutta und wurde schließlich Schulleiterin. Doch die Armut um sie herum beeinflusste sie tief.</p>\n\n<p><strong>\"Ruf innerhalb eines Rufes\"</strong><br>\n1946 erfuhr Teresa während einer Zugfahrt von Kalkutta nach Darjeeling, was sie als \"Ruf innerhalb eines Rufes\" beschrieb. Sie sah es als Gottes Aufforderung, den Orden zu verlassen und den Armen und Kranken zu helfen. Dieser Erleuchtungsmoment führte dazu, dass sie ihre komfortable Position als Schulleiterin aufgab, um den Ärmsten der Armen zu dienen.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
