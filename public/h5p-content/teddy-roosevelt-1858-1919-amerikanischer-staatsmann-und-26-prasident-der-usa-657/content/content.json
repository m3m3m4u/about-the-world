              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Teddy Roosevelt (1858-1919) - Amerikanischer Staatsmann und 26. Präsident der USA</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
