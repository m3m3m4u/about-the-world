              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Lech Wałęsa (né en 1943) - Leader syndical polonais et plus tard président</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
