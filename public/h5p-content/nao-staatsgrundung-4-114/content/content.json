                "defaultLanguage": "it"
              },
              "subContentId": "5627dc6e-c943-439e-ab4a-4531b7f24264"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Situazione iniziale in Palestina</strong><br>\nPrima della fondazione di Israele, l'area che oggi comprende Israele e la Palestina era sotto il controllo britannico, noto come il Mandato Britannico della Palestina. In questa regione vivevano comunità ebraiche e arabe, ciascuna con diverse rivendicazioni nazionali. La comunità ebraica aspirava a uno Stato indipendente come rifugio per gli ebrei di tutto il mondo, soprattutto alla luce delle persecuzioni in Europa.</p>\n\n<p><strong>Piano di divisione delle Nazioni Unite del 1947</strong><br>\nNel 1947, le Nazioni Unite adottarono un piano di divisione che suddivideva il territorio della Palestina in uno Stato ebraico e uno Stato arabo, con Gerusalemme come città internazionale. Il piano fu accettato dai leader ebraici ma rifiutato dai leader arabi, portando a tensioni nella regione.</p>\n\n<p><strong>Dichiarazione d'indipendenza di Israele</strong><br>\nIl 14 maggio 1948, David Ben-Gurion, il leader della comunità ebraica in Palestina, dichiarò l'indipendenza dello Stato di Israele. Questo avvenne nell'ultimo giorno del Mandato Britannico sulla Palestina. La dichiarazione d'indipendenza sottolineava il legame del popolo ebraico con la terra di Israele e l'intento di creare uno Stato ebraico.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "it"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
