            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Influence on Modern Medicine</strong><br>\nPaul Ehrlich's concepts, such as receptor theory and the therapeutic index, are fundamental principles of pharmacology and have guided drug development for over a century.</p>\n\n<p><strong>Legacy and Impact on Science</strong><br>\nEhrlich's innovative work in the early 20th century has had a lasting impact on medicine and science. His visionary ideas paved the way for modern drug discovery and therapeutic practices.</p>\n\n<p><strong>Death and Posthumous Recognition</strong><br>\nEhrlich passed away on August 20, 1915. He is remembered for his scientific genius and his profound influence on medical research, which continues to benefit humanity.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
