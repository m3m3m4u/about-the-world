                "text": "<p><span style=\"font-size:3em;\"><strong>Aspasia de Mileto (ca. 470-400 a.C.), compañera de Pericles</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Información y ejercicios</span></strong></p>\n"
