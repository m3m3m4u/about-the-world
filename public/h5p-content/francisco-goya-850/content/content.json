          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Francisco Goya's Early Life</strong><br>\nFrancisco Goya was born in 1746 in Fuendetodos, Spain, and began his art studies at fourteen. He became one of the most important Spanish artists of his time, known for his paintings, etchings, and frescoes.</p>\n\n<p><strong>Rise to Court Painter</strong><br>\nGoya's talent earned him the position of painter to the Spanish court. He created portraits for royalty and nobility, capturing the turmoil and change of his era with a unique expressiveness and insight.</p>\n\n<p><strong>The Darker Turn of Goya's Art</strong><br>\nIn the later years of his career, Goya's work took on a darker tone, often reflecting his disillusionment with the political and social upheavals in Spain. His paintings became famous for their haunting and sometimes grotesque quality.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
