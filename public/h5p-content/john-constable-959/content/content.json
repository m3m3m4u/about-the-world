          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Constable's Technique and Style</strong><br>\nConstable was known for his innovative painting techniques. He used quick brush strokes and palette knife application to create vibrant, dynamic textures. His work was characterized by a fresh, lively treatment of light and weather conditions.</p>\n\n<p><strong>Recognition and Struggles</strong><br>\nDespite his talent, Constable was not fully appreciated in England until later in life. He struggled financially and did not sell many paintings until he was elected to the Royal Academy at the age of 52.</p>\n\n<p><strong>Influence on the Barbizon School</strong><br>\nConstable's work had a significant impact on the Barbizon School in France and the subsequent Impressionist movement. His emphasis on lighting and outdoor painting directly influenced many French artists.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
