          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>John Constable's Early Life</strong><br>\nJohn Constable was born in 1776 in Suffolk, England, into a family of wealthy landowners. His early life among the rural landscape influenced his future work, which focused on capturing the beauty of the English countryside.</p>\n\n<p><strong>Dedication to Naturalism</strong><br>\nConstable rejected the grandiose style of painting that was popular in his day, focusing instead on the realistic depiction of nature. He believed that artists should paint their subjects in a true-to-life manner, which was evident in his landscape paintings.</p>\n\n<p><strong>The Hay Wain</strong><br>\nIn 1821, Constable completed \"The Hay Wain,\" one of his most famous works. The painting, which depicts a rural scene on the River Stour, is celebrated for its accurate reflection of natural light and atmosphere.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
