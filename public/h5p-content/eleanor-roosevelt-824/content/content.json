            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of Eleanor Roosevelt</strong><br>\nEleanor Roosevelt was born on October 11, 1884, into a prominent New York family. Despite her wealthy background, her childhood was not happy, marred by the death of both parents before she turned ten. She was educated by private tutors and at exclusive schools, including Allenswood Academy in London, which shaped her independent thinking and progressive views on social issues.</p>\n\n<p><strong>Marriage and Family</strong><br>\nIn 1905, Eleanor married Franklin Delano Roosevelt, a distant cousin and future President of the United States. They had six children, although one died in infancy. Her experience as a mother and partner in a politically active family prepared her for the public roles she would later assume.</p>\n\n<p><strong>Role as First Lady</strong><br>\nEleanor Roosevelt redefined the role of the First Lady during her husband's presidency from 1933 to 1945. She became an active participant in national politics, advocating for social reform and women's rights. Her press conferences and daily newspaper columns voiced her opinions and supported the New Deal policies.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
