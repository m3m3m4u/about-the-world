      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Einführung der Demokratie</strong><br>\nKleisthenes ist vor allem für seine Reformen bekannt, die den Grundstein für die athenische Demokratie legten. Er führte das Prinzip der Volkssouveränität ein, wonach nicht Adlige oder Tyrannen, sondern das Volk die Quelle der Macht sein sollte. Er teilte das Volk in zehn Phylen, um die politische Macht breiter zu streuen.</p>\n\n<p><strong>Ostrakismos</strong><br>\nEine seiner bekanntesten Neuerungen war der Ostrakismos, ein Verfahren, bei dem die Bürger einmal im Jahr darüber abstimmen konnten, ob jemand eine Gefahr für die Stadt darstellte. Bei genügend Stimmen gegen eine Person wurde diese für zehn Jahre verbannt, ohne dass ihr Eigentum konfisziert wurde.</p>\n\n<p><strong>Die Phylenreform</strong><br>\nDie Phylenreform zielte darauf ab, die bestehenden Machtstrukturen zu durchbrechen. Indem Kleisthenes die Bevölkerung neu gruppierte und Regionen mit unterschiedlichen Interessen zusammenführte, schwächte er die Macht der Aristokratie und förderte eine politische Beteiligung über traditionelle Grenzen hinweg.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
