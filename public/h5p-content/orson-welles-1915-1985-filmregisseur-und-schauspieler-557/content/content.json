              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Orson Welles (1915-1985) - Filmregisseur und Schauspieler</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
