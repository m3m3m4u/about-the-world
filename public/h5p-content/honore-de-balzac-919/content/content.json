          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Honoré de Balzac's Early Life</strong><br>\nHonoré de Balzac was born in 1799 in Tours, France. From a young age, he was sent to a boarding school in Vendôme, which he later described as a time of misery and loneliness. Despite an inauspicious start, he developed a love for literature and writing.</p>\n\n<p><strong>Literary Beginnings</strong><br>\nBalzac's early literary work was marked by a series of unsuccessful plays and novels. He wrote under various pseudonyms, accumulating debt as he struggled to find his voice and audience. This period was crucial in shaping his understanding of society's workings.</p>\n\n<p><strong>The Human Comedy</strong><br>\nBalzac's reputation was established with the creation of \"La Comédie Humaine\" (The Human Comedy), a series of linked novels and stories that present a panorama of post-Napoleonic French life. This opus reflects the complexity of society and human behavior.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
