              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>John Bardeen (1908-1991) - Physiker, zweifacher Nobelpreisträger für Physik</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
