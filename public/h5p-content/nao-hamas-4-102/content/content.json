                "title": "Unbenannt: Text",
                "defaultLanguage": "it"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Vista come combattenti per la libertà</strong><br>\nAlcuni considerano Hamas come combattenti per la libertà che resistono all'occupazione e lottano per i diritti dei palestinesi. Vedono le azioni di Hamas come una reazione alla continua occupazione militare e oppressione da parte di Israele. Questa visione è particolarmente diffusa in alcuni paesi arabi e musulmani.</p>\n\n<p><strong>Servizi umanitari e sociali</strong><br>\nHamas offre anche una serie di servizi sociali e umanitari nelle aree in cui opera. Questi includono scuole, ospedali e altre istituzioni sociali. Questi servizi hanno rafforzato il sostegno della popolazione locale per Hamas e hanno conferito loro un certo grado di legittimità.</p>\n\n<p><strong>Relazioni internazionali</strong><br>\nLe relazioni internazionali di Hamas sono complesse. Mentre alcuni paesi e organizzazioni interagiscono con Hamas, altri evitano il contatto a causa della loro classificazione come organizzazione terroristica. La posizione di Hamas nel contesto internazionale rimane controversa e le sue relazioni con altri paesi sono spesso tese.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "it"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
