              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Haile Selassie (1892-1975) - Kaiser von Äthiopien</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
