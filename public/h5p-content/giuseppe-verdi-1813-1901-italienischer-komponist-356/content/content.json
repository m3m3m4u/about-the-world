      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Persönliches Leben und Schicksalsschläge</strong><br>\nVerdis persönliches Leben war von Schicksalsschlägen geprägt. 1838 heiratete er Margherita Barezzi, die Tochter seines Förderers. Sie hatten zwei Kinder, die jedoch beide früh starben, gefolgt vom Tod seiner Frau im Jahr 1840. Diese Verluste spiegeln sich in der düsteren und emotionalen Tiefe seiner Musik wider.</p>\n\n<p><strong>Wichtige Werke und Erfolge</strong><br>\nNach \"Nabucco\" folgten zahlreiche erfolgreiche Opern, darunter \"Rigoletto\" (1851), \"Il trovatore\" (1853) und \"La traviata\" (1853). Diese Werke festigten Verdis Ruf als einer der führenden Opernkomponisten seiner Zeit und trugen zu einer neuen Ära der italienischen Oper bei, die sich durch starke Charaktere und dramatische Intensität auszeichnete.</p>\n\n<p><strong>Verdis Spätwerk</strong><br>\nIn seinen späteren Jahren komponierte Verdi weniger, aber seine Werke zeigten weiterhin Innovation und Meisterschaft. Zu seinen späten Meisterwerken gehören \"Aida\" (1871), geschrieben für die Eröffnung des Suezkanals, und \"Otello\" (1887), eine Adaption von Shakespeares Stück, die er im hohen Alter vollendete.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
