              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Vincent van Gogh (1853-1890) - Niederländischer Maler</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
