            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nBenito Mussolini was born on July 29, 1883, in Predappio, Italy. Initially a socialist, he broke with the Italian Socialist Party over his support for World War I and formed the Fascist Party in 1919.</p>\n\n<p><strong>Foundation of Fascism</strong><br>\nMussolini founded Fascism as a political movement that emphasized nationalism, militarism, and the absolute power of the state. It attracted widespread support during a period of economic instability and social strife.</p>\n\n<p><strong>March on Rome</strong><br>\nIn 1922, Mussolini led the \"March on Rome,\" which resulted in King Victor Emmanuel III asking him to form a government. He became the youngest Prime Minister in Italian history.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
