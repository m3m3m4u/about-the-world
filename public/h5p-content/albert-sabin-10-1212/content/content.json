          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Totalitarian Rule</strong><br>\nMussolini established a totalitarian regime by the mid-1920s, using propaganda and state repression to consolidate power and create a cult of personality around himself as \"Il Duce.\"</p>\n\n<p><strong>Aggressive Foreign Policy</strong><br>\nHis foreign policy aimed at expanding Italian territory and influence, leading to conflicts in Africa and the Balkans, and an alliance with Nazi Germany.</p>\n\n<p><strong>World War II and Downfall</strong><br>\nMussolini's decision to enter World War II on the side of Germany proved disastrous for Italy. The Italian military suffered numerous defeats, and Mussolini was deposed in 1943.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
