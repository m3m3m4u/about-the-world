            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Assassination</strong><br>\nTrotsky was assassinated in Mexico in 1940 by an agent of the Soviet secret police. His legacy includes a complex relationship with Stalin and a profound influence on Marxist theory.</p>\n\n<p><strong>Legacy in Marxist Theory</strong><br>\nHis writings and the movement he inspired, Trotskyism, continue to be a major school of Marxist thought, advocating for international socialism and critiquing Stalinist practices in the Soviet Union.</p>\n\n<p><strong>Impact on International Politics</strong><br>\nTrotsky's ideas and revolutionary activities had a lasting impact on international politics, influencing various leftist movements and revolutions throughout the 20th century.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3d655444-fd55-42f7-aba2-16a16db7dc58"
