              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Francis Crick (1916-2004) - Molekularbiologe, Mitentdecker der Struktur der DNA</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
