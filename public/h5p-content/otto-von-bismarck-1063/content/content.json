          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nOtto von Bismarck was born on April 1, 1815, in Prussia, which was then a German kingdom. He came from a family of Junkers, who were Prussian nobility, and he studied law at the Universities of Göttingen and Berlin.</p>\n\n<p><strong>Rise to Power</strong><br>\nBismarck entered politics in 1838 as a civil servant but soon became involved in the Prussian legislature. His sharp intelligence and political insight quickly rose through the ranks, becoming the Minister-President of Prussia in 1862.</p>\n\n<p><strong>Unification of Germany</strong><br>\nBismarck is best known for unifying the numerous independent German states into one empire. He achieved this through skilled diplomacy and a series of wars that expanded Prussian power.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
