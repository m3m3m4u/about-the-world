              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Gerty Cori (1896-1957) - Biochimiste et lauréate du prix Nobel</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
