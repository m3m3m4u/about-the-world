              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Nicolas Copernic (1473-1543) - Astronome polonais</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
