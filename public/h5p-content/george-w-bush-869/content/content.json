          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>September 11 Attacks</strong><br>\nBush's presidency was defined early on by the September 11, 2001, terrorist attacks, leading to the initiation of the War on Terror and subsequent invasions of Afghanistan and Iraq.</p>\n\n<p><strong>Domestic Policies</strong><br>\nHis domestic agenda included tax cuts, the No Child Left Behind Act, and Medicare prescription drug benefits, alongside a focus on faith-based initiatives.</p>\n\n<p><strong>Second Term and Further Challenges</strong><br>\nRe-elected in 2004, Bush faced challenges including Hurricane Katrina, the ongoing conflicts in the Middle East, and the global financial crisis of 2008.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
