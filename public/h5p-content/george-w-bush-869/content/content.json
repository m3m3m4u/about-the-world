            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Years and Education</strong><br>\nGeorge W. Bush, the eldest son of George H.W. Bush, was born on July 6, 1946, in New Haven, Connecticut. He graduated from Yale University and earned an MBA from Harvard Business School.</p>\n\n<p><strong>Governor of Texas</strong><br>\nBefore his presidency, Bush was the Governor of Texas from 1995 to 2000, where he promoted education reform and the death penalty for capital crimes.</p>\n\n<p><strong>Election and Recount</strong><br>\nBush was elected the 43rd president in 2000 after a historic and controversial recount in Florida that was ultimately decided by the Supreme Court.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
