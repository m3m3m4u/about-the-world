          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life and Education</strong><br>\nHerman Melville was born in New York City in 1819. After his father's death, he left school to work various jobs, including as a cabin boy on a merchant ship, which sparked his love for the sea and adventure.</p>\n\n<p><strong>\"Typee\" and \"Omoo\"</strong><br>\nMelville's early novels, \"Typee\" (1846) and \"Omoo\" (1847), were based on his experiences in the South Seas. These adventure narratives were popular and brought Melville early literary success.</p>\n\n<p><strong>\"Moby-Dick\"</strong><br>\nMoby-Dick, published in 1851, is Melville's most famous work. It initially received mixed reviews and was a financial failure. The novel's complex narrative and symbolism were not fully appreciated until the 20th century.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
