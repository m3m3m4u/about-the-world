            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Economic and Social Policies</strong><br>\nIndira Gandhi is credited with initiating further industrialization in India and promoting social policies aimed at the upliftment of the underprivileged.</p>\n\n<p><strong>Political Legacy</strong><br>\nHer legacy is marked by bold leadership but also criticism for centralizing power and undermining democratic processes.</p>\n\n<p><strong>Assassination and Aftermath</strong><br>\nHer assassination led to widespread anti-Sikh riots, causing extensive debates on ethnic tensions and secularism in India.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
