                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "it"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Proposta di Divisione delle Nazioni Unite</strong><br>\nNel 1947, le Nazioni Unite proposero una divisione della Palestina in uno stato ebraico e uno stato arabo. Questo piano fu accettato dai leader ebrei, ma rifiutato dai leader arabi. Il piano di divisione portò alla fondazione dello Stato di Israele nel 1948, ma anche all'inizio del conflitto arabo-israeliano.</p>\n\n<p><strong>Fondazione dello Stato di Israele</strong><br>\nIl 14 maggio 1948, David Ben-Gurion, il presidente del Consiglio Nazionale Ebraico, dichiarò l'indipendenza di Israele. Questo portò a una guerra tra Israele e gli stati arabi circostanti. Nonostante le grandi sfide, Israele riuscì a mantenere la sua indipendenza e iniziò ad accogliere immigrati ebrei da tutto il mondo.</p>\n\n<p><strong>Implicazioni per la Palestina</strong><br>\nLa fondazione di Israele ebbe un impatto significativo sulla popolazione palestinese. Molti furono espulsi o fuggirono, diventando rifugiati nei paesi arabi circostanti. I territori della Cisgiordania e della Striscia di Gaza passarono sotto il controllo giordano ed egiziano, rispettivamente.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "it"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
