          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Post-Flight Fame</strong><br>\nAfter his historic flight, Gagarin became a global celebrity and an important figure for Soviet propaganda. He toured the world promoting the Soviet Union's accomplishment in the space race.</p>\n\n<p><strong>Continuing Service and Untimely Death</strong><br>\nDespite his desire to return to space, Soviet officials feared losing him in an accident. Gagarin's life was cut short when he died in a jet crash during a routine training flight on March 27, 1968.</p>\n\n<p><strong>Impact on Space Exploration</strong><br>\nGagarin's voyage had a profound impact on space exploration and Cold War dynamics, inspiring both competition and cooperation in space technology.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
