          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Years</strong><br>\nYuri Gagarin was born on March 9, 1934, in a small village near Smolensk, Russia. Growing up during World War II, his childhood was marked by hardship and occupation by Nazi Germany.</p>\n\n<p><strong>Education and Pilot Training</strong><br>\nGagarin was selected for Air Force pilot training due to his exceptional manual skills and intelligence. He excelled in his studies and became a military pilot, later enrolling in an advanced training program for cosmonauts.</p>\n\n<p><strong>Historic Spaceflight</strong><br>\nOn April 12, 1961, Gagarin became the first human to travel into space and orbit the Earth, completing one orbit in 108 minutes. His spacecraft, Vostok 1, made him an international hero and a symbol of Soviet space achievement.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
        "slideBackgroundSelector": {}
      },
      {
        "elements": [
          {
            "x": 2.23463687150838,
