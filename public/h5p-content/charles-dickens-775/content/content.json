            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of Charles Dickens</strong><br>\nCharles Dickens was born in Portsmouth, England, in 1812. He faced a difficult childhood as his family was imprisoned for debt, forcing him to work in a factory at a young age. These early hardships influenced much of his later writing.</p>\n\n<p><strong>\"The Pickwick Papers\"</strong><br>\nIn 1836, Dickens's first novel, \"The Pickwick Papers,\" was published. Serialized initially, it became a publishing phenomenon, elevating Dickens to celebrity status in Britain due to its humorous and satirical quality.</p>\n\n<p><strong>Social Commentary in Novels</strong><br>\nDickens's work is known for its realism, humor, and keen observation of character and society. His novels often highlighted the struggles of the poor and critiqued the social and economic forces that perpetuated poverty.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
