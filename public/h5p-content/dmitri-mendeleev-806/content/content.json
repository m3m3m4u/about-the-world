            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of Dmitri Mendeleev</strong><br>\nDmitri Mendeleev was born in Siberia, Russia, in 1834. He was the youngest of many siblings in his family. His father was a teacher of fine arts, politics, and philosophy. After his father became blind and could no longer work, his mother started a glass factory to support the family. This early exposure to manufacturing may have influenced Mendeleev's interest in science and materials.</p>\n\n<p><strong>Education and Academic Career</strong><br>\nMendeleev pursued higher education with determination. He overcame personal challenges, including the loss of his father and the destruction of his family's glass factory. Mendeleev earned his Master's degree in chemistry from the University of Saint Petersburg. He became a professor of chemistry at the Saint Petersburg Technological Institute and later at the University of Saint Petersburg.</p>\n\n<p><strong>Developing the Periodic Table</strong><br>\nIn 1869, Mendeleev developed the Periodic Table of Elements. He organized 63 known elements into a table based on atomic mass, which showed that elements with similar properties occurred at regular intervals. Mendeleev's table left spaces for undiscovered elements, predicting their properties with remarkable accuracy.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
