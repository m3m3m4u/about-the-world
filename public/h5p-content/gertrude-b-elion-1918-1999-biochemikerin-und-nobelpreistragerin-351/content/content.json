        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 3)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "4381b60d-c67f-4722-b83d-b17f2fc9d01c"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Einfluss auf die Behandlung von Krankheiten</strong><br>\nElions Forschung hatte direkten Einfluss auf die Behandlung verschiedener Krankheiten. Sie entwickelte beispielsweise Medikamente zur Bekämpfung von Leukämie, was die Überlebensrate von Patienten bedeutend erhöhte und neue Wege in der Behandlung dieser Krankheit öffnete.</p>\n\n<p><strong>Lehr- und Mentorentätigkeit</strong><br>\nNach ihrer Pensionierung widmete sich Elion der Lehre und wurde Mentorin für neue Wissenschaftler. Sie glaubte fest an die Bedeutung von Bildung und Erziehung als Grundsteine für zukünftige wissenschaftliche Entdeckungen und engagierte sich stark in diesen Bereichen.</p>\n\n<p><strong>Lebenslange Anerkennung und Vermächtnis</strong><br>\nGertrude B. Elion starb am 21. Februar 1999, doch ihr Vermächtnis lebt weiter. Ihre Entschlossenheit und ihre wissenschaftlichen Beiträge bleiben eine Inspiration für alle, die sich für die Biochemie und Medizin interessieren. Sie hinterließ eine Welt, die durch ihre Arbeit in der Arzneimittelforschung sicherer und gesünder ist.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3d655444-fd55-42f7-aba2-16a16db7dc58"
