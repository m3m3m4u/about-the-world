            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of John Bardeen</strong><br>\nJohn Bardeen was born on May 23, 1908, in Madison, Wisconsin. He showed an early interest in science and mathematics. His father, a professor of anatomy, and his mother, who had a degree in psychology, both encouraged his education. By age 12, John had already proven to be an exceptional student, especially in math and science.</p>\n\n<p><strong>Education and Early Career</strong><br>\nBardeen pursued electrical engineering at the University of Wisconsin-Madison, graduating in 1928. He furthered his studies in mathematical physics at Princeton University, where he earned his Ph.D. in 1936. Afterward, he worked on naval mine control at the Naval Ordnance Laboratory during World War II and later joined the Bell Labs.</p>\n\n<p><strong>Invention of the Transistor</strong><br>\nAt Bell Labs, Bardeen, along with William Shockley and Walter Brattain, invented the transistor in 1947. This revolutionary device could amplify and switch electronic signals, marking the beginning of modern electronics. For this achievement, they were awarded the Nobel Prize in Physics in 1956.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
