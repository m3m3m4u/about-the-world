              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Florence Nightingale (1820-1910) - Begründerin der modernen Krankenpflege</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
