              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Hipparchos (ca. 190-120 v. Chr.) - griechischer Astronom und Mathematiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Información y ejercicios</span></strong></p>\n"
              },
