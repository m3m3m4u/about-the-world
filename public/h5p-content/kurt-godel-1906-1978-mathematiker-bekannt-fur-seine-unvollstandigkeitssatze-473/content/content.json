              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Kurt Gödel (1906-1978) - Mathematiker, bekannt für seine Unvollständigkeitssätze</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
