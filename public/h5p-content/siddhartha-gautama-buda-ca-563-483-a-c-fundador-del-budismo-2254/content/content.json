                "defaultLanguage": "es"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>La iluminación de Siddhartha</strong><br>\nTras años de búsqueda y práctica de la meditación, Siddhartha alcanzó la iluminación mientras meditaba bajo un árbol Bodhi. Allí comprendió las causas del sufrimiento y cómo superarlo, lo que constituiría la esencia de sus enseñanzas futuras.</p>\n\n<p><strong>Las Cuatro Nobles Verdades</strong><br>\nEl núcleo de la enseñanza de Buda está en las Cuatro Nobles Verdades: la verdad del sufrimiento, la verdad de la causa del sufrimiento, la verdad del fin del sufrimiento y la verdad del camino que conduce al fin del sufrimiento, que es el Noble Óctuple Sendero.</p>\n\n<p><strong>El Noble Óctuple Sendero</strong><br>\nEl Noble Óctuple Sendero es una serie de pasos prácticos que guían hacia la superación del apego y el deseo, que son vistos como las principales causas del sufrimiento. Este camino incluye rectitud en el entendimiento, en el pensamiento, en el habla, en la acción, en el modo de vida, en el esfuerzo, en la atención y en la concentración.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "es"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
