              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Jane Goodall (geb. 1934) - Primatologin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
