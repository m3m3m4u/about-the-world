              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Ingmar Bergman (1918-2007) - regista cinematografico</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
