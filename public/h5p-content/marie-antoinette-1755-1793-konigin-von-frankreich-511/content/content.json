              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Marie Antoinette (1755-1793) - Königin von Frankreich</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
