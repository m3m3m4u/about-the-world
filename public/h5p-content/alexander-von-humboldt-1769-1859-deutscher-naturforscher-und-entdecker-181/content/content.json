              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Alexander von Humboldt (1769-1859) - Deutscher Naturforscher und Entdecker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
