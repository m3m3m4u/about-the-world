              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>James Watt (1736-1819) - Inventor e ingeniero escocés</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Información y ejercicios</span></strong></p>\n"
              },
