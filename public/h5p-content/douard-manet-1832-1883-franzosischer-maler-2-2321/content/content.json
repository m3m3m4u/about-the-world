              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Influencia en el Impresionismo</strong><br>\nAunque Manet no se consideraba a sí mismo como un impresionista, su trabajo tuvo una influencia significativa en los artistas impresionistas contemporáneos y futuros.</p>\n\n<p><strong>Relación con Otros Artistas</strong><br>\nManet fue mentor de artistas más jóvenes como Claude Monet y Pierre-Auguste Renoir, y mantuvo amistades con otros pintores impresionistas, inspirándolos a buscar nuevos caminos en la expresión artística.</p>\n\n<p><strong>Vida y Carrera</strong><br>\nSu vida estuvo marcada por el reconocimiento oficial y la controversia en igual medida, y sus exposiciones a menudo fueron recibidas con críticas polarizadas.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "es"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
