          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Post-Flight Career</strong><br>\nFollowing her spaceflight, Tereshkova never flew again but became a prominent member of the Communist Party and a representative of the Soviet government.</p>\n\n<p><strong>Impact and Legacy</strong><br>\nTereshkova's flight was a significant milestone in the history of human spaceflight and served as an inspiration for women in the fields of science and technology. Her legacy continues to influence the role of women in space exploration.</p>\n\n<p><strong>Recognition and Honors</strong><br>\nShe received the title Hero of the Soviet Union and was honored with various medals and awards for her contributions to the Soviet space effort.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
