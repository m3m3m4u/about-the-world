          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nValentina Tereshkova was born on March 6, 1937, in the Yaroslavl Region, Soviet Union. Coming from a humble background, she worked in a textile factory and was an avid skydiver, which later played a crucial role in her selection as a cosmonaut.</p>\n\n<p><strong>Recruitment into the Space Program</strong><br>\nIn 1961, after Yuri Gagarin's historic flight, the Soviet space program sought to send a woman into space. Tereshkova's skydiving experience made her an ideal candidate, and she was enlisted in the program.</p>\n\n<p><strong>Vostok 6 Mission</strong><br>\nOn June 16, 1963, Tereshkova became the first woman to fly to space, piloting the Vostok 6. She orbited the Earth 48 times, spent almost three days in space, and remains the only woman to have been on a solo space mission.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
