              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Alan Kay (nato nel 1940) - informatico, pioniere dell'orientamento agli oggetti e del personal computing</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
              "metadata": {
