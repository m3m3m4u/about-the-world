              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Claude Monet (1840-1926) - Französischer Maler</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
