              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Gioachino Rossini (1792-1868) - Italienischer Komponist</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
