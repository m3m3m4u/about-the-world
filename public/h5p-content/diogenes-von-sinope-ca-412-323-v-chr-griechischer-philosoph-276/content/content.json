              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Diogenes von Sinope (ca. 412-323 v. Chr.) - Griechischer Philosoph</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
