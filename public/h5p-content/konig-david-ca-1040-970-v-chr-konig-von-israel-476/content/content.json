      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 1)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "5627dc6e-c943-439e-ab4a-4531b7f24264"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Frühes Leben von David</strong><br>\nDavid war der jüngste Sohn von Isai, der aus Bethlehem kam. Seine Geschichte wird vor allem im Alten Testament der Bibel erzählt. Bevor David König wurde, hütete er Schafe. Als junger Mann wurde er von Samuel, dem Propheten, zum König gesalbt, weil Gott ihn auserwählt hatte. Diese Salbung fand im Geheimen statt, während Saul noch König von Israel war.</p>\n\n<p><strong>David und Goliath</strong><br>\nEiner der bekanntesten Momente in Davids Leben ist der Kampf gegen Goliath, einen riesigen Krieger der Philister. Mit nichts weiter als einer Schleuder und einem Stein besiegte David Goliath und wurde dadurch zum Volkshelden. Dieser Sieg zeigte, dass David nicht nur Mut, sondern auch Glauben und Vertrauen in Gott hatte.</p>\n\n<p><strong>Aufstieg zur Macht</strong><br>\nNach dem Sieg über Goliath stieg David schnell auf und wurde ein führender Offizier in Sauls Armee. Aber Saul wurde eifersüchtig auf Davids Erfolge und Popularität. Saul versuchte mehrmals, David zu töten, woraufhin David floh und zum Anführer einer Gruppe von Ausgestoßenen wurde.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
