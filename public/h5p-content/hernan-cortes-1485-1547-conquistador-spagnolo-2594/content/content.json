          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Hernán Cortés</strong><br>\nHernán Cortés è nato nel 1485 a Medellín, in Spagna. Da giovane, si è trasferito a Hispaniola, l'attuale Repubblica Dominicana e Haiti, nel 1504 e in seguito a Cuba. Cortés è diventato un notabile amministratore coloniale e un soldato.</p>\n\n<p><strong>La conquista dell'Impero Azteco</strong><br>\nNel 1519, Cortés ha guidato una spedizione in Messico con l'intento di esplorare e alla fine conquistare l'Impero Azteco. Riuscì a stringere alleanze con alcuni popoli indigeni che erano sottomessi dagli Aztechi.</p>\n\n<p><strong>La tattica di Cortés</strong><br>\nCortés è conosciuto per la sua tattica militare aggressiva e spesso brutale. Ha sfruttato le divisioni tra i diversi popoli indigeni e ha usato la diplomazia quando conveniva ai suoi scopi di conquista.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "it"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
