            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Finanzpolitik</strong><br>\nAntoninus Pius war bekannt für seine effiziente Finanzpolitik. Er verwaltete das Staatsbudget mit großer Umsicht und baute die Reserven des Imperiums aus. Er legte großen Wert auf eine gerechte Steuererhebung und setzte sich für eine Verminderung der Steuerlast der Provinzen ein, was seine Beliebtheit bei den Menschen steigerte.</p>\n\n<p><strong>Rechtsreformen</strong><br>\nEr führte wichtige Rechtsreformen durch und stärkte die Rechtsprechung. Antoninus Pius ließ bestehende Gesetze überarbeiten und ergänzen, wodurch das Rechtssystem effizienter und gerechter wurde. Diese Reformen wirkten sich positiv auf das alltägliche Leben der römischen Bürger aus.</p>\n\n<p><strong>Religiöse und kulturelle Förderung</strong><br>\nUnter Antoninus Pius erlebte Rom eine Zeit der religiösen und kulturellen Blüte. Er förderte traditionelle römische Kulte sowie andere Religionen im Reich und galt als toleranter Herrscher. Diese Politik trug zur kulturellen Vielfalt und zum sozialen Frieden im römischen Reich bei.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
