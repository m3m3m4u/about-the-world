              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Max Planck (1858-1947) - Physiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
