                "text": "<p><span style=\"font-size:3em;\"><strong>Edward Hopper (1882-1967) - Artista</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
