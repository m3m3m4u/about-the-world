      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Bauvorhaben und Architektur</strong><br>\nAls begeisterter Bewunderer der griechischen Kultur förderte Hadrian die Architektur und initiierte zahlreiche Bauprojekte in ganz Rom und den Provinzen. Unter seinen bekanntesten Bauprojekten ist die Hadriansvilla in Tivoli zu nennen. Auch ließ er das Pantheon in Rom neu errichten, das heute noch als Meisterwerk antiker Baukunst gilt.</p>\n\n<p><strong>Reisen des Kaisers</strong><br>\nHadrian war bekannt für seine ausgedehnten Reisen durch das römische Reich. Er besuchte fast jede Provinz und interessierte sich für die lokalen Kulturen und Probleme. Diese Reisen dienten nicht nur der Inspektion, sondern auch der diplomatischen Vertiefung der Beziehungen zu den Provinzen und der Propagierung seiner Politik der kulturellen Verschmelzung.</p>\n\n<p><strong>Kulturelles Engagement</strong><br>\nNeben seinen politischen und militärischen Tätigkeiten engagierte sich Hadrian stark in der Kultur. Er schrieb Gedichte, förderte Wissenschaft und Kunst und umgab sich mit Gelehrten. Sein Hof in Rom war ein Zentrum intellektueller Diskussionen, und er selbst galt als kultivierter und gebildeter Herrscher.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
