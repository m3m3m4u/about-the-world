              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Ivan Pavlov (1849-1936) - Physiologe</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
