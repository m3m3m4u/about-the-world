              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Albert Sabin (1906-1993) - Médecin et développeur du vaccin antipoliomyélitique oral</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
              "metadata": {
