              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Alexander Fleming (1881-1955) - Bakteriologe, Entdecker des Penicillins</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
