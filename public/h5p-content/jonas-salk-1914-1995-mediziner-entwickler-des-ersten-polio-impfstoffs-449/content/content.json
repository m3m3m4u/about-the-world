          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 3)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "4381b60d-c67f-4722-b83d-b17f2fc9d01c"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Spätere Jahre und andere Forschungen</strong><br>\nNach dem Erfolg seines Impfstoffs gründete Salk das Salk Institute for Biological Studies in La Jolla, Kalifornien. Hier konzentrierte er sich auf weitere Forschungen zu Multipler Sklerose und Krebs. Salk blieb bis zu seinem Tod im Jahr 1995 ein gefragter Sprecher und engagierter Wissenschaftler.</p>\n\n<p><strong>Salks Vermächtnis</strong><br>\nSalks Beitrag zur Medizin geht über den Polio-Impfstoff hinaus. Seine Arbeit hat die Forschung in vielerlei Hinsicht beeinflusst, unter anderem durch seine Ansichten über die soziale Verantwortung von Wissenschaftlern. Er hinterließ ein Vermächtnis, das die Bedeutung von öffentlichem Dienst und die Wichtigkeit von wissenschaftlicher Forschung für das Gemeinwohl betonte.</p>\n\n<p><strong>Erinnerung an Jonas Salk</strong><br>\nJonas Salk starb am 23. Juni 1995 in La Jolla, Kalifornien. Weltweit gedenkt man seiner als des Mannes, der den ersten effektiven Polio-Impfstoff entwickelte. Schulbücher und medizinische Lehrpläne erwähnen ihn als den Wissenschaftler, der viele Leben gerettet hat und dessen Entdeckung die weltweite Ausbreitung von Polio verhindert hat.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3d655444-fd55-42f7-aba2-16a16db7dc58"
