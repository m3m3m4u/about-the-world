              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>James Madison (1751-1836) - Amerikanischer Staatsmann und vierter Präsident der USA</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
