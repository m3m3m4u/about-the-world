              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Akbar le Grand (1542-1605) - Empereur de l'Inde</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
