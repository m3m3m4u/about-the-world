              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Margaret Sanger (1879-1966) - fondatrice del moderno movimento per il controllo delle nascite</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
