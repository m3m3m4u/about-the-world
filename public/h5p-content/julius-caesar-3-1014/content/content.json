          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p>Early Life of Julius Caesar<br>\nJulius Caesar was born on July 13, 100 BC, into a patrician family, which claimed descent from the gods. As a young boy, Caesar was educated by the best teachers in subjects like public speaking and martial arts, essential for a career in politics and the military. Despite his noble lineage, Caesar's family was not rich, and he knew he had to excel in his endeavors to rise to power in Rome.</p>\n\n<p><strong>Rise to Power</strong><br>\nCaesar began his rise to power in the Roman political system as a military tribune before being elected as a quaestor in 69 BC. These roles allowed him to gain military experience and make key alliances. With his appointment as pontifex maximus, or chief priest, he became an important figure in Rome's religious hierarchy, which further increased his influence.</p>\n\n<p><strong>First Triumvirate</strong><br>\nIn 60 BC, Caesar formed the First Triumvirate with Pompey the Great and Crassus, two of Rome's most powerful politicians and generals. This alliance was formed to overcome the political opposition and dominate the Roman political arena. The Triumvirate helped Caesar get elected as consul in 59 BC and afterwards appointed to a military command in Gaul.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
