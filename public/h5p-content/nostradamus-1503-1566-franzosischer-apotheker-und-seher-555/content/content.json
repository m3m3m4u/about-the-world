              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Nostradamus (1503-1566) - Französischer Apotheker und Seher</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
