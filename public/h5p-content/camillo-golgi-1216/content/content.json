          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life and Medical Studies</strong><br>\nCamillo Golgi was born on July 7, 1843, in Corteno, Italy. He pursued medical studies at the University of Pavia, where his interest in neuroscience and histology began to take shape.</p>\n\n<p><strong>Discovery of the Golgi Apparatus</strong><br>\nWhile working at the University of Pavia, Golgi discovered a cellular organelle that bears his name—the Golgi apparatus. This structure is essential for packaging proteins and lipids in the cell.</p>\n\n<p><strong>Invention of the Black Reaction</strong><br>\nGolgi invented a staining technique known as the black reaction, which allowed for the visualization of neurons and their intricate networks in the brain. This technique was crucial in advancing neurobiology.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
