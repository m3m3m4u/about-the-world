          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Nobel Prize in Physiology or Medicine</strong><br>\nIn 1906, Golgi shared the Nobel Prize in Physiology or Medicine with Santiago Ramón y Cajal. The prize recognized their work on the structure of the nervous system.</p>\n\n<p><strong>Research in Malaria and Other Diseases</strong><br>\nApart from his work in neuroscience, Golgi researched the life cycle of the malaria parasite. His studies contributed to understanding how this disease affects the body.</p>\n\n<p><strong>Contributions to Cellular Biology</strong><br>\nGolgi's research had a significant impact on the field of cellular biology. His findings on cell structure and function have helped scientists understand how cells process and transport molecules.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
