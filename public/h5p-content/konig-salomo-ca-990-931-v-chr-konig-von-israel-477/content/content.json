              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>König Salomo (ca. 990-931 v. Chr.) - König von Israel</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
