              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Peter Tschaikowsky (1840-1893) - Russischer Komponist</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
