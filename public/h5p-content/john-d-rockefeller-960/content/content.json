            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Wealth and Philanthropy</strong><br>\nRockefeller became the world's richest man and the first U.S. billionaire. He donated over $500 million to various philanthropic causes, including medical research, education, and the arts.</p>\n\n<p><strong>The Rockefeller Foundation</strong><br>\nIn 1913, he created the Rockefeller Foundation, which fostered scientific advancements and had a major impact on public health, including the eradication of hookworm and yellow fever.</p>\n\n<p><strong>Personal Beliefs and Lifestyle</strong><br>\nRockefeller was a devout Baptist and advocated for temperance and thrift. He attributed his success to his faith and disciplined work ethic, values that were reflective of his upbringing.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
