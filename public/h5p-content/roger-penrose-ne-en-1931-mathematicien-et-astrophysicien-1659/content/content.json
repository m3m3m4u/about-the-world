              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Roger Penrose (né en 1931) - mathématicien et astrophysicien</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
