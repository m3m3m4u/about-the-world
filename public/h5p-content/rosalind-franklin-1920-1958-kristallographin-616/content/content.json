              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Rosalind Franklin (1920-1958) - Kristallographin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
