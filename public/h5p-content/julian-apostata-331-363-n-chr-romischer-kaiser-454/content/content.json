              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Julian Apostata (331-363 n. Chr.) - Römischer Kaiser</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
