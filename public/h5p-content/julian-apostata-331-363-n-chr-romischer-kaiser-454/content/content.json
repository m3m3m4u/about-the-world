      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Julian als Gesetzgeber</strong><br>\nAls Kaiser erließ Julian Gesetze, die die Privilegien der christlichen Kirche beschnitten und die Wiederherstellung und Unterstützung der traditionellen Religionen förderten. Er erlaubte Exilanten, die während der vorhergehenden religiösen Verfolgungen verbannt worden waren, in ihre Heimat zurückzukehren. Julian nutzte das Recht als Mittel, um religiöse und soziale Reformen durchzusetzen.</p>\n\n<p><strong>Wirtschaftspolitik</strong><br>\nIn der Wirtschaftsführung war Julian bemüht, die Steuerlast für Bürger und Provinzen zu verringern. Er reformierte das Steuersystem, um es gerechter und effizienter zu machen, und versuchte, Korruption innerhalb der Verwaltung zu bekämpfen. Seine Maßnahmen zielten darauf ab, die wirtschaftliche Belastung der Bevölkerung zu mildern und gleichzeitig die Staatskassen zu schützen.</p>\n\n<p><strong>Militärische Feldzüge</strong><br>\nJulian führte mehrere militärische Kampagnen durch, um die Grenzen des Römischen Reiches zu sichern und zu erweitern. Sein wohl ambitioniertester Feldzug war der gegen das Sassanidenreich, eine mächtige regionale Macht im Osten. Trotz anfänglicher Erfolge führten schlechte Entscheidungen und Pech zum Scheitern dieses Feldzuges.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
