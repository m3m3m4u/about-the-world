            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of Titus</strong><br>\nTitus was born on December 30, 39 AD, to Vespasian, a respected general, and Flavia Domitilla. He was educated in the Roman court and showed an early interest in Roman politics and military affairs. Titus served in the military and proved his capability in campaigns in Germany and Britain. His early life set a strong foundation for his future role as Emperor of Rome.</p>\n\n<p><strong>Rise to Power</strong><br>\nTitus's rise to power began when his father, Vespasian, became emperor in 69 AD. Titus held various political and military positions, gaining popularity and experience. He played a crucial role in the Roman victory in the Jewish War, which boosted his reputation and paved the way for his eventual succession to the imperial throne.</p>\n\n<p><strong>Siege of Jerusalem</strong><br>\nThe siege of Jerusalem in 70 AD was a significant event in Titus's military career. He led the Roman forces against the Jewish rebellion with strategic skill. The siege lasted several months, resulting in the destruction of the city and the famous temple of Jerusalem. This victory was a pivotal moment for the Roman Empire and for Titus's image as a leader.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
