            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Personal Struggles and Artistic Vision</strong><br>\nDespite facing personal tragedies, including the death of his first wife and financial difficulties, Monet's dedication to capturing the nuances of nature remained unwavering.</p>\n\n<p><strong>Impact on Modern Art</strong><br>\nMonet's exploration of perception and light paved the way for the later modern art movements. He continued to paint until his death, despite suffering from cataracts.</p>\n\n<p><strong>Death and Legacy</strong><br>\nClaude Monet died on December 5, 1926, in Giverny. His contribution to art is immortalized in his vast body of work, which continues to be celebrated for its impact on both Impressionism and the wider world of art.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3d655444-fd55-42f7-aba2-16a16db7dc58"
