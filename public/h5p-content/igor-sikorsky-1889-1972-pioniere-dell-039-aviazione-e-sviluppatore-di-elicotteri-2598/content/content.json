              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Igor Sikorsky (1889-1972) - pioniere dell'aviazione e sviluppatore di elicotteri</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
