              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Plutarch (ca. 46-120 n. Chr.) - griechischer Schriftsteller und Philosoph</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Información y ejercicios</span></strong></p>\n"
              },
