              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Werner Forssmann (1904-1979) - Mediziner und Nobelpreisträger</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
