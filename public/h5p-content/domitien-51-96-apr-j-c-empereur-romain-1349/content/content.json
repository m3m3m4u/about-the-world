              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Domitien (51-96 apr. J.-C.) - Empereur romain</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
