              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Ronald Reagan (1911-2004) - US-Präsident und ehemaliger Schauspieler</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
