              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Martin Luther (1483-1546) - Moine allemand et réformateur de l'église</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
