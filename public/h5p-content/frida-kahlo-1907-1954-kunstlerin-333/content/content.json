      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Bedeutung der Kultur in ihren Werken</strong><br>\nKahlos Werke sind stark von der mexikanischen Kultur geprägt. Sie trug traditionelle mexikanische Kleidung und prägte den Einsatz von Symbolen und Bildern, die für Mexikos Geschichte und Identität stehen. Durch ihre Kunst schuf sie eine tiefe Verbindung zwischen ihrem persönlichen Leben und den nationalen Kulturelementen Mexikos.</p>\n\n<p><strong>Liebe und Ehe mit Diego Rivera</strong><br>\nFrida Kahlo heiratete den berühmten mexikanischen Maler Diego Rivera im Jahr 1929. Ihre Beziehung war kompliziert und von gegenseitiger künstlerischer Bewunderung sowie von zahlreichen Affären beider Seiten gezeichnet. Trotz der Turbulenzen ihrer Ehe blieben sie bis zu Fridas Tod verbunden und inspirierten sich gegenseitig in ihren künstlerischen Ausdrucksformen.</p>\n\n<p><strong>Politisches Engagement</strong><br>\nFrida war politisch aktiv und setzte sich für kommunistische Ideale ein. Ihre politischen Überzeugungen beeinflussten auch ihre Kunst. Sie war mehrmals in der Sowjetunion und unterstützte verschiedene politische Bewegungen. Ihre Überzeugungen führten dazu, dass sie auch Persönlichkeiten wie Leo Trotzki beherbergte und unterstützte.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
