              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Thukydides (ca. 460-395 v. Chr.) - Griechischer Historiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
