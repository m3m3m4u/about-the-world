      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 3)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "4381b60d-c67f-4722-b83d-b17f2fc9d01c"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Konflikte und Herausforderungen</strong><br>\nKeplers Leben war nicht frei von Konflikten. Er lebte in einer Zeit der religiösen Unruhen und der Inquisition. Seine Mutter wurde der Hexerei beschuldigt und er musste zu ihrer Verteidigung zurückkehren. Kepler selbst stand oft in Konflikt mit den Kirchen- und Staatsautoritäten wegen seiner wissenschaftlichen Überzeugungen und Methoden.</p>\n\n<p><strong>Spätere Jahre und Erbe</strong><br>\nIn seinen späteren Jahren zog Kepler mehrmals um, um verschiedenen Positionen an europäischen Höfen nachzugehen und der religiösen Verfolgung zu entgehen. Er veröffentlichte weitere wichtige Werke, die seine Gesetze erläuterten und anwendeten. Keplers Entdeckungen blieben einflussreich und bildeten später die Grundlage für Isaac Newtons Theorien der Schwerkraft.</p>\n\n<p><strong>Tod und dauerhafter Einfluss</strong><br>\nJohannes Kepler starb am 15. November 1630 in Regensburg. Er hinterließ ein Vermächtnis, das die Astronomie und Naturwissenschaften für immer prägen würde. Seine Gesetze ermöglichten es späteren Generationen von Wissenschaftlern, die Bewegungen im Sonnensystem mit großer Genauigkeit zu berechnen und trugen wesentlich zum Fortschritt in der Astronomie und in anderen Naturwissenschaften bei.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
