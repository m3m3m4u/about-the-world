              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Dmitri Mendelejew (1834-1907) - Russischer Chemiker</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
