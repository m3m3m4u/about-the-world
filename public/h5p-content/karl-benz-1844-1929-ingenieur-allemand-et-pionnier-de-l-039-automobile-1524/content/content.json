              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Karl Benz (1844-1929) - Ingénieur allemand et pionnier de l'automobile</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
