          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 3)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "4381b60d-c67f-4722-b83d-b17f2fc9d01c"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Beitrag zur Aufklärung der DNA-Struktur</strong><br>\nObwohl Franklins Arbeit zentral für das Verständnis der DNA war, erhielten Watson, Crick und Wilkins den Nobelpreis für Medizin im Jahr 1962, vier Jahre nach Franklins Tod. Ihre Beiträge wurden zu Lebzeiten nicht mit dem gleichen Maß an Anerkennung bedacht wie die ihrer männlichen Kollegen.</p>\n\n<p><strong>Weitere Forschungen und früher Tod</strong><br>\nFranklin setzte ihre Arbeit nach dem DNA-Projekt fort und machte wichtige Beiträge zur Virologie und RNA-Strukturforschung. Sie starb jedoch im Jahr 1958 im Alter von 37 Jahren an den Folgen von Eierstockkrebs, möglicherweise verursacht durch ihre langjährige Arbeit mit Röntgenstrahlen.</p>\n\n<p><strong>Erbe und Anerkennung</strong><br>\nHeute wird Rosalind Franklin als eine der wichtigsten Wissenschaftlerinnen des 20. Jahrhunderts anerkannt. Ihre Geschichte hat eine Debatte über die Anerkennung der Leistungen von Frauen in der Wissenschaft angestoßen und zeigt die Bedeutung ethischer Standards in der Forschung auf. Franklin hinterließ ein Vermächtnis, das junge Wissenschaftlerinnen weltweit inspiriert.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3d655444-fd55-42f7-aba2-16a16db7dc58"
