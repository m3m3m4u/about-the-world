              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Chandragupta Maurya (env. 340-297 av. J.-C.) - fondateur de l'empire Maurya en Inde</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
              "metadata": {
