      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Bautätigkeiten</strong><br>\nRamses II war auch ein großer Baumeister, dessen Projekte ganz Ägypten prägten. Er erweiterte den Karnak-Tempel und errichtete den Ramesseum, seinen eigenen Totentempel. Eines seiner bemerkenswertesten Bauwerke ist der Tempel von Abu Simbel, der in den Fels gehauen wurde und dessen vier riesige Statuen Ramses darstellen.</p>\n\n<p><strong>Wirtschaft und Verwaltung</strong><br>\nDie Wirtschaft Ägyptens blühte während der Regierungszeit von Ramses II auf, unterstützt durch seine Bauprojekte, die vielen Menschen Arbeit gaben. Er sorgte für ein gut organisiertes Verwaltungssystem, das für Steuereinnahmen und die Verteilung von Nahrungsmitteln verantwortlich war. Seine Effizienz in der Verwaltung trug zur langfristigen Stabilität Ägyptens bei.</p>\n\n<p><strong>Familienleben</strong><br>\nRamses II hatte mehrere Hauptfrauen und über 100 Kinder. Seine Lieblingsfrau war Nefertari, für die er den kleinen Tempel von Abu Simbel erbauen ließ. Das Familienleben war für Ramses strategisch wichtig, da Ehen mit ausländischen Prinzessinnen diplomatische Bündnisse stärkten.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
