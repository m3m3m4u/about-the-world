              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Julien l'Apostat (331-363 ap. J.-C.) - Empereur romain</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
