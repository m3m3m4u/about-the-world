              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Paul Ehrlich (1854-1915) - Médecin et lauréat du prix Nobel</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
