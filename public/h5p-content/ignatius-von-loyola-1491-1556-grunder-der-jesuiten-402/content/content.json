              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Ignatius von Loyola (1491-1556) - Gründer der Jesuiten</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
