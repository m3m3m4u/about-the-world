              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Ernest Hemingway (1899-1961) - Schriftsteller und Nobelpreisträger</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
