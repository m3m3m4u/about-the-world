              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Eli Whitney (1765-1825) - Amerikanischer Erfinder</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
