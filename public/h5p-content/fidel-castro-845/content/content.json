            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Years</strong><br>\nFidel Castro was born in 1926 in Birán, Cuba, and attended Catholic schools before enrolling at the University of Havana, where he studied law and became politically active.</p>\n\n<p><strong>Opposition to Batista</strong><br>\nCastro criticized the government of Cuban President Fulgencio Batista and led a failed coup attempt in 1953, for which he was imprisoned and later released.</p>\n\n<p><strong>Guerilla Leader</strong><br>\nAfter his release, Castro went to Mexico and organized a guerilla force, returning to Cuba to lead the Cuban Revolution which successfully overthrew Batista in 1959.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
