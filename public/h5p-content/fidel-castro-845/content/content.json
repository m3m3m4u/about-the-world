          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Castro's Cuba</strong><br>\nAs the leader of Cuba, Castro implemented socialist reforms and aligned with the Soviet Union, which led to the tense 1962 Cuban Missile Crisis.</p>\n\n<p><strong>Survival and Adaptation</strong><br>\nDespite numerous challenges, including a US economic embargo and the collapse of the Soviet Union, Castro maintained his grip on power for over five decades.</p>\n\n<p><strong>Human Rights Record</strong><br>\nCastro's government was criticized for suppressing dissent, limiting freedom of speech, and human rights abuses, despite improvements in education and healthcare.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
