          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Alan Greenspan</strong><br>\nAlan Greenspan es un economista estadounidense conocido por haber sido el presidente de la Reserva Federal de Estados Unidos. Nacido en 1926 en Nueva York, Greenspan se destacó por su extensa carrera en la formulación de políticas monetarias y su influencia en la economía global.</p>\n\n<p><strong>Presidente de la Reserva Federal</strong><br>\nGreenspan fue designado presidente de la Reserva Federal en 1987 por el presidente Ronald Reagan. Durante su mandato, que duró hasta 2006, supervisó periodos de expansión económica y enfrentó desafíos como la crisis financiera de 1987 y la burbuja de las punto com.</p>\n\n<p><strong>Política Monetaria</strong><br>\nComo líder de la Reserva Federal, Greenspan fue responsable de ajustar las tasas de interés para controlar la inflación y fomentar el empleo. Su enfoque pragmático y sus decisiones a menudo influían en los mercados financieros y en las políticas económicas de otros países.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "es"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
