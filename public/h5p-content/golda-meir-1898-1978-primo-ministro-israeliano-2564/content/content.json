              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Golda Meir (1898-1978) - primo ministro israeliano</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
