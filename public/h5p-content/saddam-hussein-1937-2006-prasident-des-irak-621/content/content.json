              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Saddam Hussein (1937-2006) - Präsident des Irak</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
