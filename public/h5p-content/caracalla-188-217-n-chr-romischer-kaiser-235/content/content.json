                "title": "Unbenannt: Text"
              },
              "subContentId": "4381b60d-c67f-4722-b83d-b17f2fc9d01c"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Finanzwesen unter Caracalla</strong><br>\nCaracalla sah sich zunehmenden finanziellen Schwierigkeiten gegenüber, bedingt durch seine Großzügigkeit gegenüber dem Militär und seine Bauvorhaben. Um diese Ausgaben zu decken, ließ er die Münzen des Reiches abwerten, was zu Inflation und wirtschaftlichen Problemen führte. Er setzte auf eine aggressive Steuerpolitik, um die Staatskassen zu füllen.</p>\n\n<p><strong>Außenpolitik und Feldzüge</strong><br>\nIn der Außenpolitik führte Caracalla Feldzüge gegen Germanen und Parther, um die Grenzen des Reiches zu sichern und zu erweitern. Obwohl diese militärischen Unternehmungen anfänglich erfolgreich waren, führten sie zu langwierigen Konflikten ohne entscheidenden Sieg, die das Reich zusätzlich belasteten und die Kriegskasse strapazierten.</p>\n\n<p><strong>Tod und Nachwirkung</strong><br>\nCaracalla wurde 217 während eines Feldzugs in der Nähe von Carrhae ermordet. Sein Tod führte zu einer kurzzeitigen Periode der Instabilität im Reich. Trotz seiner berüchtigten Regierungszeit hinterließ Caracalla durch die Erweiterung des Bürgerrechts und seine infrastrukturellen Projekte eine nachhaltige Wirkung im Römischen Reich. Seine Regierungszeit wird bis heute von Historikern und in der kulturellen Erinnerung kontrovers diskutiert.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
