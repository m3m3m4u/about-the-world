            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life and Education</strong><br>\nMargaret Thatcher was born in Grantham, England, and studied chemistry at Oxford University before becoming a barrister.</p>\n\n<p><strong>Entrance to Politics</strong><br>\nThatcher was elected to Parliament in 1959, serving as the Secretary of State for Education and Science before becoming the Leader of the Conservative Party in 1975.</p>\n\n<p><strong>Prime Ministerial Tenure</strong><br>\nShe became the first female Prime Minister of the United Kingdom in 1979 and served until 1990, making her the longest-serving British prime minister of the 20th century.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
        "slideBackgroundSelector": {}
      },
      {
        "elements": [
          {
            "x": 2.23463687150838,
