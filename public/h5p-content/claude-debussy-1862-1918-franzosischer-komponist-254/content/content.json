              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Claude Debussy (1862-1918) - Französischer Komponist</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
