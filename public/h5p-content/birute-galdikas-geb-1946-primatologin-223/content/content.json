          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 1)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "5627dc6e-c943-439e-ab4a-4531b7f24264"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Frühes Leben von Birutė Galdikas</strong><br>\nBirutė Galdikas wurde am 10. Mai 1946 in Deutschland geboren. Ihre litauischen Eltern waren nach dem Zweiten Weltkrieg dorthin geflohen. Im Alter von zwei Jahren zog Galdikas mit ihrer Familie nach Kanada. Schon früh entwickelte sie ein Interesse für Biologie und Tiere, insbesondere für Primaten. Dieses Interesse prägte ihre Bildungswahl und führte sie letztlich zu einem Studium in Zoologie und Anthropologie.</p>\n\n<p><strong>Universitäre Ausbildung</strong><br>\nAn der University of British Columbia erwarb sie ihren Bachelor-Abschluss in Psychologie und Zoologie. Galdikas setzte ihr Studium an der University of California, Los Angeles fort, wo sie von dem berühmten Paläoanthropologen Louis Leakey beeinflusst wurde. Leakey war bekannt für seine Arbeit mit Affen und inspirierte Galdikas, sich auf Orang-Utans zu spezialisieren.</p>\n\n<p><strong>Forschung mit Orang-Utans</strong><br>\nGaldikas begann ihre Feldforschung mit Orang-Utans in den Regenwäldern von Borneo im Jahr 1971. Sie wollte das Verhalten und die Ökologie dieser scheuen Primaten verstehen. Ihre Forschung half, wichtige Informationen über das Leben von Orang-Utans in der Wildnis zu sammeln, einschließlich ihrer Ernährung, Fortpflanzung und sozialen Strukturen.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
