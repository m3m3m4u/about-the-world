          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life and Education</strong><br>\nLewis Carroll was born Charles Lutwidge Dodgson on January 27, 1832, in Cheshire, England. He excelled in mathematics and classical languages during his studies at Christ Church, Oxford.</p>\n\n<p><strong>Dual Career</strong><br>\nCarroll worked as a mathematics lecturer at Oxford University, publishing several mathematical papers under his real name while writing fiction under his pen name.</p>\n\n<p><strong>\"Alice's Adventures in Wonderland\"</strong><br>\nCarroll's most famous work, \"Alice's Adventures in Wonderland,\" was published in 1865. The story began as a tale he told to the daughters of Henry Liddell, the Dean of Christ Church.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
