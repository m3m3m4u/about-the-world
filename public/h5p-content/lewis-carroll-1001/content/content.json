          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Pioneering the Fantasy Genre</strong><br>\nThrough \"Alice\" and its sequel, \"Through the Looking-Glass,\" Carroll was a pioneer in the literary nonsense and fantasy genres. His innovative use of wordplay, logic, and fantasy has delighted readers for generations.</p>\n\n<p><strong>Contributions to Photography</strong><br>\nApart from literature and mathematics, Carroll was also an accomplished and innovative photographer, known for his portraits and studies of expressions.</p>\n\n<p><strong>Intellectual Range and Puzzle Works</strong><br>\nCarroll's intellectual breadth included inventing word puzzles, games, and writing essays on various subjects, from symbolic logic to election theory.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
