              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Louis Pasteur (1822-1895) - Microbiologiste et chimiste, pionnier de la microbiologie</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
              "metadata": {
