            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Influencing Libertarian Movement</strong><br>\nVon Mises's ideas have strongly influenced the libertarian movement. He argued for the protection of individual liberty and the importance of property rights in securing a prosperous and free society.</p>\n\n<p><strong>Books and Teachings</strong><br>\nBeyond his own publications, von Mises's teachings have been propagated through the work of his students, many of whom have become influential economists and thinkers in their own right.</p>\n\n<p><strong>Remembering Mises</strong><br>\nToday, von Mises is remembered through the work of the Ludwig von Mises Institute, which continues to promote his ideas and work in the field of economic science and political philosophy.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3d655444-fd55-42f7-aba2-16a16db7dc58"
