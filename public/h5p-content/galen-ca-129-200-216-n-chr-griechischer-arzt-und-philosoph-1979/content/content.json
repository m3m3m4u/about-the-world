              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Galen (ca. 129-200/216 n. Chr.) - griechischer Arzt und Philosoph</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Información y ejercicios</span></strong></p>\n"
              },
