              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Camille Saint-Saëns (1835-1921) - Französischer Komponist</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
