              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Franz Schubert (1797-1828) - Österreichischer Komponist</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
