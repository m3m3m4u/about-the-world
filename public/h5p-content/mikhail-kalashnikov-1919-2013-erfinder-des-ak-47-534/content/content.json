              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Mikhail Kalashnikov (1919-2013) - Erfinder des AK-47</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
