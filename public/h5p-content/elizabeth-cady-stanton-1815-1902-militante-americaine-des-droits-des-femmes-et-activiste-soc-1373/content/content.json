              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Elizabeth Cady Stanton (1815-1902) - Militante américaine des droits des femmes et activiste sociale</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
