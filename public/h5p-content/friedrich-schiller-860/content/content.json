          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Friedrich Schiller's Early Life</strong><br>\nFriedrich Schiller was born in 1759 in Marbach am Neckar, Germany. He grew up in a military and bureaucratic family, which influenced his early education and future works that often explored themes of freedom, tyranny, and heroism.</p>\n\n<p><strong>Military Academy and Medical Practice</strong><br>\nSchiller attended a military academy and later worked as an army surgeon, a profession he did not enjoy. His longing for literary expression led him to write his first play, \"The Robbers,\" which brought him both fame and trouble with the authorities.</p>\n\n<p><strong>\"The Robbers\" and Escape</strong><br>\nThe Robbers made Schiller an instant success at the age of twenty-one. Its controversial ideas about liberty and the nature of society forced Schiller to flee from Stuttgart to avoid arrest due to its dissenting views.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
