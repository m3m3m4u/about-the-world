              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>René Descartes (1596-1650) - Philosoph, Mathematiker und Wissenschaftler</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
