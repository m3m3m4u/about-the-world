              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>James Watt (1736-1819) - Inventeur et ingénieur écossais</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
