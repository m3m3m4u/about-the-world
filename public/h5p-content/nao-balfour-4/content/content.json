      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Teilungsvorschlag der Vereinten Nationen</strong><br>\n1947 schlugen die Vereinten Nationen eine Teilung Palästinas in einen jüdischen und einen arabischen Staat vor. Dieser Plan wurde von den jüdischen Führern akzeptiert, aber von den arabischen Führern abgelehnt. Der Teilungsplan führte zur Gründung des Staates Israel im Jahr 1948, aber auch zum Beginn des arabisch-israelischen Konflikts.</p>\n\n<p><strong>Gründung des Staates Israel</strong><br>\nAm 14. Mai 1948 erklärte David Ben-Gurion, der Vorsitzende des Jüdischen Nationalrates, die Unabhängigkeit Israels. Dies führte zu einem Krieg zwischen Israel und den umliegenden arabischen Staaten. Trotz großer Herausforderungen konnte Israel seine Unabhängigkeit bewahren und begann, jüdische Einwanderer aus aller Welt aufzunehmen.</p>\n\n<p><strong>Auswirkungen auf Palästina</strong><br>\nDie Gründung Israels hatte erhebliche Auswirkungen auf die palästinensische Bevölkerung. Viele wurden vertrieben oder flohen und wurden zu Flüchtlingen in den umliegenden arabischen Ländern. Die Gebiete Westbank und Gazastreifen kamen unter jordanische bzw. ägyptische Kontrolle.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
