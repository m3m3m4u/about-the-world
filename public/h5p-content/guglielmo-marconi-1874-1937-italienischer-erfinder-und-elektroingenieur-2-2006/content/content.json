          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Guglielmo Marconi</strong><br>\nGuglielmo Marconi fue un inventor y científico italiano galardonado con el Premio Nobel de Física. Es famoso por su desarrollo del sistema de telegrafía sin hilos, que jugó un papel crucial en la comunicación global moderna.</p>\n\n<p><strong>Primeros Experimentos y Logros</strong><br>\nMarconi realizó sus primeros experimentos con equipos de radio en la finca de su familia en Italia y logró enviar señales inalámbricas a distancias que nadie había alcanzado antes.</p>\n\n<p><strong>Transmisión Transatlántica</strong><br>\nEn 1901, Marconi logró la primera transmisión transatlántica de una señal de radio, demostrando que las ondas de radio podían transmitirse más allá del horizonte y a través del océano.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "es"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
