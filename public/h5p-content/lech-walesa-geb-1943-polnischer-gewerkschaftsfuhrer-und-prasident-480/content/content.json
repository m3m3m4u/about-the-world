      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 3)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "4381b60d-c67f-4722-b83d-b17f2fc9d01c"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Wirtschaftsreformen</strong><br>\nAls Präsident setzte Wałęsa die Privatisierung der Wirtschaft fort und führte marktwirtschaftliche Reformen ein. Diese Reformen waren wichtig, um die Wirtschaft Polens zu stabilisieren und Wachstum zu fördern. Seine Politik war jedoch auch umstritten, da sie zu sozialen Spannungen und einer Zunahme der Arbeitslosigkeit führte.</p>\n\n<p><strong>Internationale Anerkennung</strong><br>\nWałęsa genoss internationale Anerkennung und wurde oft für seine Rolle beim Sturz des Kommunismus in Polen und bei der Förderung der Demokratie in Osteuropa gelobt. Er traf sich mit Staatsführern aus aller Welt und wurde zu einem Sinnbild für den Kampf gegen Unterdrückung und für Freiheit.</p>\n\n<p><strong>Leben nach der Präsidentschaft</strong><br>\nNachdem er 1995 aus dem Amt schied, blieb Wałęsa eine einflussreiche Persönlichkeit in Polen und international. Er hält Vorträge über Demokratie und Freiheitsrechte und engagiert sich weiterhin in der Politik. Wałęsa ist auch eine umstrittene Figur, da er sowohl für sein politisches Erbe als auch für seine Meinungen und Äußerungen in der Öffentlichkeit kritisiert wird.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3d655444-fd55-42f7-aba2-16a16db7dc58"
