      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 2)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "55aaf4d3-f7e3-4a3e-9196-01a6f7474f94"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Anatomische Studien</strong><br>\nLeonardo führte detaillierte anatomische Studien durch und zeichnete über 200 Seiten an Skizzen und Notizen. Er sezierte menschliche Leichname, um Muskeln und Organe zu verstehen. Diese Studien halfen ihm nicht nur, den menschlichen Körper in seiner Kunst genauer darzustellen, sondern trugen auch zum medizinischen Verständnis bei.</p>\n\n<p><strong>Innovationen und Erfindungen</strong><br>\nObwohl viele von Leonardos Erfindungen niemals während seiner Lebzeit gebaut wurden, zeigten sie sein außergewöhnliches Vorstellungsvermögen. Zu seinen Entwürfen zählten ein Fallschirm, ein Hubschrauber, ein Panzer und eine Brücke. Einige seiner Ideen waren ihrer Zeit weit voraus und funktionierten möglicherweise nicht mit der damaligen Technologie.</p>\n\n<p><strong>Leonardo als Ingenieur</strong><br>\nLeonardo diente mehreren Herrschern als Ingenieur, darunter Ludovico Sforza in Mailand, Cesare Borgia und schließlich François I. in Frankreich. Er konzipierte Festungen, Kanäle und andere Infrastrukturen. Seine Kenntnisse in Hydraulik, Mechanik und städtischem Bau waren wegweisend für die Ingenieurwissenschaften seiner Zeit.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
