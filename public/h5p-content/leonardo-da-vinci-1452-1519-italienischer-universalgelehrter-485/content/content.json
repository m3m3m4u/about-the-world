              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Leonardo da Vinci (1452-1519) - Italienischer Universalgelehrter</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
