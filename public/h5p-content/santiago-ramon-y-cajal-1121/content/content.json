          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of Santiago Ramón y Cajal</strong><br>\nSantiago Ramón y Cajal was born in 1852 in Spain. As a child, he had a keen interest in the arts, dreams of being an artist, but his father, a professor of anatomy, steered him towards medicine. He combined his artistic skills with scientific inquiry throughout his career.</p>\n\n<p><strong>Medical Training</strong><br>\nCajal received his medical degree from the University of Zaragoza. He served as an army doctor before dedicating himself to research in histology, the microscopic study of tissue, and neural anatomy, laying the foundation for his future discoveries.</p>\n\n<p><strong>Discoveries in Neural Science</strong><br>\nCajal's most significant contribution to science was his detailed study of the nervous system. Using a staining technique developed by Camillo Golgi, he was able to observe neurons in unprecedented detail, leading to the formulation of the neuron doctrine.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
        ],
