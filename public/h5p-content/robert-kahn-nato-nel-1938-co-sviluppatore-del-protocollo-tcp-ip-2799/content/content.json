              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Robert Kahn (nato nel 1938) - co-sviluppatore del protocollo TCP-IP</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
