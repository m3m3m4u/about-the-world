              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Bertrand Russell (1872-1970) - Philosoph und Logiker, Nobelpreisträger für Literatur</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
