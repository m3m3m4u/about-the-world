          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life</strong><br>\nJohn F. Kennedy was born on May 29, 1917, in Brookline, Massachusetts, into a wealthy and politically influential family. He served in the U.S. Navy during World War II and was decorated for heroism.</p>\n\n<p><strong>Political Rise</strong><br>\nAfter the war, Kennedy entered politics, serving in the U.S. House of Representatives and then the Senate. He gained national prominence with his vibrant personality and articulate speeches.</p>\n\n<p><strong>Presidential Election</strong><br>\nKennedy won the 1960 presidential election, becoming the 35th president and the youngest ever elected to the office. His campaign was marked by his charisma and sense of vitality.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
