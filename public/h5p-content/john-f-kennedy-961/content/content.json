          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Domestic Challenges</strong><br>\nAs president, Kennedy faced significant domestic challenges, including civil rights struggles and economic recession. He supported space exploration, pushing for a moon landing.</p>\n\n<p><strong>Foreign Affairs</strong><br>\nHis foreign affairs were marked by Cold War tensions, including the Bay of Pigs invasion, the Cuban Missile Crisis, and the early stages of the Vietnam War.</p>\n\n<p><strong>Civil Rights</strong><br>\nKennedy advocated for civil rights, calling for new legislation and declaring civil rights a \"moral issue.\" His administration faced both support and fierce opposition.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
