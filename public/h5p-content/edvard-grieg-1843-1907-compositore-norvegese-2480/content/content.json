              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Edvard Grieg (1843-1907) - Compositore norvegese</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
