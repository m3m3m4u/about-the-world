          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Public Advocacy and Policy</strong><br>\nCerf has been a vocal advocate for internet access and digital policies that promote an open and user-centric internet. He has worked to address issues such as digital inclusion, internet safety, and the ethical implications of technology.</p>\n\n<p><strong>Vinton Cerf's Current Endeavors</strong><br>\nContinuing his work in the field, Cerf remains active in promoting the continued development of the internet, speaking on topics such as cybersecurity, artificial intelligence, and the future of internet connectivity.</p>\n\n<p><strong>Legacy of Vinton Cerf</strong><br>\nVinton Cerf's influence on the digital world continues to be felt as he works on projects that address the future challenges of the internet. His vision for a universally connected world guides his ongoing efforts to improve and innovate the way we connect and communicate online.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
