            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life of Albert Schweitzer</strong><br>\nAlbert Schweitzer was born on January 14, 1875, in Kaysersberg, which at the time was part of the German Empire. He was a gifted child who played music and excelled in academics. By the age of 30, he had achieved notable success in theology and music, having already secured a position as a principal at a theological college and served as a pastor.</p>\n\n<p><strong>Schweitzer as a Musician</strong><br>\nSchweitzer was also an accomplished organist and music scholar. He was particularly interested in the music of Johann Sebastian Bach. His book, \"J.S. Bach, le musicien-poète,\" was influential in the resurgence of interest in Bach's work. He performed concerts across Europe to fund his philanthropic work and used his musical skills to promote his ethical philosophy of \"Reverence for Life.\"</p>\n\n<p><strong>Philosophy and Ethics</strong><br>\nSchweitzer developed a philosophy he called \"Reverence for Life,\" based on the principle that all life is sacred and that humans have a duty to respect and preserve it. This philosophy extended to his attitude towards animals and the environment and influenced his decision to establish a hospital in Lambaréné, Gabon, in Central Africa.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
