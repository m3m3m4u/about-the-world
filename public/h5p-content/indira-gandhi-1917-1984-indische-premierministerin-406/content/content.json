              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Indira Gandhi (1917-1984) - Indische Premierministerin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
