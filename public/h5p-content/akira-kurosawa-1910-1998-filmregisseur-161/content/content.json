      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 1)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "5627dc6e-c943-439e-ab4a-4531b7f24264"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Frühe Jahre</strong><br>\nAkira Kurosawa wurde am 23. März 1910 in Tokio, Japan, geboren. Er war das jüngste von acht Kindern in seiner Familie. Sein Vater war ein ehemaliger Berufssoldat und arbeitete später als Lehrer. Kurosawa entwickelte schon früh ein Interesse an Malerei und Literatur, inspiriert von seinem älteren Bruder Heigo, der als Erzähler für Stummfilme arbeitete.</p>\n\n<p><strong>Ausbildung und Einflüsse</strong><br>\nKurosawa besuchte die Kunstschule und lernte dort, auf unterschiedliche Weise zu malen und zu zeichnen. Diese Fähigkeiten halfen ihm später bei der Gestaltung seiner Filme. Neben der Malerei war er auch ein begeisterter Leser und liebte Werke westlicher Autoren wie Dostojewski, welche seine späteren Werke beeinflussten.</p>\n\n<p><strong>Karrierebeginn beim Film</strong><br>\nIn den 1930er Jahren begann Kurosawa seine Karriere im japanischen Filmgeschäft. Zunächst arbeitete er als Assistent und Schnittmeister, bevor er die Chance bekam, selbst Regie zu führen. Sein erstes großes Werk als Regisseur war \"Sanshiro Sugata\" im Jahr 1943.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
