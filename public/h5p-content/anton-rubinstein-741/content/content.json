          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Prodigy</strong><br>\nAnton Rubinstein was born on November 28, 1829, in the Russian Empire. Recognized as a musical prodigy, he gave his first public piano performance at the age of nine.</p>\n\n<p><strong>Founding the Saint Petersburg Conservatory</strong><br>\nRubinstein founded the Saint Petersburg Conservatory in 1862, establishing a rigorous standard for music education in Russia and influencing the direction of Russian classical music.</p>\n\n<p><strong>International Career</strong><br>\nAs a pianist, Rubinstein enjoyed a stellar international career. His performances were noted for their emotion and bold interpretation, which brought him fame across Europe and America.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
