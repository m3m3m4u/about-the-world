            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Compositions and Musical Style</strong><br>\nRubinstein's compositions, which include symphonies, concertos, and operas, were rooted in the Romantic tradition and were marked by their melody and rich harmonies.</p>\n\n<p><strong>Influence and Musical Legacy</strong><br>\nHis influence extended beyond performance to his vision for Russian music, encouraging a synthesis of Western musical techniques with Russian tradition.</p>\n\n<p><strong>Teaching and Impact on Russian Music</strong><br>\nRubinstein's role as a teacher was instrumental in nurturing the next generation of Russian musicians, including the great pianist and composer Pyotr Ilyich Tchaikovsky.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
