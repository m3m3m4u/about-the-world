              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Mikhail Kalashnikov (1919-2013) - inventore dell'AK-47</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
