              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>King Hussein of Jordan (1935-1999) - König von Jordanien</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
