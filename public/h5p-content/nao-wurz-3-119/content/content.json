                "title": "Unbenannt: Text",
                "defaultLanguage": "it"
              },
              "subContentId": "5627dc6e-c943-439e-ab4a-4531b7f24264"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Tempi biblici</strong><br>\nLa storia della regione che oggi comprende Israele e Palestina risale a tempi biblici. In questa area si sono insediate diverse popolazioni, tra cui gli Ebrei, i Filistei e altri. Prove storiche e archeologiche mostrano il complesso passato di questa zona e le diverse influenze culturali e religiose che vi si sono incontrate.</p>\n\n<p><strong>L'Impero Ottomano</strong><br>\nFino alla fine della Prima Guerra Mondiale, il territorio dell'attuale Israele e Palestina apparteneva all'Impero Ottomano. Con la sconfitta dell'Impero nel 1918 e la disintegrazione dell'Impero Ottomano, i confini nel Medio Oriente furono ridisegnati. Le potenze europee, in particolare Gran Bretagna e Francia, ebbero un ruolo fondamentale nella definizione di questi nuovi confini.</p>\n\n<p><strong>Il Mandato Britannico</strong><br>\nDopo la Prima Guerra Mondiale, il territorio passò sotto il controllo britannico e fu noto come \"Mandato Britannico della Palestina\". Durante questo periodo ci fu un aumento dell'immigrazione ebraica nella regione, spinta dal sogno sionista di creare uno Stato ebraico. Anche la popolazione arabo-palestinese aspirava all'autodeterminazione e all'indipendenza.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "it"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
