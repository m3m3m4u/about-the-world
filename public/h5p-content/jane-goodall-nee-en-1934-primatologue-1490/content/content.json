              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Jane Goodall (née en 1934) - primatologue</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
              "metadata": {
