      {
        "elements": [
          {
            "x": 2.23463687150838,
            "y": 4.415011037527593,
            "width": 37.98882681564246,
            "height": 8.830022075055187,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:1.5em;\"><strong>Informationstext (Teil 3)</strong></span></p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "4381b60d-c67f-4722-b83d-b17f2fc9d01c"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.178649237472767,
            "y": 12.910611231371064,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Kenyattas Präsidentschaft</strong><br>\nAls Präsident arbeitete Kenyatta daran, die Wirtschaft Kenias zu stabilisieren und nationale Einheit zu fördern. Er führte eine Politik ein, die als \"Harambee\" bekannt wurde, was auf Suaheli \"alle zusammen\" bedeutet. Seine Regierung konzentrierte sich auf Entwicklung und Modernisierung, um die Lebensbedingungen der kenianischen Bevölkerung zu verbessern.</p>\n\n<p><strong>Spätere Jahre und Erbe</strong><br>\nGegen Ende seiner Amtszeit wurde Kenyattas Regierung zunehmend von Vorwürfen der Korruption und Nepotismus überschattet. Trotzdem bleibt seine Rolle als Vater der Nation und Symbol der Unabhängigkeit Kenias unbestritten. Er starb 1978, hinterließ jedoch ein bleibendes Erbe und wird in Kenia hoch verehrt.</p>\n\n<p><strong>Bewertung von Kenyattas Führung</strong><br>\nKenyattas Zeit als Führer ist gemischt bewertet worden. Einerseits wird er für seine Führungsstärke und sein Engagement für Kenias Unabhängigkeit gelobt. Andererseits wird seine Präsidentschaft kritisch gesehen, vor allem im Hinblick auf den Umgang mit politischen Gegnern und Minderheiten. Dennoch ist seine Bedeutung für Kenias Geschichte unumstritten.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text"
              },
              "subContentId": "3d655444-fd55-42f7-aba2-16a16db7dc58"
