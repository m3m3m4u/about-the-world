              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Jomo Kenyatta (c. 1897-1978) - Erster Präsident Kenias</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
