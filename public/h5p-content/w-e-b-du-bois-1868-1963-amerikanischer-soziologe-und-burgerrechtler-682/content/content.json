              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>W. E. B. Du Bois (1868-1963) - Amerikanischer Soziologe und Bürgerrechtler</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
