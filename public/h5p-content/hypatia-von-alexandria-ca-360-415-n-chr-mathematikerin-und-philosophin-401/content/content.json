              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Hypatia von Alexandria (ca. 360-415 n. Chr.) - Mathematikerin und Philosophin</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
              "metadata": {
