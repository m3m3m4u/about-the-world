            "invisible": false,
            "solution": ""
          },
          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>John Milton's Early Life</strong><br>\nJohn Milton was born in London on December 9, 1608, into a prosperous middle-class family. He was educated at St Paul's School and later at Christ's College, Cambridge, where he excelled in languages and classical literature. Milton's early poetry, written during his university years, reflects his profound engagement with religion and politics, even before he became a prominent public servant and writer.</p>\n\n<p><strong>Poetry and Political Views</strong><br>\nMilton's poetry often intertwined with his strong political convictions. His support for republicanism and his Puritan leanings influenced much of his work. He viewed poetry as a powerful medium to address and influence public issues. This was evident in his early works, including \"Comus\" and \"Lycidas,\" which touched upon themes of virtue, morality, and freedom.</p>\n\n<p><strong>The English Civil War</strong><br>\nDuring the English Civil War, Milton devoted himself to the Puritan and Parliamentary cause. His writings from this period include tracts that argued fiercely for the abolition of the Church of England and against royalism. He served as a civil servant for the Commonwealth of England, working closely with Oliver Cromwell, whom he supported.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
