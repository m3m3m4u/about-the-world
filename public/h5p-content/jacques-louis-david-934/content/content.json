          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>David's Historical Paintings</strong><br>\nDavid is known for his historical paintings that often depicted scenes from antiquity with moral and civic themes. His compositions are marked by their clarity of form, sober colors, and the use of lighting to highlight the main subjects.</p>\n\n<p><strong>The Death of Marat</strong><br>\nThe Death of Marat, painted by David in 1793 following the assassination of his friend Jean-Paul Marat, is one of the most famous images of the revolutionary period. It showcases David's mastery of emotional intensity and simplicity.</p>\n\n<p><strong>Napoleon's Official Painter</strong><br>\nUnder Napoleon's regime, David was appointed the official court painter. He created several grandiose and idealized portraits of Napoleon, contributing to the emperor's legendary image.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
