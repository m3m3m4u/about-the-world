              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Willard Libby (1908-1980) - Chimico, noto per il metodo di determinazione dell'età con il radiocarbonio</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
              "metadata": {
