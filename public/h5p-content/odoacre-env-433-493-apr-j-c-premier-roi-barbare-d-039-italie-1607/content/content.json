              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Odoacre (env. 433-493 apr. J.-C.) - Premier roi barbare d'Italie</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">INFORMATIONS UND EXERCISES</span></strong></p>\n"
              },
