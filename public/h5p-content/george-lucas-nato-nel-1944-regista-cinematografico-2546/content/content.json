              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>George Lucas (nato nel 1944) - regista cinematografico</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
