              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Edwin Hubble (1889-1953) - astronomo</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informazioni ed esercitazioni</span></strong></p>\n"
              },
