              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Hatschepsut (ca. 1507-1458 v. Chr.) - Königin und Pharao von Ägypten</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
