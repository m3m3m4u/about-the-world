          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>King Solomon's Background</strong><br>\nKing Solomon was the son of King David and Bathsheba. After his father's death, Solomon became the king of Israel and ruled from around 990 to 931 BC. He was known for his wisdom, wealth, and writings. Solomon expanded his kingdom's economy and military strength, securing its position in the region.</p>\n\n<p><strong>Solomon's Wisdom</strong><br>\nSolomon's wisdom was legendary and is documented in biblical texts, such as the accounts of him adjudicating the dispute between two women claiming to be the mother of the same child. He suggested cutting the child in two, knowing the real mother would rather give up her claim than see her child harmed. His judgment was seen as a sign of divine wisdom.</p>\n\n<p><strong>Building Projects</strong><br>\nAmong Solomon's grand building projects was the First Temple in Jerusalem, which became the most important religious site for the Israelites. He also built a lavish palace for himself and various fortifications and cities for his kingdom. These building projects showcased his wealth and the kingdom's prosperity.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
