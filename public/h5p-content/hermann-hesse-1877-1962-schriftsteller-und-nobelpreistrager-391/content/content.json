              "params": {
                "text": "<p><span style=\"font-size:3em;\"><strong>Hermann Hesse (1877-1962) - Schriftsteller und Nobelpreisträger</strong></span></p>\n\n<p><strong><span style=\"font-size:1.5em;\">Informationen und Übungen</span></strong></p>\n"
              },
