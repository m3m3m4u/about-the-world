          {
            "x": 2.23463687150838,
            "y": 13.245033112582783,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Early Life and Education</strong><br>\nJames Whyte Black was born on June 14, 1924, in Uddingston, Scotland. He studied medicine at the University of St. Andrews, which was then part of the University of Edinburgh, graduating with a degree in Medicine during World War II.</p>\n\n<p><strong>Career in Pharmacology</strong><br>\nBlack chose to focus on pharmacology, seeking new ways to treat diseases. He worked in both academic environments and the pharmaceutical industry, where he conducted his Nobel-prize-winning research.</p>\n\n<p><strong>Development of Propranolol</strong><br>\nBlack's work led to the development of propranolol, the first clinically successful beta blocker used to treat heart disease. This drug was revolutionary because it was one of the first to prevent heart attacks by blocking stress-related effects on the heart.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "53bc5361-5ce5-43a9-a00f-57bbceee9cd0"
            },
            "alwaysDisplayComments": false,
            "backgroundOpacity": 0,
            "displayAsButton": false,
            "buttonSize": "big",
            "goToSlideType": "specified",
            "invisible": false,
            "solution": ""
          }
