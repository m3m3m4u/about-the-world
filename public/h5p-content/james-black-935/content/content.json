          {
            "x": 2.23463687150838,
            "y": 13.245033112582782,
            "width": 92.73743016759778,
            "height": 86.09271523178808,
            "action": {
              "library": "H5P.AdvancedText 1.1",
              "params": {
                "text": "<p><strong>Discovery of Cimetidine</strong><br>\nBlack also developed cimetidine, a drug that treats stomach ulcers by controlling stomach acid production. It was a breakthrough in the treatment and management of peptic ulcer disease.</p>\n\n<p><strong>Nobel Prize in Medicine</strong><br>\nIn 1988, James Black was awarded the Nobel Prize in Physiology or Medicine for his work in drug development, which significantly improved treatments for heart disease and ulcers.</p>\n\n<p><strong>Teaching and Research</strong><br>\nAfter his groundbreaking discoveries, Black continued to teach and research. He was a professor at King's College London, where he inspired a new generation of pharmacologists.</p>\n"
              },
              "metadata": {
                "contentType": "Text",
                "license": "U",
                "title": "Unbenannt: Text",
                "defaultLanguage": "en"
              },
              "subContentId": "3b13867b-feab-4e2e-bfa2-fcc82e4dbff1"
